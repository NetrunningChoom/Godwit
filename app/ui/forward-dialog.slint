import { Theme, Icons, Icon } from "theme.slint";
import { SwitchItem } from "types.slint";
import { Avatar, Button, Dialog, TextField } from "widgets.slint";

// "Forward" in a message's menu, as the official client's picker: search the
// places the message can go, pick one, add a note if you like, then Send.
export component ForwardDialog inherits Dialog {
    in property <[SwitchItem]> results;
    in-out property <bool> forward-open;
    // The chosen destination (-1: none yet).
    in-out property <int> current: -1;
    callback forward-search(string);
    callback forward-send(int, string);

    title: "Forward message";
    card-width: 480px;
    dismissed => { root.forward-open = false; }
    TextField {
        placeholder: "Search for a chat";
        autofocus: true;
        edited(t) => {
            root.current = -1;
            root.forward-search(t);
        }
    }
    VerticalLayout {
        spacing: Theme.space-1;
        for r[i] in root.results: Rectangle {
            height: 44px;
            border-radius: Theme.radius-lg;
            background: i == root.current ? Theme.secondary-container
                : row.has-hover ? Theme.surface-highest : transparent;
            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-4;
                spacing: Theme.space-3;
                if r.kind == 2: Icon { width: 32px; text: Icons.tag; color: Theme.on-surface-variant; }
                if r.kind != 2: Avatar {
                    y: (parent.height - self.height) / 2;
                    size: 32px;
                    source: r.icon;
                    has-image: r.has-icon;
                    initials: r.initials;
                }
                Text {
                    text: r.name;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: i == root.current ? Theme.on-secondary-container : Theme.on-surface;
                }
                Text { text: r.detail; vertical-alignment: center; font-size: Theme.text-small; color: Theme.outline; }
            }
            row := TouchArea { mouse-cursor: pointer; clicked => { root.current = i; } }
        }
    }
    comment := TextField {
        placeholder: "Add an optional message";
        accepted => { if root.current >= 0 { root.forward-send(root.current, self.text); } }
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.gap-sm;
        Button { text: "Cancel"; kind: "text"; clicked => { root.forward-open = false; } }
        Button {
            text: "Send";
            kind: "filled";
            enabled: root.current >= 0;
            clicked => { root.forward-send(root.current, comment.text); }
        }
    }
}
