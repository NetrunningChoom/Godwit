import { Slider } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { CallMemberItem, StreamItem, CallVideoItem, CallFrames } from "types.slint";
import { Avatar, IconButton, ImageIconButton } from "widgets.slint";

// A call video filling the window: double-click or Esc comes back.
export component FullscreenVideo inherits Rectangle {
    in property <bool> call-deafened;
    in property <[CallMemberItem]> call-members;
    in property <bool> call-muted;
    in property <bool> call-speaking;
    in property <bool> call-camera;
    in property <bool> call-can-video;
    in property <bool> call-screen-share;
    in property <[StreamItem]> call-streams;
    in property <string> call-time;
    in property <[CallVideoItem]> call-videos;
    in property <int> fullscreen-video;
    callback stream-sound(int, float, bool, bool);
    callback toggle-deafen();
    callback toggle-mute();
    callback set-camera(bool);
    callback set-screen-share(bool);
    callback leave-call();
    callback video-fullscreen(int);

    background: Theme.media;
    fs := FocusScope {
        // The controls hide after a while without the mouse moving, and
        // come back when it moves (as the official client's player).
        property <bool> controls: true;
        // The call's people along the bottom ("Show people"). They
        // stay when the controls hide: only the controls get out of the way.
        property <bool> people: false;
        property <length> strip: fs.people && root.call-members.length > 0 ? 112px : 0px;
        function reveal-controls() {
            fs.controls = true;
            hide-controls.restart();
        }
        init => {
            self.focus();
            hide-controls.restart();
        }
        key-pressed(e) => {
            if e.text == Key.Escape { root.video-fullscreen(-1); return accept; }
            fs.reveal-controls();
            reject
        }
        hide-controls := Timer {
            interval: 3s;
            // Start it once so restart() can reset the deadline on activity.
            running: true;
            triggered => {
                fs.controls = false;
                self.stop();
            }
        }
        Image {
            width: parent.width;
            height: parent.height - fs.strip;
            y: 0;
            source: root.fullscreen-video < CallFrames.frames.length ? CallFrames.frames[root.fullscreen-video] : root.call-videos[root.fullscreen-video].frame;
            image-fit: contain;
        }
        fs-touch := TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            mouse-cursor: fs.controls ? MouseCursor.default : MouseCursor.none;
            double-clicked => { root.video-fullscreen(-1); }
            changed mouse-x => {
                fs.reveal-controls();
            }
            changed mouse-y => {
                fs.reveal-controls();
            }
        }
        // Who's in the call, under the picture.
        if fs.strip > 0: HorizontalLayout {
            y: parent.height - fs.strip;
            height: fs.strip;
            alignment: center;
            spacing: Theme.space-4;
            padding: Theme.space-4;
            for m in root.call-members: Rectangle {
                width: 120px;
                border-radius: Theme.radius-md;
                background: Theme.on-media-faint;
                border-width: m.speaking ? 2px : 0;
                border-color: Theme.primary;
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-compact;
                    HorizontalLayout {
                        alignment: center;
                        Avatar { size: 48px; source: m.avatar; has-image: m.has-avatar; initials: m.initials; }
                    }
                    Text {
                        text: m.name;
                        color: white;
                        font-size: Theme.text-small;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        if fs.controls: Rectangle {
            x: 16px;
            y: 16px;
            width: fs-label.preferred-width;
            height: 32px;
            border-radius: Theme.radius-lg;
            background: Theme.scrim;
            fs-label := HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                spacing: Theme.space-3;
                Text { text: root.call-videos[root.fullscreen-video].label + " · Esc to leave"; color: white; font-size: Theme.text-label; vertical-alignment: center; }
                // Who watches it: an eye with the count; click lists them.
                if fs.has-viewers: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: fs-viewers.preferred-width + 12px;
                    height: 24px;
                    border-radius: self.height / 2;
                    background: fs-viewers-touch.has-hover || fs.show-viewers ? Theme.on-media-hover : transparent;
                    fs-viewers := HorizontalLayout {
                        x: 6px;
                        spacing: Theme.space-1;
                        Icon { text: Icons.visibility; color: white; font-size: Theme.text-label; }
                        Text { text: root.call-streams[fs.stream].viewers; color: white; font-size: Theme.text-label; vertical-alignment: center; }
                    }
                    fs-viewers-touch := TouchArea { mouse-cursor: pointer; clicked => { fs.show-viewers = !fs.show-viewers; } }
                }
            }
        }
        // A watched stream's sound, as beside its LIVE pill.
        property <int> stream: root.call-videos[root.fullscreen-video].stream;
        // Who watches it (the eye in the label opens this list).
        property <bool> show-viewers;
        property <bool> has-viewers: fs.stream >= 0 && fs.stream < root.call-streams.length
            && root.call-streams[fs.stream].viewers != "";
        if fs.controls && fs.has-viewers && fs.show-viewers: Rectangle {
            x: 16px;
            y: 56px;
            width: max(160px, fs-viewer-list.preferred-width + 24px);
            height: fs-viewer-list.preferred-height + 16px;
            border-radius: Theme.radius-sm;
            background: Theme.scrim-strong;
            fs-viewer-list := VerticalLayout {
                padding: Theme.space-2;
                padding-left: Theme.space-4;
                spacing: Theme.space-1;
                Text { text: "Watching"; color: Theme.on-media-variant; font-size: Theme.text-tiny; font-weight: 600; }
                Text { text: root.call-streams[fs.stream].viewer-names; color: white; font-size: Theme.text-small; }
            }
        }
        if fs.controls && fs.stream >= 0 && fs.stream < root.call-streams.length: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - fs.strip - self.height - 24px;
            width: fs-sound.preferred-width + 24px;
            height: 44px;
            border-radius: self.height / 2;
            background: Theme.scrim-strong;
            fs-sound := HorizontalLayout {
                x: 12px;
                spacing: Theme.space-3;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: root.call-streams[fs.stream].muted ? Icons.headset-off : Icons.headset;
                    tooltip: root.call-streams[fs.stream].muted ? "Unmute stream" : "Mute stream";
                    tint: white;
                    clicked => {
                        root.stream-sound(fs.stream, root.call-streams[fs.stream].volume, !root.call-streams[fs.stream].muted, true);
                    }
                }
                Slider {
                    width: 160px;
                    y: (parent.height - self.height) / 2;
                    enabled: !root.call-streams[fs.stream].muted;
                    minimum: 0;
                    maximum: 2;
                    value: root.call-streams[fs.stream].volume;
                    changed(v) => { root.stream-sound(fs.stream, v, false, false); }
                    released(v) => { root.stream-sound(fs.stream, v, false, true); }
                }
            }
        }
        // Our microphone and hearing, while watching (as the call bar's).
        if fs.controls: Rectangle {
            x: 16px;
            y: parent.height - fs.strip - self.height - 24px;
            width: fs-call.preferred-width;
            height: fs-call.preferred-height;
            border-radius: self.height / 2;
            background: Theme.scrim-strong;
            fs-call := HorizontalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-1;
                ImageIconButton {
                    icon: root.call-muted ? @image-url("../../assets/icons/yapfast/mic-off.svg") : @image-url("../../assets/icons/yapfast/mic.svg");
                    tooltip: root.call-muted ? "Unmute" : "Mute";
                    enabled: !root.call-deafened;
                    tint: root.call-muted ? Theme.error : root.call-speaking ? Theme.online : white;
                    fill: Theme.on-media-faint;
                    clicked => { root.toggle-mute(); }
                }
                ImageIconButton {
                    icon: root.call-deafened ? @image-url("../../assets/icons/yapfast/headphone-off.svg") : @image-url("../../assets/icons/yapfast/headphones.svg");
                    tooltip: root.call-deafened ? "Undeafen" : "Deafen";
                    tint: root.call-deafened ? Theme.error : white;
                    fill: Theme.on-media-faint;
                    clicked => { root.toggle-deafen(); }
                }
                if root.call-can-video || root.call-camera: ImageIconButton {
                    icon: root.call-camera ? @image-url("../../assets/icons/yapfast/video.svg") : @image-url("../../assets/icons/yapfast/video-off.svg");
                    tooltip: root.call-camera ? "Turn camera off" : "Turn camera on";
                    enabled: root.call-can-video || root.call-camera;
                    tint: white;
                    fill: root.call-camera ? Theme.primary-container : Theme.on-media-faint;
                    clicked => { root.set-camera(!root.call-camera); }
                }
                if root.call-can-video || root.call-screen-share: ImageIconButton {
                    icon: root.call-screen-share ? @image-url("../../assets/icons/yapfast/screen-share-off.svg") : @image-url("../../assets/icons/yapfast/screen-share.svg");
                    tooltip: root.call-screen-share ? "Stop sharing" : "Share your screen";
                    enabled: root.call-can-video || root.call-screen-share;
                    tint: white;
                    fill: root.call-screen-share ? Theme.primary-container : Theme.on-media-faint;
                    clicked => { root.set-screen-share(!root.call-screen-share); }
                }
                // Fixed width: a ticking timer mustn't move the buttons.
                if root.call-time != "": Text {
                    text: root.call-time;
                    width: 56px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-label;
                    color: white;
                }
                ImageIconButton {
                    icon: @image-url("../../assets/icons/yapfast/phone-off.svg");
                    tooltip: "Leave call";
                    tint: Theme.on-error;
                    fill: Theme.error;
                    clicked => { root.leave-call(); }
                }
            }
        }
        // With the controls hidden, a small mic still shows that we're heard
        // (or that we're muted), so talking never goes unnoticed.
        if !fs.controls && (root.call-speaking || root.call-muted): Rectangle {
            x: 16px;
            y: parent.height - fs.strip - self.height - 16px;
            width: 32px;
            height: 32px;
            border-radius: self.height / 2;
            background: Theme.scrim-strong;
            Image {
                width: 18px;
                height: 18px;
                source: root.call-muted ? @image-url("../../assets/icons/yapfast/mic-off.svg") : @image-url("../../assets/icons/yapfast/mic.svg");
                colorize: root.call-muted ? Theme.error : Theme.online;
            }
        }
        // "Show people": show or hide who's in the call.
        if fs.controls && root.call-members.length > 0: Rectangle {
            x: parent.width - self.width - 16px - 40px - 8px;
            y: 16px;
            width: people-label.preferred-width + 24px;
            height: 32px;
            border-radius: Theme.radius-lg;
            background: people-touch.has-hover ? Theme.on-media-hover : Theme.scrim;
            people-label := Text { text: fs.people ? "Hide people" : "Show people"; color: white; font-size: Theme.text-label; }
            people-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { fs.people = !fs.people; }
            }
        }
        if fs.controls: IconButton {
            x: parent.width - self.width - 16px;
            y: 16px;
            glyph: Icons.close;
            tooltip: "Leave fullscreen";
            tint: white;
            clicked => { root.video-fullscreen(-1); }
        }
    }
}
