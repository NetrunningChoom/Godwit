import { Theme } from "theme.slint";
import { Dialog, Button, Select } from "widgets.slint";

// Windows' screen share picker. Windows has no system picker (Linux and macOS
// do), so Godwit lists the screens and the apps' windows itself
// (godwit_voice::screen::sources), in two tabs as Discord's client does.
// Shown in place of ShareSettings only where `share-pick-source` is set.

component SourceTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: Theme.control-icon;
    horizontal-stretch: 1;
    border-radius: self.height / 2;
    background: root.selected ? Theme.secondary-container : touch.has-hover ? Theme.surface-highest : transparent;
    Text {
        text: root.text;
        color: root.selected ? Theme.on-secondary-container : Theme.on-surface;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component SourceRow inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: Theme.control-button;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.primary-container : touch.has-hover ? Theme.surface-highest : transparent;
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        color: root.selected ? Theme.on-primary-container : Theme.on-surface;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component ShareSource inherits Dialog {
    in property <[string]> screens;
    in property <[string]> windows;
    // 0: Screens, 1: Applications.
    in-out property <int> tab;
    // The pick within the shown tab.
    in-out property <int> source-index;
    in property <[string]> qualities;
    in-out property <int> quality-index;
    callback confirm();
    title: "Share your screen";
    card-width: 480px;
    property <int> count: root.tab == 0 ? root.screens.length : root.windows.length;
    FocusScope {
        height: content.preferred-height;
        init => { self.focus(); }
        key-pressed(e) => { if e.text == Key.Escape { root.dismissed(); return accept; } reject }
        content := VerticalLayout {
            spacing: Theme.space-5;
            HorizontalLayout {
                spacing: Theme.space-3;
                SourceTab { text: "Screens"; selected: root.tab == 0; clicked => { root.tab = 0; root.source-index = 0; } }
                SourceTab { text: "Applications"; selected: root.tab == 1; clicked => { root.tab = 1; root.source-index = 0; } }
            }
            list := Flickable {
                height: 240px;
                content-width: list.width;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    width: list.width;
                    spacing: Theme.space-1;
                    if root.tab == 0: VerticalLayout {
                        spacing: Theme.space-1;
                        for title[i] in root.screens: SourceRow {
                            text: title;
                            selected: i == root.source-index;
                            clicked => { root.source-index = i; }
                        }
                    }
                    if root.tab == 1: VerticalLayout {
                        spacing: Theme.space-1;
                        for title[i] in root.windows: SourceRow {
                            text: title;
                            selected: i == root.source-index;
                            clicked => { root.source-index = i; }
                        }
                    }
                    if root.count == 0: Text {
                        text: root.tab == 0 ? "No screens to share." : "No app windows to share.";
                        color: Theme.on-surface-variant;
                    }
                }
            }
            Text { text: "Quality"; color: Theme.on-surface; }
            Select { model: root.qualities; current-index <=> root.quality-index; }
            HorizontalLayout {
                spacing: Theme.space-3; alignment: end;
                Button { text: "Cancel"; clicked => { root.dismissed(); } }
                Button {
                    text: "Go"; kind: "filled";
                    enabled: root.source-index >= 0 && root.source-index < root.count
                        && root.quality-index >= 0 && root.quality-index < root.qualities.length;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
