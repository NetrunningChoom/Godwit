// Generic chat glyphs drawn for Godwit, not network logos.
export component NetworkIcon inherits Image {
    in property <string> network;
    width: 20px;
    height: 20px;
    image-fit: contain;
    source: network == "gchat" || network == "Google Chat" ? @image-url("../../assets/networks/gchat.svg")
          : network == "slack" || network == "Slack" ? @image-url("../../assets/networks/slack.svg")
          : network == "teams" || network == "Teams" || network == "Microsoft Teams" ? @image-url("../../assets/networks/teams.svg")
          : network == "fluxer" || network == "Fluxer" ? @image-url("../../assets/networks/fluxer.svg")
          : network == "discord" || network == "Discord" ? @image-url("../../assets/networks/discord.svg")
          : network == "steam" || network == "Steam" ? @image-url("../../assets/networks/steam.svg")
          : network == "stoat" || network == "Stoat" ? @image-url("../../assets/networks/stoat.svg")
          : @image-url("../../assets/networks/chat.svg");
}
