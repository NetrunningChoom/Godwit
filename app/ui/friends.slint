import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { RequestItem, AccountItem } from "types.slint";
import { Avatar, Button, TextField, PageHeader } from "widgets.slint";

component AccountSelect inherits Rectangle {
    in property <[AccountItem]> accounts;
    in-out property <string> key;
    in-out property <string> label: "Choose network and account";
    height: 48px;
    border-radius: Theme.radius-md;
    background: field.has-hover ? Theme.surface-highest : Theme.surface-high;
    HorizontalLayout {
        padding-left: Theme.space-5;
        padding-right: Theme.space-4;
        Text { text: root.label; color: Theme.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Icon { text: Icons.expand; color: Theme.on-surface-variant; width: 24px; }
    }
    field := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            border-radius: Theme.radius-xs;
            background: Theme.surface;
            drop-shadow-blur: 3px;
            drop-shadow-color: Theme.shadow;
            VerticalLayout {
                padding-top: Theme.space-2;
                padding-bottom: Theme.space-2;
                for a in root.accounts: Rectangle {
                    height: 40px;
                    background: option.has-hover && a.can-befriend ? Theme.on-surface.with-alpha(0.08) : transparent;
                    opacity: a.can-befriend ? 1.0 : 0.45;
                    VerticalLayout {
                        x: Theme.space-4;
                        alignment: center;
                        Text { text: a.network + " · " + a.name; color: Theme.on-surface; }
                        if !a.can-befriend: Text { text: "Friend requests unavailable"; font-size: Theme.text-small; color: Theme.outline; }
                    }
                    option := TouchArea {
                        enabled: a.can-befriend;
                        clicked => {
                            root.key = a.key;
                            root.label = a.network + " · " + a.name;
                        }
                    }
                }
            }
        }
    }
}

// A pending request: theirs with Accept and Decline, ours with Cancel (the
// official Pending list).
component RequestRow inherits Rectangle {
    in property <RequestItem> item;
    callback accept();
    callback decline();
    height: 56px;
    HorizontalLayout {
        padding-left: Theme.gap-lg;
        padding-right: Theme.gap-lg;
        spacing: Theme.gap-lg;
        Rectangle {
            width: Theme.avatar;
            Avatar { source: item.avatar; has-image: item.has-avatar; initials: item.initials; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: item.name; overflow: elide; color: Theme.on-surface; }
            Text {
                text: (item.incoming ? "Wants to be friends" : "Request sent") + " · " + item.network;
                font-size: Theme.text-small;
                color: Theme.outline;
            }
        }
        if item.incoming: Button { y: (parent.height - self.height) / 2; text: "Accept"; kind: "filled"; clicked => { root.accept(); } }
        Button {
            y: (parent.height - self.height) / 2;
            text: item.incoming ? "Decline" : "Cancel";
            kind: "text";
            clicked => { root.decline(); }
        }
    }
}

// Send a friend request from a chosen account and manage pending requests.
export component Friends inherits Rectangle {
    in property <[AccountItem]> accounts;
    property <string> account-key;
    in property <[RequestItem]> requests;
    // The last request sent from here: what happened ("" for nothing yet).
    in property <string> request-status;
    in property <bool> request-failed;
    callback send-request(string, string);
    callback accept-request(int);
    callback decline-request(int);
    property <string> name;

    VerticalLayout {
        PageHeader {
            label: "Add a friend";
            glyph: Icons.group;
        }
        // Add friend, as officially: their username and tag.
        VerticalLayout {
            alignment: start;
            vertical-stretch: 0;
            padding-top: Theme.gap-lg;
            padding-left: Theme.gap-lg;
            padding-right: Theme.gap-lg;
            padding-bottom: Theme.gap-md;
            spacing: Theme.space-between;
            Text { text: "Add a friend — choose a network and account"; color: Theme.on-surface-variant; }
            AccountSelect { accounts: root.accounts; key <=> root.account-key; }
            HorizontalLayout {
                spacing: Theme.gap-md;
                TextField {
                    horizontal-stretch: 1;
                    placeholder: "Username or account ID";
                    edited(t) => { root.name = t; }
                    accepted => { if root.account-key != "" { root.send-request(root.account-key, root.name); } }
                }
                Button {
                    text: "Send request";
                    kind: "tonal";
                    enabled: root.account-key != "" && root.name != "";
                    clicked => { root.send-request(root.account-key, root.name); }
                }
            }
            if root.request-status != "": Text {
                text: root.request-status;
                font-size: Theme.text-small;
                wrap: word-wrap;
                color: root.request-failed ? Theme.error : Theme.on-surface-variant;
            }
        }
        // Friends and pending requests share one scroll range, so a long
        // pending list cannot squeeze the friends out of the page.
        list := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                width: list.visible-width;
                alignment: start;
                if root.requests.length == 0: Text {
                    text: "Friend requests will appear here.";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    height: 56px;
                    color: Theme.outline;
                }
                if root.requests.length > 0: Rectangle {
                    height: 28px;
                    Text {
                        x: Theme.gap-lg;
                        text: "Pending — " + root.requests.length;
                        vertical-alignment: center;
                        font-size: Theme.text-small;
                        font-weight: 600;
                        color: Theme.outline;
                    }
                }
                for r[i] in root.requests: RequestRow {
                    item: r;
                    accept => { root.accept-request(i); }
                    decline => { root.decline-request(i); }
                }
            }
        }
    }
}
