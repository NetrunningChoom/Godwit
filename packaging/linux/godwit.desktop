[Desktop Entry]
Type=Application
Name=Godwit
GenericName=Chat client
Comment=One client for your chat networks
Exec=godwit
Icon=godwit
StartupWMClass=godwit
Categories=Network;InstantMessaging;Chat;
Terminal=false
# One window (Desktop Entry spec 1.5): no "New Window" in the app's menu;
# opening it again brings up the running one (app/src/single_instance.rs).
SingleMainWindow=true
