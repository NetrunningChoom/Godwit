import { ListView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { ContactItem, MergeItem } from "types.slint";
import { Avatar, Button, TextField, EmojiText, PageHeader, EmptyState, ChoiceChip, NetworkSelect, MenuPanel, MenuPlace, MenuRow, MenuDivider } from "widgets.slint";

// One account as a chip: the network's name; clicking talks to them there,
// the ✕ says "this account isn't them".
export component Chip inherits ChoiceChip { }

// Everyone as one person across networks. Godwit never links accounts on
// its own: the user picks "Link" on one person, then who they also are.
export component People inherits Rectangle {
    in property <[ContactItem]> people;
    // People who might be one (see MergeItem): suggestions, never merged alone.
    in property <[MergeItem]> merges;
    // The person being linked, or -1.
    in-out property <int> linking: -1;
    callback link(int, int);
    // A suggested merge (by its index in `merges`) taken or turned down.
    callback merge(int);
    callback not-same(int);
    callback nudges(int, bool);
    callback unlink(int, int);
    callback choose(int, int);
    callback message(int);
    callback favourite(int);
    // Only favourites are listed (set by the app).
    in property <bool> favourites-only: false;
    // Back to their own name (drops our nickname for them).
    callback reset-nickname(int);
    // Search by name and a network filter ("" for all), applied by the app.
    in property <[string]> networks;
    in-out property <string> filter;
    // The search's text, kept by the window (it survives the list redrawing).
    in-out property <string> query;
    callback search(string);
    callback filtered(string);
    property <int> menu-person: -1;
    property <length> menu-x;
    property <length> menu-y;

    VerticalLayout {
        PageHeader {
            glyph: Icons.link;
            label: root.linking >= 0 && root.linking < root.people.length
                ? "Who else is " + root.people[root.linking].name + "?" : "People";
                if root.linking >= 0: Button {
                    y: (parent.height - self.height) / 2;
                    text: "Cancel";
                    kind: "text";
                    clicked => { root.linking = -1; }
                }
        }
        // Finding someone: by name, and by the network they're on.
        HorizontalLayout {
            padding-left: Theme.gap-lg;
            padding-right: Theme.gap-lg;
            padding-bottom: Theme.gap-md;
            spacing: Theme.gap-sm;
            Button {
                text: root.favourites-only ? "★ Favourites" : "☆ Favourites";
                kind: root.favourites-only ? "tonal" : "text";
                clicked => { root.filtered("favourites-only"); }
            }
            TextField {
                horizontal-stretch: 1;
                text <=> root.query;
                placeholder: root.linking >= 0 ? "Search for who they also are" : "Search people";
                edited(t) => { root.search(t); people-list.content-y = 0; }
            }
            if root.query != "": Button {
                y: (parent.height - self.height) / 2;
                text: "Clear";
                kind: "text";
                clicked => { root.query = ""; root.search(""); people-list.content-y = 0; }
            }
            if root.networks.length > 0: NetworkSelect {
                networks: root.networks;
                selected-network: root.filter;
                selected(n) => { root.filter = n; root.filtered(n); people-list.content-y = 0; }
            }
        }
        if root.people.length == 0: EmptyState {
            text: root.filter != "" ? "Nobody here matches." : "Your people will appear here. Add a friend to get started.";
        }
        // Suggested merges, above everyone: names nearly the same on
        // different networks. Godwit never merges on its own.
        if root.merges.length > 0 && root.linking < 0: VerticalLayout {
            padding-left: Theme.gap-lg;
            padding-right: Theme.gap-lg;
            padding-bottom: Theme.gap-md;
            spacing: Theme.space-2;
            Text {
                text: "Suggested merges — " + root.merges.length;
                font-size: Theme.text-small;
                font-weight: 600;
                color: Theme.outline;
            }
            for m[k] in root.merges: Rectangle {
                height: Theme.row-member;
                border-radius: Theme.radius-sm;
                background: Theme.surface-low;
                HorizontalLayout {
                    padding-left: Theme.gap-md;
                    padding-right: Theme.gap-md;
                    spacing: Theme.gap-md;
                    Text {
                        horizontal-stretch: 1;
                        text: m.a-name + " (" + m.a-where + ") and " + m.b-name + " (" + m.b-where + ") might be the same person";
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.on-surface;
                    }
                    Button {
                        y: (parent.height - self.height) / 2;
                        text: "Merge";
                        kind: "tonal";
                        clicked => { root.merge(k); }
                    }
                    Button {
                        y: (parent.height - self.height) / 2;
                        text: "Not the same";
                        kind: "text";
                        clicked => { root.not-same(k); }
                    }
                }
            }
        }
        people-list := ListView {
            vertical-stretch: 1;
            for person[i] in root.people: VerticalLayout {
                // Where the favourites start, and where everyone else does
                // (headed like the friends page's "Pending").
                if person.section != "": Rectangle {
                    height: 28px;
                    Text {
                        x: Theme.gap-lg;
                        text: person.section;
                        vertical-alignment: center;
                        font-size: Theme.text-small;
                        font-weight: 600;
                        color: Theme.outline;
                    }
                }
                Rectangle {
                    // A line of chips more for every three accounts past the first three.
                    height: 76px + max(0, person.identity-rows.length - 1) * 34px;
                    property <bool> pickable: root.linking >= 0 && root.linking != i;
                    // Not secondary-container: the chosen chip is drawn in it.
                    background: root.linking == i ? Theme.surface-highest
                        : touch.has-hover && self.pickable ? Theme.surface-high
                        : touch.has-hover ? Theme.surface-low : transparent;
                    // While linking, a click anywhere on someone picks them.
                    touch := TouchArea {
                        mouse-cursor: parent.pickable ? pointer : default;
                        pointer-event(e) => {
                            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down && root.linking < 0 {
                                root.menu-person = i;
                                root.menu-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                                root.menu-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                                person-menu.show();
                            }
                        }
                        clicked => {
                            if parent.pickable {
                                root.link(root.linking, i);
                                root.linking = -1;
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.gap-lg;
                        padding-right: Theme.gap-lg;
                        spacing: Theme.gap-lg;
                        Avatar {
                            y: (parent.height - self.height) / 2;
                            source: person.avatar;
                            has-image: person.has-avatar;
                            initials: person.initials;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Theme.space-compact;
                            // The name, then their accounts three to a line, so
                            // neither is ever squeezed out.
                            for line[r] in person.identity-rows: HorizontalLayout {
                                spacing: Theme.gap-md;
                                if r == 0: EmojiText {
                                    text: person.name;
                                    runs: person.name-runs;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                }
                                // Starred: the same ★ as the Favourites filter.
                                if r == 0 && person.favourite: Text {
                                    text: "★";
                                    vertical-alignment: center;
                                    font-size: Theme.text-body;
                                    color: Theme.primary;
                                }
                                for id[k] in line.items: Chip {
                                    label: id.network;
                                    chosen: id.chosen;
                                    removable: person.identities.length > 1 && root.linking < 0;
                                    choose => { root.choose(i, line.first + k); }
                                    remove => { root.unlink(i, line.first + k); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: Theme.gap-md;
                                Text {
                                    text: person.talk-on;
                                    vertical-alignment: center;
                                    font-size: Theme.text-small;
                                    overflow: elide;
                                    color: Theme.on-surface-variant;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        if root.linking < 0: Button {
                            y: (parent.height - self.height) / 2;
                            text: "Message";
                            kind: "tonal";
                            clicked => { root.message(i); }
                        }
                    }
                }
            }
        }
    }
    person-menu := PopupWindow {
        x: MenuPlace.fit-x(root.menu-x, 220px, root.absolute-position.x);
        y: MenuPlace.fit-y(root.menu-y, MenuPlace.rows-h(5, 1), root.absolute-position.y);
        MenuPanel {
            menu-max-height: MenuPlace.limit();
            dismissed => { person-menu.close(); }
            if root.menu-person >= 0 && root.menu-person < root.people.length: MenuRow {
                glyph: Icons.link;
                label: "Link another account";
                clicked => { root.linking = root.menu-person; }
            }
            if root.menu-person >= 0 && root.menu-person < root.people.length: MenuRow {
                glyph: Icons.star-icon;
                label: root.people[root.menu-person].favourite ? "Remove from favourites" : "Add to favourites";
                clicked => { root.favourite(root.menu-person); }
            }
            if root.menu-person >= 0 && root.menu-person < root.people.length
                && root.people[root.menu-person].nickname != "": MenuRow {
                glyph: Icons.edit;
                label: "Reset nickname";
                clicked => { root.reset-nickname(root.menu-person); }
            }
            if root.menu-person >= 0 && root.menu-person < root.people.length
                && root.people[root.menu-person].no-nudges
                && root.people[root.menu-person].identities.length > 1: MenuRow {
                glyph: Icons.link;
                label: "Suggest switching again";
                clicked => { root.nudges(root.menu-person, true); }
            }
            MenuDivider { }
            MenuRow { glyph: Icons.chat; label: "Message"; clicked => { root.message(root.menu-person); } }
        }
    }
}
