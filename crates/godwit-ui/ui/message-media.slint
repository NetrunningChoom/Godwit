import { Theme, Icons, Icon } from "theme.slint";
import { Anim, Players, VoicePlayback, AttachmentItem, EmbedItem, InviteItem } from "types.slint";
import { GifStar } from "gif-picker.slint";
import { Avatar, Button, EmojiText, IconButton } from "widgets.slint";

// An audio attachment's player row: play or pause, the loudness bars (a plain
// bar without them) that a click seeks on, the time, the speed and the volume.
// Only the row whose key is playing follows the progress.
component VoicePlayer inherits HorizontalLayout {
    in property <AttachmentItem> item;
    callback context-menu(length, length);
    property <bool> active: VoicePlayback.key == item.key && VoicePlayback.state != 0;
    property <float> progress: active ? VoicePlayback.progress : 0;
    property <bool> shown-playing: active && VoicePlayback.state == 2;
    padding: Theme.gap-md;
    spacing: Theme.gap-md;
    // The button: a play triangle, or two bars while playing.
    Rectangle {
        width: Theme.control-icon;
        IconButton {
            glyph: root.shown-playing ? "" : Icons.play;
            tint: Theme.primary;
            clicked => { VoicePlayback.toggle(root.item.key); }
        }
        if root.shown-playing: HorizontalLayout {
            width: Theme.icon-small;
            height: Theme.icon-small;
            spacing: Theme.space-2;
            alignment: center;
            Rectangle { background: Theme.primary; width: Theme.space-3; border-radius: Theme.space-1; }
            Rectangle { background: Theme.primary; width: Theme.space-3; border-radius: Theme.space-1; }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        if !item.voice: Text { text: item.name; color: Theme.primary; overflow: elide; font-size: Theme.text-small; }
        bar := Rectangle {
            height: Theme.icon-medium;
            // Loudness bars, or a track with the played part filled.
            if item.wave.length == 0: Rectangle {
                y: (parent.height - self.height) / 2;
                height: Theme.space-2;
                border-radius: Theme.space-1;
                background: Theme.outline;
                Rectangle {
                    width: parent.width * root.progress;
                    border-radius: parent.border-radius;
                    background: Theme.primary;
                }
            }
            for level[i] in item.wave: Rectangle {
                property <length> slot: bar.width / item.wave.length;
                x: i * slot;
                width: max(slot - Theme.space-1, Theme.space-1);
                height: max(bar.height * level, Theme.space-2);
                y: (bar.height - self.height) / 2;
                border-radius: Theme.space-1;
                background: (i + 0.5) / item.wave.length <= root.progress ? Theme.primary : Theme.outline;
            }
            // A press or a drag along the bars of the playing one seeks (as
            // Yapfast's 09496be3); one that isn't playing starts on a click.
            bar-touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.down && root.active {
                        VoicePlayback.seek(root.item.key, clamp(self.mouse-x / self.width, 0, 1));
                    }
                }
                moved => {
                    if self.pressed && root.active {
                        VoicePlayback.seek(root.item.key, clamp(self.mouse-x / self.width, 0, 1));
                    }
                }
                clicked => {
                    if !root.active {
                        VoicePlayback.toggle(root.item.key);
                    }
                }
            }
        }
    }
    // As wide as its widest text, so the row keeps its width while the time
    // changes: 0 is the widest digit in the font.
    Rectangle {
        width: max(time-label.preferred-width, widest-time.preferred-width);
        widest-time := Text {
            visible: false;
            font-size: Theme.text-small;
            text: item.length.character-count > 5 ? "0:00:00 / 0:00:00" : item.length.character-count == 5 ? "00:00 / 00:00" : "0:00 / 0:00";
        }
        time-label := Text {
            x: 0;
            width: self.preferred-width;
            text: root.active ? VoicePlayback.time : item.length;
            color: Theme.on-surface-variant;
            font-size: Theme.text-small;
            vertical-alignment: center;
        }
    }
    Rectangle {
        width: widest-speed.preferred-width + Theme.gap-md;
        border-radius: Theme.radius-sm;
        background: speed-touch.has-hover ? Theme.surface-highest : transparent;
        widest-speed := Text {
            visible: false;
            text: "1.5x";
            font-size: Theme.text-small;
            font-weight: 600;
        }
        speed-label := Text {
            text: VoicePlayback.speed;
            color: Theme.on-surface-variant;
            font-size: Theme.text-small;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        speed-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { VoicePlayback.cycle-speed(); }
        }
    }
    // Mute and unmute; the volume below stays where it is.
    IconButton {
        glyph: VoicePlayback.muted ? Icons.volume-off : Icons.volume-up;
        clicked => { VoicePlayback.mute(!VoicePlayback.muted); }
    }
    // Volume: a short track, the filled part its level.
    Rectangle {
        width: Theme.icon-large * 2;
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: Theme.space-2;
            border-radius: Theme.space-1;
            background: Theme.outline;
            Rectangle {
                width: parent.width * (VoicePlayback.muted ? 0 : VoicePlayback.volume);
                border-radius: parent.border-radius;
                background: Theme.on-surface-variant;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { VoicePlayback.set-volume(clamp(self.mouse-x / self.width, 0, 1)); }
            moved => { if self.pressed { VoicePlayback.set-volume(clamp(self.mouse-x / self.width, 0, 1)); } }
        }
    }
}

export component AttachmentView inherits Rectangle {
    in property <AttachmentItem> item;
    property <bool> spoiler-revealed: item.spoiler-revealed;
    callback open();
    callback context-menu(length, length);
    // Images: the preview at its size; everything else: a file card.
    // Godwit's file card is a fixed width; its own preferred width is 0.
    width: item.kind == 0 ? item.width : 360px;
    height: item.kind == 0 ? item.height : 56px;
    border-radius: Theme.radius-md;
    clip: true;
    background: item.kind == 0 ? Theme.surface-high : Theme.surface-high;
    if item.kind == 0 && item.has-image: Image {
        width: parent.width;
        height: parent.height;
        source: item.anim >= 0 ? Anim.frames[item.anim] : item.image;
        image-fit: contain;
        visible: !item.spoiler || root.spoiler-revealed;
    }
    if item.spoiler && !root.spoiler-revealed: Button {
        text: "Click to reveal spoiler";
        clicked => { root.spoiler-revealed = true; }
    }
    if item.kind != 0 && item.key == "": HorizontalLayout {
        padding: Theme.gap-md;
        spacing: Theme.gap-md;
        Icon { text: Icons.file; font-size: Theme.text-display; color: Theme.on-surface-variant; width: 32px; }
        VerticalLayout {
            alignment: center;
            Text { text: item.name; color: Theme.primary; overflow: elide; }
            Text { text: item.detail; font-size: Theme.text-small; color: Theme.outline; }
        }
        if item.openable: Icon { text: Icons.open-in-new; color: Theme.on-surface-variant; width: Theme.icon-large; }
    }
    // Players take their own clicks; a right click still opens the menu.
    TouchArea {
        mouse-cursor: item.openable && item.key == "" ? pointer : default;
        clicked => { if item.openable && item.key == "" { root.open(); } }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    if item.key != "": VoicePlayer {
        width: parent.width;
        height: parent.height;
        item: root.item;
        context-menu(x, y) => { root.context-menu(x, y); }
    }
}

// An embed's media, as the official Embed draws it: the picture, or for a
// player or video a dark area until it plays, with a play button over it.
// Clicking a picture opens its page; clicking a player starts it in place.
export component EmbedMedia inherits Rectangle {
    in property <EmbedItem> embed;
    callback link-clicked(string);
    callback play-inline(string, string);
    callback player-fullscreen(string);
    callback player-pointer(string, int, int, bool);
    callback player-move(string, int, int);
    // The player is loaded at this size (view::embed_media_size), so the
    // pointer maps straight onto its page.
    width: embed.width;
    height: embed.height;
    border-radius: Theme.radius-md;
    background: (embed.play-url != "" && !embed.has-image) || embed.inline-playing ? Theme.media : transparent;
    if embed.has-image && !embed.has-player-frame: Image {
        width: parent.width;
        height: parent.height;
        source: embed.anim >= 0 ? Anim.frames[embed.anim] : embed.image;
        image-fit: contain;
    }
    // GIFs keep this even while their video loops: a click opens the page.
    if !embed.inline-playing || embed.style == 2: gif-touch := TouchArea {
        mouse-cursor: pointer;
        // A GIF's star, on hover: it goes to the picker's Favourites.
        if embed.style == 2 && embed.gif-picture != "" && gif-touch.has-hover: GifStar {
            x: parent.width - self.width - 6px;
            y: 6px;
            gif: embed.url != "" ? embed.url : embed.gif-picture;
            picture: embed.gif-picture;
        }
        clicked => {
            if embed.play-url != "" && embed.style != 2 {
                root.play-inline(embed.play-url, embed.play-kind);
            } else if embed.url != "" && embed.has-image {
                // The picture large, in the viewer (its page stays a link in the title).
                root.link-clicked("godwit://view/" + embed.url);
            } else if embed.url != "" {
                root.link-clicked(embed.url);
            }
        }
    }
    if embed.play-url != "" && embed.style != 2 && !embed.inline-playing: Rectangle {
        width: 44px;
        height: 44px;
        border-radius: self.width / 2;
        background: Theme.scrim-play;
        Icon { text: Icons.play; color: Theme.on-media; font-size: Theme.text-media-control; }
    }
    if embed.inline-playing && embed.has-player-frame: Image {
        width: parent.width;
        height: parent.height;
        source: Players.frames[embed.player-slot];
        image-fit: contain;
        // The frame comes at the screen's pixels: copied as-is, not smoothed
        // (smoothing blurred the player's controls and text).
        image-rendering: pixelated;
        if embed.style != 2: TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.player-pointer(embed.play-url, round(self.mouse-x / 1px), round(self.mouse-y / 1px), true);
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    root.player-pointer(embed.play-url, round(self.mouse-x / 1px), round(self.mouse-y / 1px), false);
                }
            }
            // Every move, hovering too: pages open things on hover
            // (YouTube's volume slider only widens under the pointer) and
            // drag them while pressed. `mouse-x/y` follow the pointer in
            // both cases, where a move event alone didn't reach the page.
            changed mouse-x => {
                if self.has-hover || self.pressed {
                    root.player-move(embed.play-url, round(self.mouse-x / 1px), round(self.mouse-y / 1px));
                }
            }
            changed mouse-y => {
                if self.has-hover || self.pressed {
                    root.player-move(embed.play-url, round(self.mouse-x / 1px), round(self.mouse-y / 1px));
                }
            }
        }
    }
    // Godwit's corner button on a loaded player: it moves to its own
    // window, fullscreen.
    if embed.inline-playing && embed.style != 2: Rectangle {
        x: parent.width - self.width - 6px;
        y: 6px;
        width: 28px;
        height: 28px;
        border-radius: self.height / 2;
        background: full-area.has-hover ? Theme.scrim-control : Theme.scrim-control-idle;
        Icon { text: Icons.fullscreen; color: Theme.on-media; font-size: Theme.text-large; }
        full-area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.player-fullscreen(embed.play-url); }
        }
    }
}

// The official embed card (Godwit's port): primary-container colours, the
// embed's own colour as the left bar, at most 432 px wide.
export component EmbedCard inherits Rectangle {
    in property <EmbedItem> embed;
    callback link-clicked(string);
    callback play-inline(string, string);
    callback player-fullscreen(string);
    callback player-pointer(string, int, int, bool);
    callback player-move(string, int, int);
    width: 432px;
    border-radius: Theme.radius-md;
    background: Theme.primary-container;
    clip: true;
    Rectangle {
        x: 0;
        width: 4px;
        height: parent.height;
        background: embed.has-accent ? embed.accent : Theme.primary;
    }
    VerticalLayout {
        padding-left: Theme.space-5;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        spacing: Theme.space-3;
        HorizontalLayout {
            spacing: Theme.space-4;
            VerticalLayout {
                spacing: Theme.space-2;
                horizontal-stretch: 1;
                if embed.site-name != "" || embed.has-icon: HorizontalLayout {
                    spacing: Theme.space-compact;
                    alignment: start;
                    if embed.has-icon: Image {
                        width: Theme.icon-small;
                        height: Theme.icon-small;
                        source: embed.icon;
                    }
                    if embed.site-name != "": Text {
                        text: embed.site-name;
                        color: Theme.on-primary-container;
                        font-size: Theme.text-small;
                        vertical-alignment: center;
                    }
                }
                if embed.title != "": Text {
                    text: embed.title;
                    color: Theme.primary;
                    font-size: Theme.message-size;
                    font-weight: 600;
                    wrap: word-wrap;
                    TouchArea {
                        enabled: embed.url != "";
                        mouse-cursor: embed.url != "" ? pointer : default;
                        clicked => { root.link-clicked(embed.url); }
                    }
                }
                if embed.has-description: StyledText {
                    // Measured at its own width, as message text (see the blocks).
                    height: self.preferred-height;
                    text: embed.description;
                    default-color: Theme.on-primary-container;
                    default-font-size: Theme.message-size;
                    link-color: Theme.primary;
                    link-clicked(url) => { root.link-clicked(url); }
                }
            }
            if embed.image-thumbnail && embed.has-image: Image {
                width: 80px;
                height: 80px;
                source: embed.anim >= 0 ? Anim.frames[embed.anim] : embed.image;
                image-fit: contain;
                vertical-stretch: 0;
            }
        }
        if embed.has-media: HorizontalLayout {
            alignment: start;
            EmbedMedia {
                embed: embed;
                link-clicked(u) => { root.link-clicked(u); }
                play-inline(u, k) => { root.play-inline(u, k); }
                player-fullscreen(u) => { root.player-fullscreen(u); }
                player-pointer(u, x, y, d) => { root.player-pointer(u, x, y, d); }
                player-move(u, x, y) => { root.player-move(u, x, y); }
            }
        }
    }
}

// An invite link's card, as the official messaging/elements/Invite: 320 ×
// 64 px on secondary-container, the server's 42 px icon, its name and
// member count, and Join (Joined, greyed, once in).
// An invitation to something outside the chat, as Steam's game invite card:
// what kind on top, then the art, its name and Join.
export component ActivityCard inherits Rectangle {
    in property <EmbedItem> embed;
    callback join();
    callback link-clicked(string);
    width: Theme.activity-card-width;
    border-radius: Theme.radius-md;
    background: Theme.secondary-container;
    VerticalLayout {
        padding: Theme.space-invite;
        spacing: Theme.space-3;
        Text {
            text: embed.site-name;
            font-size: Theme.text-caption;
            font-weight: 600;
            overflow: elide;
            color: Theme.on-secondary-container;
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            Rectangle {
                width: Theme.capsule-width;
                height: Theme.capsule-height;
                border-radius: Theme.radius-xs;
                background: Theme.surface-highest;
                if embed.has-image: Image {
                    width: parent.width;
                    height: parent.height;
                    source: embed.image;
                    image-fit: contain;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Theme.space-3;
                Text {
                    text: embed.title;
                    font-size: Theme.text-label;
                    font-weight: 600;
                    wrap: word-wrap;
                    color: Theme.on-secondary-container;
                }
                if embed.url != "" || embed.more-url != "": HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-3;
                    if embed.url != "": Button {
                        text: "Join";
                        kind: "filled";
                        clicked => { root.join(); }
                    }
                    if embed.more-url != "": Button {
                        text: embed.more-label;
                        kind: "text";
                        clicked => { root.link-clicked(embed.more-url); }
                    }
                }
            }
        }
    }
}

export component InviteCard inherits Rectangle {
    in property <InviteItem> item;
    callback join();
    width: 320px;
    height: 64px;
    border-radius: Theme.radius-md;
    background: Theme.secondary-container;
    HorizontalLayout {
        padding: Theme.space-invite;
        spacing: Theme.space-4;
        if item.state == 4: Text {
            text: "This invite isn't valid (any more).";
            vertical-alignment: center;
            color: Theme.on-secondary-container;
        }
        if item.state == 0: Text {
            text: "Loading invite…";
            vertical-alignment: center;
            color: Theme.on-secondary-container;
        }
        if item.state >= 1 && item.state <= 3: Avatar {
            size: 42px;
            source: item.icon;
            has-image: item.has-icon;
            initials: item.initials;
        }
        if item.state >= 1 && item.state <= 3: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: item.name; font-size: Theme.text-label; font-weight: 600; overflow: elide; color: Theme.on-secondary-container; }
            Text { text: item.members; font-size: Theme.text-small; color: Theme.on-secondary-container; }
        }
        if item.state >= 1 && item.state <= 3: Button {
            y: (parent.height - self.height) / 2;
            text: item.state == 3 ? "Joined" : item.state == 2 ? "Joining…" : "Join";
            kind: "filled";
            enabled: item.state == 1;
            clicked => { root.join(); }
        }
    }
}

