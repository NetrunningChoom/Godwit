import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EmojiRowItem, EmojiCellItem } from "types.slint";
import { TextField } from "widgets.slint";

// The emoji picker, as Godwit's: a search, then 36 px cells nine to a row.
// Rows are uniform, so the scroll position says which are on screen.
export component EmojiPicker inherits Rectangle {
    in property <[EmojiRowItem]> rows;
    callback search(string);
    callback picked(int, int);
    // The top row on screen.
    callback scrolled-to(int);
    callback escape();
    // Nine cells, the padding, and the list's scrollbar (which otherwise
    // covered the ninth column).
    width: 9 * 36px + 24px + 16px;
    // The top row on screen: the category bar marks its section.
    property <int> top: 0;
    // The arrow keys moved the highlight (the mouse takes it back).
    property <bool> keys: false;
    // The emoji the preview bar shows: the one last hovered (or the first
    // of the pack last picked); -1 until then.
    property <int> hover-row: -1;
    property <int> hover-col: 0;
    // Before any hover the preview shows the first emoji, as the official
    // picker does (`EmojiPicker.tsx`, its `hoveredItem` effect).
    property <int> first-row: root.rows.length > 0 && root.rows[0].header ? 1 : 0;
    property <bool> hover-ok: root.hover-row >= 0 && root.hover-row < root.rows.length
        && !root.rows[root.hover-row].header && root.hover-col < root.rows[root.hover-row].cells.length;
    property <int> preview-row: root.hover-ok ? root.hover-row : root.first-row;
    property <int> preview-col: root.hover-ok ? root.hover-col : 0;
    property <bool> has-preview: root.preview-row < root.rows.length && !root.rows[root.preview-row].header
        && root.preview-col < root.rows[root.preview-row].cells.length;
    property <EmojiCellItem> preview: root.has-preview ? root.rows[root.preview-row].cells[root.preview-col] : { };
    // A custom emoji's pack (its section heading, e.g. the server); none for
    // Unicode emoji or in search results, as officially.
    property <int> preview-section: root.has-preview ? root.rows[root.preview-row].section : 0;
    property <string> preview-from: root.has-preview && root.preview.glyph == "" && root.preview-section < root.rows.length
        && root.rows[root.preview-section].header ? root.rows[root.preview-section].title : "";
    // Moves the highlight: `dx` cells along (wrapping to the next or
    // previous row), `dy` rows up or down (keeping the column), then scrolls
    // it into view.
    // The row the highlight moves to from (r, c).
    pure function target-row(r: int, c: int, dx: int, dy: int) -> int {
        return dy > 0 ? root.rows[r].below
            : dy < 0 ? root.rows[r].above
            : dx > 0 && c + 1 >= root.rows[r].cells.length ? root.rows[r].below
            : dx < 0 && c <= 0 ? root.rows[r].above
            : r;
    }
    function step(dx: int, dy: int) {
        if !root.has-preview {
            return;
        }
        root.keys = true;
        // Stay put at either end of the list.
        if root.target-row(root.preview-row, root.preview-col, dx, dy) < 0 {
            return;
        }
        root.go(root.target-row(root.preview-row, root.preview-col, dx, dy), root.preview-row, root.preview-col, dx);
    }
    function go(nr: int, r: int, c: int, dx: int) {
        root.hover-row = nr;
        root.hover-col = nr == r ? c + dx
            : dx > 0 ? 0
            : dx < 0 ? root.rows[nr].cells.length - 1
            : min(c, root.rows[nr].cells.length - 1);
        if nr * 36px < -list.content-y {
            list.content-y = -(nr * 36px);
        } else if (nr + 1) * 36px > -list.content-y + list.visible-height {
            list.content-y = -((nr + 1) * 36px - list.visible-height);
        }
    }
    height: 440px;
    border-radius: Theme.radius-lg;
    background: Theme.surface-high;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.shadow;
    TouchArea { }
    // Escape anywhere inside (the search too) closes the picker. The arrow
    // keys move through the emoji and Enter picks the highlighted one (the
    // first before any move); the official picker has no keyboard support
    // beyond Tab (`EmojiPicker.tsx`), so this follows Godwit's switcher.
    FocusScope {
        // Left and right belong to the search's caret unless it is empty.
        capture-key-pressed(e) => {
            if field.text == "" && (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                root.step(e.text == Key.RightArrow ? 1 : -1, 0);
                return accept;
            }
            reject
        }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.escape();
                return accept;
            }
            if e.text == Key.DownArrow {
                root.step(0, 1);
                return accept;
            }
            if e.text == Key.UpArrow {
                root.step(0, -1);
                return accept;
            }
            reject
        }
    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;
        field := TextField {
            placeholder: "Search for emojis...";
            autofocus: true;
            edited(t) => { root.hover-row = -1; root.keys = false; root.search(t); }
            // Enter picks the highlighted emoji (the first one by default).
            accepted => {
                if root.has-preview {
                    root.picked(root.preview-row, root.preview-col);
                }
            }
        }
        // The categories (each server's emoji, then the Unicode groups), as
        // Discord's picker: each is its first emoji; clicking jumps there.
        bar := Flickable {
            height: 32px;
            content-width: max(self.width, sections.preferred-width);
            // No spacing: every row has a (zero-width) place here.
            sections := HorizontalLayout {
                alignment: start;
                spacing: 0;
                for row[i] in root.rows: Rectangle {
                    // Only headings make a button (with a row after them).
                    property <bool> section: row.header && i + 1 < root.rows.length && root.rows[i + 1].cells.length > 0;
                    width: self.section ? 34px : 0px;
                    visible: self.section;
                    border-radius: Theme.radius-sm;
                    background: jump.has-hover ? Theme.surface-highest
                        : self.section && root.top < root.rows.length && root.rows[root.top].section == i ? Theme.secondary-container : transparent;
                    if self.section && root.rows[i + 1].cells[0].has-image: Image {
                        width: 22px;
                        height: 22px;
                        source: root.rows[i + 1].cells[0].image;
                    }
                    if self.section && !root.rows[i + 1].cells[0].has-image: Text {
                        text: root.rows[i + 1].cells[0].glyph;
                        font-size: Theme.text-heading;
                        color: Theme.on-surface;
                    }
                    jump := TouchArea {
                        enabled: parent.section;
                        mouse-cursor: pointer;
                        clicked => {
                            list.content-y = -(i * 36px);
                            // Picking a pack previews its first emoji.
                            root.hover-row = i + 1;
                            root.hover-col = 0;
                            root.top = i;
                            root.scrolled-to(i);
                        }
                    }
                }
            }
        }
        list := ListView {
            vertical-stretch: 1;
            // Not `scrolled`: it doesn't fire for the mouse wheel.
            changed content-y => {
                root.top = floor(-self.content-y / 36px);
                root.scrolled-to(root.top);
            }
            for row[i] in root.rows: Rectangle {
                height: 36px;
                if row.header: Text {
                    x: 4px;
                    y: parent.height - self.height - 8px;
                    text: row.title;
                    font-size: Theme.text-small;
                    font-weight: 600;
                    color: Theme.on-surface-variant;
                }
                if !row.header: HorizontalLayout {
                    alignment: start;
                    for cell[j] in row.cells: Rectangle {
                        width: 36px;
                        border-radius: Theme.radius-sm;
                        background: pick.has-hover || (root.keys && root.hover-row == i && root.hover-col == j)
                            ? Theme.surface-highest : transparent;
                        if cell.has-image: Image {
                            width: 24px;
                            height: 24px;
                            source: cell.image;
                        }
                        if !cell.has-image: Text { text: cell.glyph; font-size: Theme.text-large; color: Theme.on-surface; }
                        pick := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.picked(i, j); }
                            changed has-hover => {
                                if self.has-hover {
                                    root.keys = false;
                                    root.hover-row = i;
                                    root.hover-col = j;
                                }
                            }
                        }
                        Tooltip {
                            Rectangle {
                                width: tip.preferred-width + 16px;
                                height: tip.preferred-height + 8px;
                                border-radius: Theme.radius-xs;
                                background: Theme.surface-highest;
                                tip := Text { text: cell.name; color: Theme.on-surface; font-size: Theme.text-small; }
                            }
                        }
                    }
                }
            }
        }
        // The preview bar under the list, as the official picker's
        // `EmojiPreviewBar`: the emoji at 24 px, its :name: (0.875rem, 600)
        // and, for a custom emoji, "from <pack>" (0.75rem, muted); 36 px tall.
        HorizontalLayout {
            height: 36px;
            padding-left: Theme.gap-md;
            padding-right: Theme.gap-md;
            spacing: Theme.gap-md;
            visible: root.has-preview;
            Rectangle {
                width: 24px;
                if root.preview.has-image: Image {
                    width: 24px;
                    height: 24px;
                    source: root.preview.image;
                }
                if !root.preview.has-image: Text { text: root.preview.glyph; font-size: Theme.text-large; color: Theme.on-surface; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: Theme.space-1;
                Text {
                    text: root.preview.name;
                    overflow: elide;
                    font-size: Theme.text-body;
                    font-weight: 600;
                    color: Theme.on-surface;
                }
                if root.preview-from != "": Text {
                    text: "from " + root.preview-from;
                    overflow: elide;
                    font-size: Theme.text-small;
                    color: Theme.on-surface-variant;
                }
            }
        }
    }
    }
}
