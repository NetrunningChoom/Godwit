import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Anim } from "types.slint";
import { TextField } from "widgets.slint";

// One tile: a GIF's looping preview, or a category (its picture and title).
export struct GifTileItem {
    // A GIF's link and picture (empty on category tiles): its star.
    gif: string,
    picture: string,
    image: image,
    has-image: bool,
    // Its animation slot (Anim.frames), -1 when still.
    anim: int,
    // A category's title ("" for a GIF).
    title: string,
}

// One sticker tile (app/src/stickers.rs): its still picture, its name for
// the hover hint; not `enabled` while the network refuses it.
export struct StickerTileItem {
    image: image,
    has-image: bool,
    name: string,
    enabled: bool,
}

// The GIF picker's contents (app/src/gifs.rs), as a global: the composer and
// the panel both read it without passing it down through every view.
export global Gifs {
    // The room allows GIFs (the composer shows the button while empty).
    in property <bool> available;
    in-out property <bool> open;
    in property <[GifTileItem]> tiles;
    // Loading, an error, or "no GIFs found"; "" when the tiles say it all.
    in property <string> status;
    // What's shown: "" the categories, else a search (or trending).
    in-out property <string> query;
    callback opened();
    // Typed into the search (the app waits for typing to pause).
    callback search(string);
    // A tile was picked: a category opens, a GIF is sent.
    callback picked(int);
    // The top row on screen, and whether the list's end is near.
    callback scrolled(int, bool);
    callback closed();
    // Stars or unstars a GIF (its link, its looping picture).
    callback toggle-favourite(string, string);
    // Whether a link is starred; `version` changes with every star, so stars redraw.
    pure callback is-favourite(string, int) -> bool;
    in-out property <int> favourites-version;
    // The picker's tab: 0 GIFs, 1 Stickers (a room that takes stickers).
    in-out property <int> tab;
    in property <bool> stickers-available;
    in property <[StickerTileItem]> sticker-tiles;
    in property <string> sticker-status;
    callback sticker-search(string);
    callback sticker-picked(int);
    // The top row on screen.
    callback sticker-scrolled(int);
    callback tab-changed();
}

// A picker tab: the active one is underlined as the official client's.
component PickerTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 32px;
    background: tab-touch.has-hover && !root.active ? Theme.surface-highest : transparent;
    border-radius: Theme.radius-sm;
    Text {
        text: root.label;
        color: root.active ? Theme.on-surface : Theme.on-surface-variant;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.active: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.primary;
    }
    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A GIF's star: filled once it's a favourite. On GIFs in the picker and in chat.
export component GifStar inherits Rectangle {
    in property <string> gif;
    in property <string> picture;
    property <bool> starred: Gifs.is-favourite(root.gif, Gifs.favourites-version);
    width: 28px;
    height: 28px;
    border-radius: self.height / 2;
    background: star-touch.has-hover ? Theme.scrim-control : Theme.scrim-control-idle;
    Text {
        text: root.starred ? "★" : "☆";
        color: root.starred ? Theme.primary : Theme.on-media;
        font-size: Theme.text-title;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    star-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Gifs.toggle-favourite(root.gif, root.picture); }
    }
}

// The official GIF picker: a search above two columns of looping previews;
// without a search, the categories (with Trending first).
export component GifPicker inherits Rectangle {
    // Two 168 px columns, the padding, and the list's scrollbar.
    width: 2 * 168px + 8px + 24px + 16px;
    height: 440px;
    border-radius: Theme.radius-lg;
    background: Theme.surface-high;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.shadow;
    TouchArea {
        scroll-event(e) => { accept }
    }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                Gifs.open = false;
                Gifs.closed();
                return accept;
            }
            reject
        }
    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;
        if Gifs.stickers-available && Gifs.available: HorizontalLayout {
            spacing: Theme.space-3;
            PickerTab {
                label: "GIFs";
                active: Gifs.tab == 0;
                clicked => { Gifs.tab = 0; Gifs.tab-changed(); }
            }
            PickerTab {
                label: "Stickers";
                active: Gifs.tab == 1;
                clicked => { Gifs.tab = 1; Gifs.tab-changed(); }
            }
        }
        if Gifs.tab == 1: sticker-search := TextField {
            placeholder: "Search for stickers...";
            autofocus: true;
            edited(t) => { Gifs.sticker-search(t); }
        }
        if Gifs.tab == 1 && Gifs.sticker-status != "": Text {
            text: Gifs.sticker-status;
            color: Theme.on-surface-variant;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if Gifs.tab == 1: sticker-list := ListView {
            vertical-stretch: 1;
            changed content-y => { Gifs.sticker-scrolled(floor(-self.content-y / 88px)); }
            for row[i] in ceil(Gifs.sticker-tiles.length / 4): HorizontalLayout {
                height: 88px;
                spacing: Theme.space-2;
                padding-bottom: Theme.space-2;
                for j in 4: Rectangle {
                    width: 80px;
                    border-radius: Theme.radius-sm;
                    background: i * 4 + j < Gifs.sticker-tiles.length ? Theme.surface-highest : transparent;
                    property <StickerTileItem> tile: Gifs.sticker-tiles[i * 4 + j];
                    if i * 4 + j < Gifs.sticker-tiles.length && tile.has-image: Image {
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        source: tile.image;
                        image-fit: contain;
                        opacity: tile.enabled ? 1 : 0.35;
                    }
                    if i * 4 + j < Gifs.sticker-tiles.length: sticker-touch := TouchArea {
                        mouse-cursor: tile.enabled ? pointer : default;
                        enabled: tile.enabled;
                        clicked => { Gifs.sticker-picked(i * 4 + j); }
                    }
                    if i * 4 + j < Gifs.sticker-tiles.length && sticker-hover.has-hover && tile.enabled: Rectangle {
                        border-radius: Theme.radius-sm;
                        border-width: 2px;
                        border-color: Theme.primary;
                    }
                    sticker-hover := TouchArea { enabled: false; }
                }
            }
        }
        if Gifs.tab == 0: search := TextField {
            placeholder: "Search for GIFs...";
            autofocus: true;
            text: Gifs.query == "trending" ? "" : Gifs.query;
            edited(t) => { Gifs.search(t); }
        }
        if Gifs.tab == 0 && Gifs.status != "": Text {
            text: Gifs.status;
            color: Theme.on-surface-variant;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if Gifs.tab == 0: list := ListView {
            vertical-stretch: 1;
            // Not `scrolled`: it doesn't fire for the mouse wheel.
            changed content-y => { Gifs.scrolled(
                floor(-self.content-y / 120px),
                -self.content-y + self.visible-height > self.content-height - 360px); }
            init => { Gifs.scrolled(
                floor(-self.content-y / 120px),
                -self.content-y + self.visible-height > self.content-height - 360px); }
            for row[i] in ceil(Gifs.tiles.length / 2): HorizontalLayout {
                height: 120px;
                spacing: Theme.space-3;
                padding-bottom: Theme.space-3;
                for j in 2: Rectangle {
                    width: 168px;
                    border-radius: Theme.radius-sm;
                    clip: true;
                    background: i * 2 + j < Gifs.tiles.length ? Theme.surface-highest : transparent;
                    property <GifTileItem> tile: Gifs.tiles[i * 2 + j];
                    if i * 2 + j < Gifs.tiles.length && tile.has-image: Image {
                        width: parent.width;
                        height: parent.height;
                        source: tile.anim >= 0 ? Anim.frames[tile.anim] : tile.image;
                        image-fit: cover;
                    }
                    if i * 2 + j < Gifs.tiles.length && tile.title != "": Rectangle {
                        background: Theme.scrim-half;
                        Text {
                            text: tile.title;
                            color: Theme.on-media;
                            font-weight: 600;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if i * 2 + j < Gifs.tiles.length: tile-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Gifs.picked(i * 2 + j); }
                        if tile.gif != "" && tile-touch.has-hover: GifStar {
                            x: parent.width - self.width - 6px;
                            y: 6px;
                            gif: tile.gif;
                            picture: tile.picture;
                        }
                    }
                    if i * 2 + j < Gifs.tiles.length && touch-hover.has-hover: Rectangle {
                        border-radius: Theme.radius-sm;
                        border-width: 2px;
                        border-color: Theme.primary;
                    }
                    touch-hover := TouchArea { enabled: false; }
                }
            }
        }
    }
    }
}
