        list-devices => { root.list-devices(); }
        mic-testing: root.mic-testing;
        mic-level: root.mic-level;
        mic-test(on) => { root.mic-test(on); }
    }
    if root.switcher-open && screen == Screen.main: Switcher {
        results: root.switch-results;
        search(q) => { root.switcher-search(q); }
        picked(i) => {
            root.switcher-open = false;
            root.switcher-picked(i);
        }
        close => { root.switcher-open = false; }
    }
    if root.join-server-open && screen == Screen.main: JoinServer {
        accounts: root.join-server-accounts;
        status: root.join-server-status;
        server-name: root.join-server-name;
        ready: root.join-server-ready;
        busy: root.join-server-busy;
