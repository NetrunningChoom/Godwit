export {
    Palette,
    Theme, Screen, ServerItem, RoomItem, MessageItem, AttachmentItem, ReactionItem, PersonItem, ContactItem, IdentityItem, VerifyEmojiItem, DirectoryItem, FileItem,
    CallMemberItem, CallVideoItem, NetworkItem, AccountItem, BlockItem, MemberItem, RoleItem, MutualItem, MemberRoleItem, EmojiRowItem, EmojiCellItem, SwitchItem, PinItem, ActiveItem, NotificationItem, ThreadItem
}

export component AppWindow inherits Window {
    title: "Godwit";
    // A godwit silhouette from a public-domain USFWS photo (assets/icon/LICENSE.txt).
    icon: @image-url("../../../assets/icon/icon-256.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    // Never so narrow that something is cut off: the rail, the sidebar as
    // wide as it's dragged, and the narrowest whole chat.
    min-width: max(640px, Theme.rail-width + root.sidebar-w + Theme.chat-min-width);
    min-height: 400px;
        // The window and rail sit on surface-high, as officially.
    background: Theme.surface-high;
    default-font-family: "Inter";
    default-font-size: Theme.text-body;

    in property <Screen> screen: Screen.connecting;
    // Adding an account.
    in property <[NetworkItem]> networks;
    in property <int> login-network: -1;
    // A page to open while signing in (Teams' device sign-in), or empty.
    in property <string> login-link;
    callback login-open-link(string);
    callback login-copy(string);
    in property <bool> login-busy;
    in property <string> login-error;
    // A failed outgoing message stays visible long enough to read, then clears.
    in property <string> send-error;
    callback dismiss-send-error();
    in property <bool> login-can-cancel;
    in property <image> login-qr;
    in property <bool> login-has-qr;
    in property <bool> login-qr-scanned;
    in property <string> login-mfa-hint;
    // Us.
    in property <string> account-name;
    in property <string> account-username;
    in property <string> account-network;
    in property <string> account-initials;
    in property <image> account-avatar;
    in property <bool> account-has-avatar;

    in property <[ServerItem]> servers;
    in property <bool> home-selected: true;
    in property <bool> server-settings-available;
    in property <bool> server-settings-open;
    // A server channel's settings (see channel-settings.slint).
    in property <bool> channel-settings-open;
    in property <bool> channel-edit-loaded;
    in property <bool> channel-edit-busy;
    in property <bool> channel-edit-allowed;
    in property <bool> channel-edit-dirty;
    in property <bool> channel-edit-failed;
    in property <string> channel-edit-status;
    in property <string> channel-edit-title;
    in-out property <string> channel-edit-name;
    in-out property <string> channel-edit-description;
    in-out property <bool> channel-edit-mature;
    in property <image> channel-edit-icon;
    in property <bool> channel-edit-has-icon;
    in property <string> channel-edit-icon-label;
    in property <bool> channel-edit-has-icons;
    in property <bool> channel-edit-is-category;
    in property <bool> channel-edit-has-slowmode;
    in property <[string]> channel-edit-slowmode-choices;
    in-out property <int> channel-edit-slowmode-index;
    in property <string> channel-edit-description-hint;
    in property <int> channel-edit-page;
    in property <bool> channel-edit-has-overrides;
    in property <[AdminRoleItem]> channel-edit-override-entries;
    in property <int> channel-edit-override-index;
    in property <[OverridePermItem]> channel-edit-override-perms;
    in property <bool> channel-edit-override-can-edit;
    in property <bool> channel-edit-override-dirty;
    in property <bool> channel-edit-override-removable;
    in property <[string]> channel-edit-override-choices;
    in-out property <int> channel-edit-override-choice-index;
    callback show-channel-edit-page(int); callback select-channel-override(int);
    callback set-channel-override-permission(int, int); callback save-channel-override();
    callback remove-channel-override(); callback add-channel-override(int);
    callback close-channel-settings(); callback save-channel-overview(); callback reset-channel-overview(); callback channel-overview-edited();
    callback pick-channel-image(); callback remove-channel-image(); callback delete-channel();
    in property <bool> server-edit-loaded;
    in property <bool> server-edit-busy;
    in property <bool> server-edit-allowed;
    in property <bool> server-edit-dirty;
    in property <bool> server-edit-failed;
    in property <string> server-edit-status;
    in-out property <string> server-edit-name;
    in-out property <string> server-edit-description;
    in property <image> server-edit-icon;
    in property <bool> server-edit-has-icon;
    in property <string> server-edit-icon-label;
    in property <image> server-edit-banner;
    in property <bool> server-edit-has-banner;
    in property <string> server-edit-banner-label;
    in property <[string]> server-edit-channels;
    in-out property <int> server-edit-joined;
    in-out property <int> server-edit-left;
    in-out property <int> server-edit-kicked;
    in-out property <int> server-edit-banned;
    callback open-server-settings(); callback close-server-settings();
    callback save-server-overview(); callback reset-server-overview(); callback reload-server-overview(); callback server-overview-edited();
    callback pick-server-image(bool); callback remove-server-image(bool);
    // Server settings' other pages (see server-settings.slint).
    in property <string> server-edit-server-name;
    in property <int> server-edit-page;
    in property <bool> server-edit-show-roles;
    in property <bool> server-edit-show-emoji;
    in property <bool> server-edit-show-invites;
    in property <bool> server-edit-show-bans;
    in property <bool> server-edit-can-delete;
    in property <bool> server-edit-admin-busy;
    in property <string> server-edit-notice;
    in property <bool> server-edit-notice-failed;
    in property <[ServerInviteItem]> server-edit-invites;
    in property <bool> server-edit-invites-loaded;
    in property <[BanItem]> server-edit-bans;
    in property <bool> server-edit-bans-loaded;
    in property <[EmojiItem]> server-edit-emoji;
    in property <bool> server-edit-emoji-loaded;
    in-out property <string> server-edit-emoji-new-name;
    in property <string> server-edit-emoji-new-error;
    in property <string> server-edit-emoji-file-label;
    in property <string> server-edit-emoji-slots;
    in property <bool> server-edit-emoji-can-create;
    callback pick-server-emoji-file(); callback server-emoji-name-edited(); callback create-server-emoji();
    callback rename-server-emoji(int, string); callback delete-server-emoji(int);
    in property <[AdminRoleItem]> server-edit-roles;
    in property <bool> server-edit-roles-loaded;
    in property <bool> server-edit-roles-reorderable;
    in property <int> server-edit-role-index;
    in-out property <string> server-edit-role-name;
    in-out property <string> server-edit-role-colour;
    in-out property <bool> server-edit-role-hoist;
    in property <[PermissionItem]> server-edit-permissions;
    in property <bool> server-edit-role-dirty;
    callback server-settings-page(int);
    callback delete-server-invite(int); callback copy-server-invite(int);
    callback unban-server-user(int);
    callback select-server-role(int); callback create-server-role(string); callback server-role-edited();
    callback toggle-server-permission(int); callback save-server-role(); callback delete-server-role();
    callback move-server-role(bool);
    callback delete-server();
    // The profile card's Kick / Ban (ban: true), with the ban's reason.
    in property <bool> card-can-kick;
    in property <bool> card-can-ban;
    in property <bool> card-ban-history;
    in property <bool> card-can-roles;
    in property <bool> card-can-timeout;
    in property <bool> card-timed-out;
    in property <bool> card-can-nickname;
    in property <string> card-nickname;
    in property <[MemberRoleItem]> card-member-roles;
    in property <[string]> timeout-choices;
    in property <[string]> ban-delete-choices;
    in-out property <bool> roles-open;
    in-out property <bool> timeout-open;
    in-out property <bool> nickname-open;
    in-out property <int> timeout-index: 3;
    in-out property <int> ban-delete-index: 0;
    in-out property <string> nickname-text;
    callback toggle-member-role(int, bool);
    callback timeout-member(int);
    callback remove-member-timeout();
    callback set-member-nickname(string);
    in property <bool> card-can-remove-group-member;
    in property <bool> card-can-transfer-group-ownership;
    in property <bool> card-can-block;
    in property <bool> card-blocked;
    in property <bool> card-can-report;
    in property <bool> card-can-note;
    in-out property <string> card-note;
    // The note as the network last gave it (the Rust side compares to it).
    in-out property <string> card-note-source;
    in property <[MutualItem]> card-mutual-servers;
    in property <[MutualItem]> card-mutual-friends;
    callback save-note(string);
    callback note-edited(string);
    callback open-mutual-server(int);
    callback open-mutual-friend(int);
    // Kept on the window and exposed for generated off-screen scenes.
    in-out property <int> confirm-moderate: 0;
    in-out property <string> ban-reason;
    callback moderate-member(bool, string, int);
    in-out property <bool> confirm-remove-group-member: false;
    callback remove-group-member();
    in-out property <bool> confirm-transfer-group-ownership: false;
    callback transfer-group-ownership();
    in-out property <bool> confirm-block-user: false;
    callback block-user();
    callback unblock-user();
    // A new Discord account's one-time privacy question on first run: turn
    // off its data use and activity sharing, or keep them.
    in property <bool> discord-privacy-open;
    callback discord-privacy(bool);
    // Godwit kept an alert quiet because Steam's own app runs here: said once per account.
    // The cropper: a picked avatar, icon or banner, panned and zoomed in a
    // frame of the network's shape before it's uploaded.
    in property <bool> crop-open;
    in property <string> crop-title;
    in property <string> crop-note;
    in property <string> crop-error;
    in property <image> crop-image;
    in property <int> crop-image-width;
    in property <int> crop-image-height;
    in property <float> crop-frame-width;
    in property <float> crop-frame-height;
    in property <bool> crop-round;
    in-out property <float> crop-zoom: 1;
    in-out property <float> crop-pan-x;
    in-out property <float> crop-pan-y;
    // true: upload the file as picked (an animated GIF stays animated).
    callback crop-done(bool);
    callback crop-cancel();
    // The image viewer (Yapfast's ImageViewer): an attachment shown large.
    in property <bool> viewer-open;
    in property <image> viewer-image;
    in property <int> viewer-width;
    in property <int> viewer-height;
    in property <string> viewer-name;
    // "2 / 3", or empty for a message's only picture.
    in property <string> viewer-position;
    // While the picture loads.
    in property <string> viewer-note;
    // A web picture: it can open in the browser too.
    in property <bool> viewer-web;
    // An animated picture's frame slot (Anim.frames), or -1.
    in property <int> viewer-anim: -1;
    // A looping-video GIF's slot in Players.frames, or -1.
    in property <int> viewer-player: -1;
    // Zoom (1: fitted, up to 8) and how far the zoomed picture is dragged.
    in-out property <float> viewer-zoom: 1;
    in-out property <float> viewer-pan-x;
    in-out property <float> viewer-pan-y;
    callback close-image();
    callback step-image(int);
    // true: open in the browser; false: save to Downloads.
    callback save-image(bool);
    // A call ringing us: who, and how ("Calling you on Steam").
    in property <bool> incoming-call-open;
    in property <string> incoming-call-name;
    in property <string> incoming-call-body;
    in property <image> incoming-call-avatar;
    in property <bool> incoming-call-has-avatar;
    // We're in another call: answering leaves it.
    in property <bool> incoming-call-switches;
    in property <string> incoming-call-initials;
    // 0: dismissed (hide, stop ringing), 1: accept, 2: decline.
    callback incoming-call(int);
    in property <bool> quiet-notice-open;
    // Godwit stopped mid-call last time: offer to rejoin that call.
    in property <bool> rejoin-open;
    in property <string> rejoin-room;
    callback rejoin-call(bool);
    // A link waiting for "Open in browser?" (empty: none).
    in-out property <string> confirm-link;
    callback open-confirmed-link();
    // Adding Godwit to the system's apps (install.rs).
    in-out property <bool> install-offer;
    in-out property <bool> install-note;
    in property <bool> install-supported;
    in property <bool> app-installed;
    in property <string> install-status;
    callback install-app();
    callback install-later();
    callback uninstall-app();
    // A newer release offered (empty: none), and how its download goes.
    in-out property <string> update-version;
    in property <string> update-status;
    in-out property <float> update-progress: -1;
    callback update-now();
    in property <string> quiet-notice-account;
    callback quiet-notice(bool);
    // The server menu and its dialogs.
    in property <bool> server-menu;
    in property <bool> server-can-invite;
    in property <bool> server-notify-levels;
    in property <int> server-notify;
    callback server-menu-notify(int);
    in property <bool> server-can-create-channel;
    in property <bool> server-can-create-category;
    in property <bool> server-can-reorder;
    in property <bool> server-can-leave;
    in property <bool> server-can-report;
    callback report-server();
    callback report-profile();
    callback report-message(int);
    // The report dialog (see ManagementDialogs).
    in-out property <bool> report-open;
    in property <string> report-title;
    in property <[string]> report-reasons;
    in-out property <int> report-reason: -1;
    in-out property <string> report-detail;
    in property <int> report-status;
    in property <string> report-notice;
    // A network that declines reports: its explanation, link labels (open-report-link(i)).
    in property <string> report-unavailable;
    in property <[string]> report-links;
    callback open-report-link(int);
    // Label of the button that opens the account's privacy overview ("" = none).
    in property <string> report-privacy-label;
    in property <string> report-caveat;
    callback open-privacy-overview();
    callback submit-report(int, string);
    callback close-report();
    // The Invite dialog: open, and its link once made ("" while it's made).
    in property <bool> invite-open;
    in property <string> invite-link;
    in-out property <bool> creating-channel;
    in-out property <string> new-channel-name;
    in-out property <int> new-channel-kind;
    // A category's "Create channel here" (set from Rust with the dialog).
    in-out property <string> new-channel-category;
    in-out property <string> new-channel-category-name;
    in-out property <bool> confirm-leave;
    // Signing out asks first: it ends the sign-in at the network (Discord and
    // Steam need a new QR code after). -2 none, -1 the current account, else
    // the Settings row.
    in-out property <int> confirm-log-out: -2;
    callback server-menu-invite();
    callback server-menu-mark-read();
    callback server-menu-create-channel(string, int, string);
    // A category heading's "Create channel" (its row).
    callback create-channel-in(int);
    callback server-menu-leave();
    callback copy-invite-link();
    callback close-invite-link();
    in property <string> sidebar-title;
    in property <image> sidebar-banner;
    in property <bool> sidebar-has-banner;
    in property <[RoomItem]> rooms;

    in property <bool> has-room;
    in property <[DirectoryItem]> directory;
    in property <string> room-title;
    // The open room's account, with several accounts ("" with one).
    in property <string> room-account;
    // A merged person's networks, for switching in their chat's header.
    in property <[TalkOnItem]> room-talk-on;
    in property <[string]> room-talk-on-labels;
    in property <int> room-talk-on-current;
    callback talk-on(int);
    // The open chat is a person's: they can be given a nickname.
    in property <bool> room-can-rename;
    in property <string> room-nickname;
    callback rename-person(string);
    // People's "Reset nickname" on row `int`.
    callback reset-nickname(int);
    callback favourite-person(int);
    // The open room is an invite from this person ("" when it isn't).
    in property <string> invite-from;
    in property <bool> room-is-channel;
    in property <bool> room-encrypted;
    in property <string> room-security;
    in property <[MessageItem]> messages;
    in property <bool> loading-history;
    in property <bool> reached-start;
    in property <bool> detached;
    callback jump-to-present();
    in property <bool> can-send;
    in property <bool> can-react;
    in property <bool> can-mark-unread;
    in property <bool> can-forward;
    in property <bool> can-reply;
    in property <bool> can-edit;
    in property <bool> can-delete;
    in property <bool> can-delete-others;
    in property <bool> can-moderate-reactions;
    in property <string> compose-label;
    in property <string> typing;
    in property <bool> can-attach;
    in property <[FileItem]> files;
    in property <bool> showing-friends;
    in property <bool> showing-people;
    in property <bool> showing-active;
    in property <bool> showing-notifications;
    in property <int> notifications-unseen;
    in property <[NotificationItem]> notification-items;
    in property <bool> showing-threads;
    in property <bool> can-show-threads;
    in property <[ThreadItem]> thread-items;
    callback show-threads();
    callback overview-thread-open(int);
    callback threads-load-more();
    in property <bool> self-muted;
    in property <bool> self-deafened;
    in property <[ActiveItem]> active-items;
    in property <[ContactItem]> people;
    in property <[MergeItem]> merges;
    // Friends, People or Active now is open in place of a room.
    property <bool> page: root.showing-friends || root.showing-people || root.showing-active || root.showing-notifications || root.showing-games || root.showing-threads;
    in property <[PersonItem]> friends;
    in property <[GroupPersonItem]> group-people;
    in property <int> group-selected-count;
    in-out property <string> friend-account-key;
    in-out property <bool> friend-group-capable: false;
    in-out property <string> group-name;
    in property <bool> in-call;
    in property <string> call-status;
    in property <int> call-quality: -1;
    in property <int> call-latency: -1;
    // Seconds since the call connected (-1: not connected), counted on here
    // between refreshes; `call-time` shows it as 4:05 or 1:02:03.
    in-out property <int> call-elapsed: -1;
    property <string> call-time: root.call-elapsed < 0 ? "" : (root.call-elapsed >= 3600 ? Math.floor(root.call-elapsed / 3600) + ":" : "")
        + (root.call-elapsed >= 3600 && Math.mod(Math.floor(root.call-elapsed / 60), 60) < 10 ? "0" : "")
        + Math.mod(Math.floor(root.call-elapsed / 60), 60) + ":"
        + (Math.mod(root.call-elapsed, 60) < 10 ? "0" : "") + Math.mod(root.call-elapsed, 60);
    Timer {
        interval: 1s;
        running: root.call-elapsed >= 0;
        triggered => { root.call-elapsed += 1; }
    }
    // Now (Unix seconds), set on each refresh and counted on here while a
    // channel shows how long its call has been going (else nothing ticks).
    in-out property <int> clock;
    in property <bool> voice-clock;
    Timer {
        interval: 1s;
        running: root.voice-clock;
        triggered => { root.clock += 1; }
    }
    in property <bool> call-speaking;
    in property <string> call-room;
    in property <bool> call-muted;
    in property <bool> call-deafened;
    in property <bool> call-camera;
    in property <bool> call-screen-share;
    in property <bool> call-can-video;
    callback member-rows(int, int);
    in-out property <string> member-query;
    callback filter-members(string);
    callback search-members(string);
    in property <bool> call-video-network;
    in property <[CallVideoItem]> call-videos;
    callback set-camera(bool);
    // Turning the camera on asks first (`camera-confirm`); off doesn't.
    in-out property <bool> camera-confirm;
    function camera-asked(on: bool) {
        if on { root.camera-confirm = true; } else { root.set-camera(false); }
    }
    callback set-screen-share(bool);
    in property <bool> share-dialog-open;
    in property <[string]> share-qualities;
    in-out property <int> share-quality-index;
    in-out property <bool> share-remember;
    // Windows: Godwit's own screen/window list (set only there).
    in property <bool> share-pick-source;
    in property <[string]> share-screens;
    in property <[string]> share-windows;
    in-out property <int> share-source-tab;
    in-out property <int> share-source-index;
    callback confirm-screen-share();
    callback cancel-screen-share();
    in property <bool> can-call;
    in property <string> call-unavailable;
    in property <bool> has-members;
    in property <bool> has-pins;
    in property <bool> has-search;
    callback open-search();
    in property <bool> can-thread;
    in property <bool> is-forum;
    in property <[ForumPostItem]> forum-posts;
    in property <[ForumTagItem]> forum-filter-tags;
    in property <[string]> forum-sort-labels;
    in property <int> forum-sort-index;
    in property <bool> forum-loading;
    in property <bool> forum-failed;
    in property <bool> forum-has-older;
    in property <bool> forum-loading-older;
    callback forum-open-post(int);
    callback forum-toggle-tag(int);
    callback forum-set-sort(int);
    callback forum-load-older();
    in property <[ForumTagItem]> thread-tags;
    in property <bool> thread-tags-required;
