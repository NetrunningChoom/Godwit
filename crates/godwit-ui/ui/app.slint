        override-choices: root.channel-edit-override-choices; override-choice-index <=> root.channel-edit-override-choice-index;
        show-page(p) => { root.show-channel-edit-page(p); } select-override(i) => { root.select-channel-override(i); }
        set-override-permission(i, s) => { root.set-channel-override-permission(i, s); }
        save-override => { root.save-channel-override(); } remove-override => { root.remove-channel-override(); }
        add-override(i) => { root.add-channel-override(i); }
    }
    if root.profile-menu-preview: ProfileMenu {
        x: Theme.rail-width - 4px;
        // Below Home's 56 px entry (and the rail's top padding).
        y: Theme.gap-md + 56px;
        width: 220px;
        profiles: root.profiles;
    }
    if root.settings-open && screen == Screen.main: Settings {
        reset-panels => {
            root.sidebar-w = Theme.sidebar-width;
            root.members-w = Theme.sidebar-width;
            root.panels-resized(0, 0);
        }
        section <=> root.settings-section;
        account-index <=> root.settings-account;
        account-tab <=> root.settings-account-tab;
        account-profile: root.settings-account-profile;
        account-autodelete: root.settings-account-autodelete;
        open-autodelete => { root.settings-open-autodelete(); }
        account-discord: root.settings-account-discord;
        account-sessions: root.settings-account-sessions;
        account-rename-sessions: root.settings-account-rename-sessions;
        account-log-out-others: root.settings-account-log-out-others;
        account-data: true;
        data-policy-url: root.settings-data-policy-url;
        data-policy-label: root.settings-data-policy-label;
        open-policy(url) => { root.login-open-link(url); }
        overview-title: root.settings-overview-title;
        overview: root.settings-overview;
        overview-caveat: root.settings-overview-caveat;
        open-source(p, s) => { root.settings-open-source(p, s); }
        open-privacy => { root.settings-open-privacy(); }
        open-sessions => { root.settings-open-sessions(); }
        open-account(i) => { root.open-settings-account(i); }
        accounts: root.accounts;
        edit-profile-accounts : root.edit-profile-accounts;
        edit-profile-index <=> root.edit-profile-index;
        edit-profile-loaded : root.edit-profile-loaded;
        edit-profile-busy : root.edit-profile-busy;
        edit-profile-failed : root.edit-profile-failed;
        edit-profile-status : root.edit-profile-status;
        edit-profile-name <=> root.edit-profile-name;
        edit-profile-pronouns <=> root.edit-profile-pronouns;
        edit-profile-bio <=> root.edit-profile-bio;
        edit-profile-avatar : root.edit-profile-avatar;
        edit-profile-has-avatar : root.edit-profile-has-avatar;
        edit-profile-avatar-label : root.edit-profile-avatar-label;
        edit-profile-banner : root.edit-profile-banner;
