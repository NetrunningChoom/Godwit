    if screen == Screen.login || screen == Screen.mfa: Login {
        networks: root.networks;
        network: root.login-network;
        mfa: root.screen == Screen.mfa;
        busy: root.login-busy;
        error: root.login-error;
        can-cancel: root.login-can-cancel;
        qr: root.login-qr;
        has-qr: root.login-has-qr;
        qr-scanned: root.login-qr-scanned;
        mfa-hint: root.login-mfa-hint;
        link: root.login-link;
        open-link(url) => { root.login-open-link(url); }
        copy(text) => { root.login-copy(text); }
        pick-network(i) => { root.pick-network(i); }
        back => { root.login-back(); }
        log-in(s, u, p) => { root.log-in(s, u, p); }
        submit-mfa(c) => { root.submit-mfa(c); }
    }
    // A profile with no accounts: calm, with a way to add one.
    if screen == Screen.empty: VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        Text {
            text: "No accounts in this profile";
            horizontal-alignment: center;
            font-size: Theme.text-title;
            font-weight: 600;
            color: Theme.on-surface;
        }
        HorizontalLayout {
            alignment: center;
            Button { text: "Add an account"; clicked => { root.add-account(); } }
        }
        // Another profile may have accounts: one click (and a confirmation) away.
        if root.profiles.length > 1: Text {
            text: "Or use another profile";
            horizontal-alignment: center;
            color: Theme.on-surface-variant;
        }
        if root.profiles.length > 1: HorizontalLayout {
            alignment: center;
            spacing: Theme.space-2;
            for p[i] in root.profiles: HorizontalLayout {
                if !p.current: Button {
                    text: "Switch to " + p.name;
                    kind: "tonal";
                    clicked => { root.switch-profile(i); }
                }
            }
        }
    }
    if screen == Screen.connecting: VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        Text {
            text: "Godwit";
            horizontal-alignment: center;
            font-size: Theme.text-display;
            font-weight: 600;
            color: Theme.on-surface;
        }
        Text {
            text: "Connecting to your accounts…";
            horizontal-alignment: center;
            color: Theme.on-surface-variant;
        }
        // A fresh sign-in that never finishes connecting: a way out.
        if root.login-network >= 0: HorizontalLayout {
            alignment: center;
            Button { text: "Cancel"; kind: "text"; clicked => { root.login-back(); } }
        }
    }
    // Shortcuts anywhere in the main view (keys nothing inside used).
    if screen == Screen.main: FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.modifiers.control && (e.text == "f" || e.text == "F") && root.has-search {
                root.open-search();
                return accept;
            }
            if e.modifiers.control && (e.text == "k" || e.text == "K") {
                root.switcher-open = true;
                root.switcher-search("");
                return accept;
            }
            if e.text == Key.Escape && root.people-linking >= 0 {
                root.people-linking = -1;
                return accept;
            }
            if e.modifiers.alt && e.text == Key.UpArrow {
                root.adjacent-room(-1);
                return accept;
            }
            if e.modifiers.alt && e.text == Key.DownArrow {
                root.adjacent-room(1);
                return accept;
            }
            reject
        }
        HorizontalLayout {
            Rail {
                servers: root.servers;
                home-selected: root.home-selected;
                // The account's profile, for that account (the popup and
                // presence act on it): opened, or closed when open on it.
                toggle-account(i) => { root.toggle-account(i); }
                toggle-folder(i) => { root.toggle-folder(i); }
                move-server(i, d) => { root.move-server(i, d); }
                move-server-by(i, d) => { root.move-server-by(i, d); }
                move-account-by(i, d) => { root.move-account-by(i, d); }
                menu-can-invite: root.server-can-invite;
                menu-settings: root.server-settings-available;
                menu-can-leave: root.server-can-leave;
                menu-can-report: root.server-can-report;
                server-report => { root.report-server(); }
                server-invite => { root.server-menu-invite(); }
                server-mark-read => { root.server-menu-mark-read(); }
                server-settings => { root.open-server-settings(); }
                server-leave => { root.confirm-leave = true; }
                open-account(i) => {
                    root.profile-open = !root.profile-open || root.focus-account != i;
                    root.focus-account = i;
                    root.open-account(i);
                }
                select-home => { root.select-home(); }
                profile-name: root.profile-name;
                profile-initial: root.profile-initial;
                profiles: root.profiles;
                switch-profile(i) => { root.switch-profile(i); }
                manage-profiles => {
                    root.settings-section = 11;
                    root.settings-open = true;
                    root.settings-opened();
                }
                select-server(i) => { root.select-server(i); }
                join-server => { root.open-join-server(); }
            }
            // Everything right of the rail: a surface-low sheet with a rounded
            // top-left corner, 8 px below the top.
            VerticalLayout {
                padding-top: Theme.gap-md;
                Rectangle {
                    background: Theme.surface-low;
                    border-top-left-radius: Theme.radius-lg;
                    HorizontalLayout {
                        Sidebar {
                            panel-width: root.sidebar-w;
                            title: root.sidebar-title;
                            banner: root.sidebar-banner;
                            has-banner: root.sidebar-has-banner;
                            server-settings-available: root.server-settings-available;
                            open-server-settings => { root.open-server-settings(); }
                            server-menu: root.server-menu;
                            room-menu(i, a) => { root.room-menu(i, a); }
                            home-query <=> root.home-query;
                            search-home(t) => { root.search-home(t); }
                            home-networks: root.home-networks;
                            home-network: root.home-network;
                            filter-home(n) => { root.filter-home(n); }
                            toggle-hidden-rooms => { root.toggle-hidden-rooms(); }
                            toggle-category(i) => { root.toggle-category(i); }
                            can-invite: root.server-can-invite;
                            notify-levels: root.server-notify-levels;
                            notify: root.server-notify;
                            set-notify(level) => { root.server-menu-notify(level); }
                            can-create-channel: root.server-can-create-channel;
                            can-leave: root.server-can-leave;
                            can-report: root.server-can-report;
                            report-server => { root.report-server(); }
                            invite-people => { root.server-menu-invite(); }
                            mark-server-read => { root.server-menu-mark-read(); }
                            create-channel => { root.new-channel-name = ""; root.new-channel-kind = 0; root.new-channel-category = ""; root.new-channel-category-name = ""; root.creating-channel = true; }
                            create-channel-in(i) => { root.new-channel-name = ""; root.new-channel-kind = 0; root.create-channel-in(i); }
                            leave-server => { root.confirm-leave = true; }
                            rooms: root.rooms;
                            directory: root.directory;
                            join-room(i) => { root.join-room(i); }
                            account-name: root.account-name;
                            account-avatar: root.account-avatar;
                            account-has-presence: root.account-has-presence;
                            account-presence: root.account-presence;
                            account-has-avatar: root.account-has-avatar;
                            account-initials: root.account-initials;
                            home: root.home-selected;
                            friends-selected: root.showing-friends;
                            show-friends => { root.show-friends(); }
                            people-selected: root.showing-people;
                            show-people => { root.show-people(); }
                            can-show-threads: root.can-show-threads;
                            threads-selected: root.showing-threads;
                            show-threads => { root.show-threads(); }
                            active-selected: root.showing-active;
                            show-active => { root.show-active(); }
                            notifications-selected: root.showing-notifications;
                            notifications-unseen: root.notifications-unseen;
                            show-notifications => { root.show-notifications(); }
                            can-show-games: root.can-show-games;
                            games-selected: root.showing-games;
                            show-games => { root.show-games(); }
                            in-call: root.in-call;
                            call-status: root.call-status;
                            call-quality: root.call-quality;
                            call-latency: root.call-latency;
                            call-time: root.call-time;
                            call-can-video: root.call-can-video;
                            call-video-network: root.call-video-network;
                            call-screen-share: root.call-screen-share;
                            call-camera: root.call-camera;
                            set-camera(active) => { root.camera-asked(active); }
                            set-screen-share(active) => { root.set-screen-share(active); }
                            call-speaking: root.call-speaking;
                            call-room: root.call-room;
                            call-muted: root.call-muted;
                            call-deafened: root.call-deafened;
                            clock: root.clock;
                            self-muted: root.self-muted;
                            self-deafened: root.self-deafened;
                            open-call-room => { root.open-call-room(); }
                            toggle-mute => { root.toggle-mute(); }
                            toggle-deafen => { root.toggle-deafen(); }
