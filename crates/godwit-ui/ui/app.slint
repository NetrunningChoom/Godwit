        reset => { root.reset-join-server(); }
        inspect(i, text) => { root.inspect-invite(i, text); }
        join => { root.accept-server-invite(); }
    }
    CallDialogs {
        screen: root.screen;
        discord-privacy-open: root.discord-privacy-open;
        discord-privacy(on) => { root.discord-privacy(on); }
        quiet-notice-open: root.quiet-notice-open;
        incoming-call-open: root.incoming-call-open;
        quiet-notice-account: root.quiet-notice-account;
        quiet-notice(on) => { root.quiet-notice(on); }
        camera-confirm <=> root.camera-confirm;
        in-call: root.in-call;
        call-room: root.call-room;
        set-camera(on) => { root.set-camera(on); }
        rejoin-open: root.rejoin-open;
        rejoin-room: root.rejoin-room;
        rejoin-call(on) => { root.rejoin-call(on); }
        confirm-link <=> root.confirm-link;
        open-confirmed-link => { root.open-confirmed-link(); }
        install-offer <=> root.install-offer;
        install-note <=> root.install-note;
        install-status: root.install-status;
        install-app => { root.install-app(); }
        install-later => { root.install-later(); }
        update-version <=> root.update-version;
        update-status: root.update-status;
        update-progress <=> root.update-progress;
        update-now => { root.update-now(); }
    }
    // A call video filling the window: double-click or Esc comes back.
    if root.fullscreen-video >= 0 && root.fullscreen-video < root.call-videos.length && screen == Screen.main: FullscreenVideo {
        call-deafened: root.call-deafened;
        call-camera: root.call-camera;
        call-can-video: root.call-can-video;
        call-screen-share: root.call-screen-share;
        call-members: root.call-members;
        call-muted: root.call-muted;
        call-speaking: root.call-speaking;
        call-streams: root.call-streams;
        call-time: root.call-time;
        call-videos: root.call-videos;
        fullscreen-video: root.fullscreen-video;
        stream-sound(a0, a1, a2, a3) => { root.stream-sound(a0, a1, a2, a3); }
        set-camera(on) => { root.camera-asked(on); }
        set-screen-share(on) => { root.set-screen-share(on); }
        toggle-deafen() => { root.toggle-deafen(); }
        toggle-mute() => { root.toggle-mute(); }
        leave-call() => { root.leave-call(); }
        video-fullscreen(a0) => { root.video-fullscreen(a0); }
    }
    // While browsing another room, keep a live call video in a draggable
    // corner so the text channel and the call remain visible together.
    CallPip {
        shown: root.in-call && !root.call-here && screen == Screen.main;
        videos: root.call-videos;
        left-bound: Theme.rail-width + root.sidebar-w + 8px;
        right-edge: root.wide && root.members-shown && root.has-members && root.has-room && !root.page
            ? root.width - root.members-w - 8px : root.width - 8px;
        bottom-edge: root.height;
        open-call => { root.open-call-room(); }
    }
    if root.viewer-open && screen == Screen.main: ImageViewer {
        close-image() => { root.close-image(); }
        save-image(a0) => { root.save-image(a0); }
        step-image(a0) => { root.step-image(a0); }
        viewer-anim: root.viewer-anim;
        viewer-height: root.viewer-height;
        viewer-image: root.viewer-image;
        viewer-name: root.viewer-name;
        viewer-note: root.viewer-note;
        viewer-pan-x <=> root.viewer-pan-x;
        viewer-pan-y <=> root.viewer-pan-y;
        viewer-player: root.viewer-player;
        viewer-position: root.viewer-position;
        viewer-web: root.viewer-web;
        viewer-width: root.viewer-width;
        viewer-zoom <=> root.viewer-zoom;
    }
    if root.poll-open && screen == Screen.main: PollDialog {
        answers: root.poll-answers;
        durations: root.poll-durations;
        duration <=> root.poll-duration;
        multi <=> root.poll-multi;
        can-add: root.poll-can-add;
        can-post: root.poll-can-post;
        hint: root.poll-hint;
        poll-open <=> root.poll-open;
        question-edited(q) => { root.poll-question(q); }
        answer-edited(i, t) => { root.poll-answer(i, t); }
        add-answer => { root.poll-add-answer(); }
        remove-answer(i) => { root.poll-remove-answer(i); }
        post => { root.poll-post(root.poll-duration, root.poll-multi); }
    }
    if root.forward-open && screen == Screen.main: ForwardDialog {
        results: root.forward-results;
        forward-open <=> root.forward-open;
        forward-search(q) => { root.forward-search(q); }
        forward-send(i, note) => {
            root.forward-open = false;
            root.forward-send(i, note);
        }
    }
    if root.thread-open && screen == Screen.main: ThreadDialog {
        thread-confirm() => { root.thread-confirm(); }
        thread-name <=> root.thread-name;
        thread-open <=> root.thread-open;
        thread-post: root.thread-post;
        thread-text <=> root.thread-text;
        thread-tags: root.thread-tags;
        thread-tags-required: root.thread-tags-required;
        thread-tags-missing: root.thread-tags-missing;
        thread-toggle-tag(i) => { root.thread-toggle-tag(i); }
    }
    if root.search-open && screen == Screen.main: SearchDialog {
        close-search() => { root.close-search(); }
        search(a0) => { root.search(a0); }
        search-asked: root.search-asked;
        search-busy: root.search-busy;
        search-failed: root.search-failed;
        search-jump(a0) => { root.search-jump(a0); }
        search-results: root.search-results;
        search-hint: root.search-hint;
        search-notice: root.search-notice;
        search-total: root.search-total;
        search-can-scope: root.search-can-scope;
        search-scope-server: root.search-scope-server;
        search-more: root.search-more;
        search-loading-more: root.search-loading-more;
        search-scope(a0) => { root.search-scope(a0); }
        load-more-results() => { root.load-more-results(); }
    }
    if root.pins-open && screen == Screen.main: PinsDialog {
        can-pin: root.can-pin;
        close-pins() => { root.close-pins(); }
        pin-jump(a0) => { root.pin-jump(a0); }
        pin-unpin(a0) => { root.pin-unpin(a0); }
        pins: root.pins;
        pins-failed: root.pins-failed;
        pins-loading: root.pins-loading;
    }
    if root.confirm-pin >= 0 && screen == Screen.main: ConfirmDialog {
        title: root.confirm-pin-value ? "Pin message" : "Unpin message";
        message: root.confirm-pin-value
            ? "Pin this message so it stays easy to find?"
            : "Remove this message from the pinned list?";
        confirm-text: root.confirm-pin-value ? "Pin" : "Unpin";
        confirm-kind: "filled";
        cancelled => { root.confirm-pin = -1; }
        confirmed => {
            root.pin(root.confirm-pin, root.confirm-pin-value);
            root.confirm-pin = -1;
        }
    }
    if root.crop-open && screen == Screen.main: Cropper {
        crop-cancel() => { root.crop-cancel(); }
        crop-done(a0) => { root.crop-done(a0); }
        crop-error: root.crop-error;
        crop-frame-height: root.crop-frame-height;
        crop-frame-width: root.crop-frame-width;
        crop-image: root.crop-image;
        crop-image-height: root.crop-image-height;
        crop-image-width: root.crop-image-width;
        crop-note: root.crop-note;
        crop-pan-x <=> root.crop-pan-x;
        crop-pan-y <=> root.crop-pan-y;
        crop-round: root.crop-round;
        crop-title: root.crop-title;
        crop-zoom <=> root.crop-zoom;
    }
    // A call ringing us: who, from where, and Decline / Accept. The backdrop
    // only hides it (the call can still be joined from the chat).
    if root.incoming-call-open && screen == Screen.main: IncomingCall {
        incoming-call(a0) => { root.incoming-call(a0); }
        incoming-call-avatar: root.incoming-call-avatar;
        incoming-call-body: root.incoming-call-body;
        incoming-call-has-avatar: root.incoming-call-has-avatar;
        incoming-call-initials: root.incoming-call-initials;
        incoming-call-name: root.incoming-call-name;
        incoming-call-switches: root.incoming-call-switches;
    }
    ManagementDialogs {
        invite-open: root.invite-open;
        invite-link: root.invite-link;
        close-invite-link => { root.close-invite-link(); }
        copy-invite-link => { root.copy-invite-link(); }
        creating-channel <=> root.creating-channel;
        new-channel-name <=> root.new-channel-name;
        new-channel-kind <=> root.new-channel-kind;
        new-channel-category: root.new-channel-category;
        new-channel-category-name: root.new-channel-category-name;
        can-create-category: root.server-can-create-category;
        server-menu-create-channel(name, kind, category) => { root.server-menu-create-channel(name, kind, category); }
        confirm-log-out <=> root.confirm-log-out;
        log-out => { root.log-out(); }
        log-out-account(i) => { root.log-out-account(i); }
        confirm-leave <=> root.confirm-leave;
        profile-switch-open <=> root.profile-switch-open;
        profile-switch-name: root.profile-switch-name;
        profile-switch-note: root.profile-switch-note;
        confirm-profile-switch => { root.confirm-profile-switch(); }
        cancel-profile-switch => { root.cancel-profile-switch(); }
        sidebar-title: root.sidebar-title;
        server-menu-leave => { root.server-menu-leave(); }
        confirm-moderate <=> root.confirm-moderate;
        card-name: root.card-name;
        ban-reason <=> root.ban-reason;
        ban-delete-choices: root.ban-delete-choices;
        ban-history: root.card-ban-history;
        ban-delete-index <=> root.ban-delete-index;
        moderate-member(ban, reason, delete) => { root.moderate-member(ban, reason, delete); }
        card-member-roles: root.card-member-roles;
        timeout-choices: root.timeout-choices;
        roles-open <=> root.roles-open;
        timeout-open <=> root.timeout-open;
        nickname-open <=> root.nickname-open;
        timeout-index <=> root.timeout-index;
        nickname-text <=> root.nickname-text;
        toggle-member-role(i, on) => { root.toggle-member-role(i, on); }
        timeout-member(i) => { root.timeout-member(i); }
        set-member-nickname(n) => { root.set-member-nickname(n); }
        confirm-remove-group-member <=> root.confirm-remove-group-member;
        remove-group-member => { root.remove-group-member(); }
        confirm-transfer-group-ownership <=> root.confirm-transfer-group-ownership;
        transfer-group-ownership => { root.transfer-group-ownership(); }
        confirm-block-user <=> root.confirm-block-user;
        block-user => { root.block-user(); }
        report-open <=> root.report-open;
        report-title: root.report-title;
        report-reasons: root.report-reasons;
        report-reason <=> root.report-reason;
        report-detail <=> root.report-detail;
        report-status: root.report-status;
        report-notice: root.report-notice;
        report-unavailable: root.report-unavailable;
        report-links: root.report-links;
        open-report-link(i) => { root.open-report-link(i); }
        report-privacy-label: root.report-privacy-label;
        report-caveat: root.report-caveat;
        open-privacy-overview => { root.open-privacy-overview(); }
        submit-report(r, d) => { root.submit-report(r, d); }
        close-report => { root.close-report(); }
        confirm-delete <=> root.confirm-delete;
        delete(i) => { root.delete(i); }
    }
    if root.send-error != "" && screen == Screen.main: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
        width: min(600px, parent.width - 32px);
        height: 56px;
        border-radius: 6px;
        background: Theme.error;
        TouchArea {
            clicked => { root.dismiss-send-error(); }
            Text {
                x: 16px;
                y: 0;
                width: parent.width - 32px;
                height: parent.height;
                text: root.send-error + "   ×";
                color: Theme.on-error;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
        Timer {
            interval: 5s;
            running: true;
            triggered => { root.dismiss-send-error(); }
        }
    }
}
