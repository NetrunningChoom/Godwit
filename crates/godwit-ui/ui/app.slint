        version: root.version;
        install-supported: root.install-supported;
        app-installed: root.app-installed;
        install-status: root.install-status;
        install-app => { root.install-app(); }
        uninstall-app => { root.uninstall-app(); }
        close => { root.mic-test(false); root.settings-open = false; }
        add-account => {
            root.settings-open = false;
            root.add-account();
        }
        log-out(i) => { root.confirm-log-out = i; }
        unlock(i, key) => { root.unlock-account(i, key); }
        start-verify(i) => { root.start-verify(i); }
        answer-verify(m) => { root.answer-verify(m); }
        accept-verify => { root.accept-verify(); }
        close-verify => { root.close-verify(); }
