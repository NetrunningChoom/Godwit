        tones: root.tones;
        tone-index <=> root.tone-index;
        echo-cancellation <=> root.echo-cancellation;
        auto-gain <=> root.auto-gain;
        dark <=> root.dark;
        accent-index <=> root.accent-index;
        style-index <=> root.style-index;
        emoji-packs: root.emoji-packs;
        emoji-pack-index <=> root.emoji-pack-index;
        scales: root.scales;
