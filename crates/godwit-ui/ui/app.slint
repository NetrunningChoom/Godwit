        pick-profile-image(v) => { root.pick-profile-image(v); }
        remove-profile-image(v) => { root.remove-profile-image(v); }

        notifications <=> root.notifications;
        sounds <=> root.sounds;
        muzzle <=> root.muzzle;
        muzzle-pauses: root.muzzle-pauses;
        muzzle-pause-index <=> root.muzzle-pause-index;
        muzzle-maxes: root.muzzle-maxes;
        muzzle-max-index <=> root.muzzle-max-index;
        dnd <=> root.dnd;
