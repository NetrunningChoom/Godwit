import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Section } from "settings.slint";
import { AdminRoleItem, BanItem, EmojiItem, PermissionItem, RoleMemberItem, ServerInviteItem, ModerationLogItem, ModerationRuleItem } from "types.slint";
import { Avatar, Button, Checkbox, ConfirmDialog, Dialog, IconButton, Select, TextArea, TextField, Toggle, TriState } from "widgets.slint";

// Server settings, as the official ServerSettings: a sidebar of pages
// (Overview, Roles, Emoji, Invites, Bans), each shown only with the permission it
// needs, and Delete Server for the owner.
export component ServerSettings inherits Rectangle {
    in property <string> server-name;
    // 0 Overview, 1 Roles, 2 Emoji, 3 Invites, 4 Bans, 5 Moderation log, 6 Stickers, 7 Sounds, 8 AutoMod.
    in property <int> page;
    in property <bool> show-roles;
    in property <bool> show-emoji;
    in property <bool> show-stickers;
    in property <bool> show-sounds;
    // 'emoji', 'sticker' or 'sound': what the shared list page (2, 6, 7) is managing.
    in property <string> expression-noun: "emoji";
    in property <string> expression-hint;
    in property <bool> show-invites;
    in property <bool> show-automod;
    in property <[ModerationRuleItem]> automod-rules;
    in property <bool> automod-loaded;
    callback set-automod-rule(int, bool); callback delete-automod-rule(int);
    in property <bool> show-bans;
    in property <bool> show-moderation-log;
    in property <bool> can-delete;
    // A page change is on its way; its buttons wait.
    in property <bool> admin-busy;
    in property <string> notice;
    in property <bool> notice-failed;

    in property <bool> loaded;
    in property <bool> busy;
    in property <bool> allowed;
    in property <bool> dirty;
    in property <bool> failed;
    in property <string> status;
    in-out property <string> name;
    in-out property <string> description;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> icon-label;
    in property <image> banner;
    in property <bool> has-banner;
    in property <string> banner-label;
    in property <[string]> channels;
    in-out property <int> joined;
    in-out property <int> left;
    in-out property <int> kicked;
    in-out property <int> banned;
    in property <bool> has-safety;
    in property <[string]> verification-options;
    in-out property <int> verification;
    in property <[string]> filter-options;
    in-out property <int> content-filter;
    in property <bool> has-mfa;
    in-out property <bool> mod-mfa;
    // Why the 2FA switch can't move; empty when it can.
    in property <string> mfa-locked;

    in property <[ServerInviteItem]> invites;
    in property <[ModerationLogItem]> moderation-log;
    in property <bool> moderation-log-loading;
    in property <bool> moderation-log-has-more;
    in property <string> moderation-log-error;
    in property <bool> invites-loaded;
    in property <[BanItem]> bans;
    in property <bool> bans-loaded;
    in property <[EmojiItem]> emoji;
    in property <bool> emoji-loaded;
    in-out property <string> emoji-new-name;
    // Why the name or picture can't be used yet (empty when fine).
    in property <string> emoji-new-error;
    in property <string> emoji-file-label;
    in property <string> emoji-slots;
    in property <bool> emoji-can-create;
    in property <[AdminRoleItem]> roles;
    in property <bool> roles-loaded;
    in property <bool> roles-reorderable;
    // The role being edited: 0 is Everyone, then the roles in order.
    in property <int> role-index;
    in-out property <string> role-name;
    in-out property <string> role-colour;
    in-out property <bool> role-hoist;
    in property <[PermissionItem]> permissions;
    in property <bool> role-dirty;
    // The selected role's Members tab: offered, showing, its people (filtered
    // in Rust), and the Add members picker.
    in property <bool> role-members-available;
    in property <bool> role-members-tab;
    in property <bool> role-members-loaded;
    in property <[RoleMemberItem]> role-members;
    in property <bool> role-picking;
    in property <[RoleMemberItem]> role-picker;
    in property <bool> role-picker-more;
    in property <int> role-picked;
    in-out property <string> role-member-search;
    in-out property <string> role-picker-search;

    callback close(); callback save(); callback reset(); callback reload(); callback changed();
    callback pick-image(bool); callback remove-image(bool);
    callback select-page(int);
    callback delete-invite(int); callback copy-invite(int);
    callback unban(int);
    callback select-role(int); callback create-role(string); callback role-edited();
    callback set-permission-state(int, int); callback save-role(); callback delete-role();
    callback move-role(bool);
    callback set-role-members-tab(bool); callback role-member-search-edited(string);
    callback open-role-picker(); callback close-role-picker(); callback role-picker-search-edited(string);
    callback toggle-role-picked(int); callback add-role-members(); callback remove-role-member(int);
    callback pick-emoji-file(); callback emoji-name-edited(); callback create-emoji();
    callback rename-emoji(int, string); callback delete-emoji(int);
    callback delete-server();
    callback load-more-moderation-log();

    property <bool> confirm-delete;
    // The emoji being renamed or deleted (-1: none).
    property <int> rename-row: -1;
    property <string> rename-text;
    property <int> delete-row: -1;
    property <string> new-role;
    background: Theme.surface-lowest;
    TouchArea { scroll-event(e) => { accept } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => { if e.text == Key.Escape { root.close(); return accept; } reject }
        HorizontalLayout {
            Rectangle {
                width: 220px;
                background: Theme.surface-low;
                VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-1; alignment: start;
                    Text { text: root.server-name; font-size: Theme.text-small; font-weight: 600; color: Theme.outline; height: 28px; overflow: elide; }
                    Section { label: "Overview"; selected: root.page == 0; clicked => { root.select-page(0); } }
                    if root.show-roles: Section { label: "Roles"; selected: root.page == 1; clicked => { root.select-page(1); } }
                    if root.show-emoji: Section { label: "Emojis"; selected: root.page == 2; clicked => { root.select-page(2); } }
                    if root.show-stickers: Section { label: "Stickers"; selected: root.page == 6; clicked => { root.select-page(6); } }
                    if root.show-sounds: Section { label: "Sounds"; selected: root.page == 7; clicked => { root.select-page(7); } }
                    if root.show-invites: Section { label: "Invites"; selected: root.page == 3; clicked => { root.select-page(3); } }
                    if root.show-bans: Section { label: "Bans"; selected: root.page == 4; clicked => { root.select-page(4); } }
                    if root.show-automod: Section { label: "AutoMod"; selected: root.page == 8; clicked => { root.select-page(8); } }
                    if root.show-moderation-log: Section { label: "Moderation log"; selected: root.page == 5; clicked => { root.select-page(5); } }
                    if root.can-delete: Rectangle { height: 12px; }
                    if root.can-delete: Section { label: "Delete Server"; danger: true; clicked => { root.confirm-delete = true; } }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding: Theme.space-5; spacing: Theme.space-4;
                    Text {
                        text: root.page == 1 ? "Roles" : root.page == 2 ? "Emojis" : root.page == 3 ? "Invites" : root.page == 4 ? "Bans" : root.page == 5 ? "Moderation log" : root.page == 6 ? "Stickers" : root.page == 7 ? "Sounds" : root.page == 8 ? "AutoMod" : "Overview";
                        font-size: Theme.text-large; font-weight: 600; color: Theme.on-surface; horizontal-stretch: 1; overflow: elide; vertical-alignment: center;
                    }
                    Button { text: "Close"; kind: "text"; clicked => { root.close(); } }
                }
                if root.notice != "" && root.page != 0: HorizontalLayout {
                    padding-left: Theme.space-5; padding-right: Theme.space-5;
                    Text { text: root.notice; wrap: word-wrap; color: root.notice-failed ? Theme.error : Theme.on-surface-variant; }
                }
                if root.page == 0: overview := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: min(overview.visible-width, 680px);
                        padding: Theme.space-7; spacing: Theme.space-4; alignment: start;
                        if root.status != "": Text { text: root.status; wrap: word-wrap; color: root.failed ? Theme.error : Theme.on-surface-variant; }
                        if root.loaded && !root.allowed: Text { text: "You need Manage Server permission to change these settings."; wrap: word-wrap; color: Theme.on-surface-variant; }
                        if root.loaded: VerticalLayout {
                            spacing: Theme.space-4;
                            Text { text: "Server icon"; color: Theme.on-surface; }
                            Avatar { size: 72px; source: root.icon; has-image: root.has-icon; initials: ""; }
                            if root.icon-label != "": Text { text: root.icon-label; wrap: word-wrap; color: Theme.on-surface-variant; }
                            HorizontalLayout {
                                alignment: start; spacing: Theme.space-3;
                                Button { text: "Change icon"; enabled: root.allowed && !root.busy; clicked => { root.pick-image(true); } }
                                Button { text: "Remove"; kind: "text"; enabled: root.allowed && !root.busy; clicked => { root.remove-image(true); } }
                            }
                            Text { text: "Server banner"; color: Theme.on-surface; }
                            // Sized and clipped: an unsized Image draws at its natural size, over the form below.
                            Rectangle { height: 120px; clip: true; background: Theme.surface-high; if root.has-banner: Image { width: parent.width; height: parent.height; source: root.banner; image-fit: cover; } }
                            if root.banner-label != "": Text { text: root.banner-label; wrap: word-wrap; color: Theme.on-surface-variant; }
                            HorizontalLayout {
                                alignment: start; spacing: Theme.space-3;
                                Button { text: "Change banner"; enabled: root.allowed && !root.busy; clicked => { root.pick-image(false); } }
                                Button { text: "Remove"; kind: "text"; enabled: root.allowed && !root.busy; clicked => { root.remove-image(false); } }
                            }
                            Text { text: "Server name"; color: Theme.on-surface; }
                            TextField { text <=> root.name; enabled: root.allowed && !root.busy; edited => { root.changed(); } accepted => { root.save(); } }
                            Text { text: "Description"; color: Theme.on-surface; }
                            TextArea { height: 120px; text <=> root.description; enabled: root.allowed && !root.busy; edited => { root.changed(); } }
                            Text { text: "System message channels"; font-weight: 600; color: Theme.on-surface; }
                            Text { text: "User joined"; color: Theme.on-surface; }
                            Select { model: root.channels; current-index <=> root.joined; enabled: root.allowed && !root.busy; selected(i) => { root.changed(); } }
                            Text { text: "User left"; color: Theme.on-surface; }
                            Select { model: root.channels; current-index <=> root.left; enabled: root.allowed && !root.busy; selected(i) => { root.changed(); } }
                            Text { text: "User kicked"; color: Theme.on-surface; }
                            Select { model: root.channels; current-index <=> root.kicked; enabled: root.allowed && !root.busy; selected(i) => { root.changed(); } }
                            Text { text: "User banned"; color: Theme.on-surface; }
                            Select { model: root.channels; current-index <=> root.banned; enabled: root.allowed && !root.busy; selected(i) => { root.changed(); } }
                            if root.has-safety: VerticalLayout {
                                spacing: Theme.space-4;
                                Text { text: "Safety"; font-weight: 600; color: Theme.on-surface; }
                                Text { text: "Verification level"; color: Theme.on-surface; }
                                Text { text: "Members must meet this before they can send messages or talk."; wrap: word-wrap; color: Theme.on-surface-variant; }
                                Select { model: root.verification-options; current-index <=> root.verification; enabled: root.allowed && !root.busy; selected(i) => { root.changed(); } }
                                Text { text: "Explicit media content filter"; color: Theme.on-surface; }
                                Text { text: "Automatically scan and delete media containing explicit content."; wrap: word-wrap; color: Theme.on-surface-variant; }
                                Select { model: root.filter-options; current-index <=> root.content-filter; enabled: root.allowed && !root.busy; selected(i) => { root.changed(); } }
                                if root.has-mfa: VerticalLayout {
                                    spacing: Theme.space-3;
                                    Text { text: "Require 2FA for moderator actions"; color: Theme.on-surface; }
                                    Text { text: "Moderators need two-factor authentication on their account to kick, ban, time out, delete messages or change server settings."; wrap: word-wrap; color: Theme.on-surface-variant; }
                                    HorizontalLayout {
                                        alignment: start;
                                        Toggle { checked: root.mod-mfa; enabled: root.allowed && !root.busy && root.mfa-locked == ""; toggled(on) => { root.mod-mfa = on; root.changed(); } }
                                    }
                                    if root.mfa-locked != "": Text { text: root.mfa-locked; wrap: word-wrap; color: Theme.on-surface-variant; }
                                }
                            }
                        }
                    }
                }
                if root.page == 0: HorizontalLayout {
                    padding: Theme.space-5; spacing: Theme.space-3; alignment: end;
                    Button { text: "Reload"; kind: "text"; enabled: !root.busy && !root.dirty; clicked => { root.reload(); } }
                    Button { text: "Reset"; enabled: root.loaded && !root.busy; clicked => { root.reset(); } }
                    Button { text: "Save"; kind: "filled"; enabled: root.loaded && root.allowed && !root.busy && root.dirty; clicked => { root.save(); } }
                }

                // Roles: the list (Everyone first) beside the selected role's editor.
                if root.page == 1: HorizontalLayout {
                    vertical-stretch: 1;
                    padding: Theme.space-5; spacing: Theme.space-5;
                    VerticalLayout {
                        width: 220px; spacing: Theme.space-3;
                        HorizontalLayout {
                            spacing: Theme.space-3;
                            TextField { placeholder: "New role"; text <=> root.new-role; enabled: !root.admin-busy; accepted => { root.create-role(root.new-role); root.new-role = ""; } }
                            Button { y: 4px; text: "Create"; kind: "text"; enabled: !root.admin-busy && root.new-role != ""; clicked => { root.create-role(root.new-role); root.new-role = ""; } }
                        }
                        if !root.roles-loaded: Text { text: "Loading roles…"; color: Theme.on-surface-variant; }
                        role-list := ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: role-list.visible-width;
                                spacing: Theme.space-1; alignment: start;
                                for role[i] in root.roles: Rectangle {
                                    height: 36px; border-radius: Theme.radius-sm;
                                    background: i == root.role-index ? Theme.primary-container : role-touch.has-hover ? Theme.surface-highest : transparent;
                                    HorizontalLayout {
                                        padding-left: Theme.space-between; spacing: Theme.space-3;
                                        Rectangle { y: (parent.height - 12px) / 2; width: 12px; height: 12px; border-radius: self.width / 2; background: role.has-colour ? role.colour : Theme.outline; }
                                        Text { text: role.name; vertical-alignment: center; overflow: elide; color: i == root.role-index ? Theme.on-primary-container : Theme.on-surface; }
                                    }
                                    role-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-role(i); } }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: Theme.space-4;
                        if root.role-members-available: HorizontalLayout {
                            spacing: Theme.space-3; alignment: start;
                            Button { text: "Settings"; kind: !root.role-members-tab ? "tonal" : "text"; clicked => { root.set-role-members-tab(false); } }
                            Button { text: "Members"; kind: root.role-members-tab ? "tonal" : "text"; clicked => { root.set-role-members-tab(true); } }
                        }
                        if root.role-members-tab: VerticalLayout {
                            vertical-stretch: 1; spacing: Theme.space-3;
                            if !root.role-members-loaded: Text { text: "Loading members…"; color: Theme.on-surface-variant; }
                            if root.role-members-loaded && !root.role-picking: HorizontalLayout {
                                spacing: Theme.space-3;
                                TextField { placeholder: "Search members"; text <=> root.role-member-search; edited(t) => { root.role-member-search-edited(t); } }
                                Button { y: 4px; text: "Add members"; kind: "filled"; enabled: !root.admin-busy; clicked => { root.open-role-picker(); } }
                            }
                            if root.role-members-loaded && !root.role-picking && root.role-members.length == 0: Text { text: "No one has this role yet."; color: Theme.outline; }
                            if root.role-members-loaded && !root.role-picking: members-scroll := ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    width: members-scroll.visible-width;
                                    spacing: Theme.space-1; alignment: start;
                                    for m[i] in root.role-members: HorizontalLayout {
                                        spacing: Theme.space-3; height: 40px;
                                        Avatar { y: 4px; size: 32px; source: m.avatar; has-image: m.has-avatar; initials: ""; }
                                        Text { text: m.name; vertical-alignment: center; overflow: elide; color: Theme.on-surface; horizontal-stretch: 1; }
                                        IconButton { y: 4px; glyph: Icons.close; tooltip: "Remove from role"; enabled: !root.admin-busy; clicked => { root.remove-role-member(i); } }
                                    }
                                }
                            }
                            if root.role-members-loaded && root.role-picking: HorizontalLayout {
                                spacing: Theme.space-3;
                                TextField { placeholder: "Search server members"; autofocus: true; text <=> root.role-picker-search; edited(t) => { root.role-picker-search-edited(t); } }
                            }
                            if root.role-members-loaded && root.role-picking && root.role-picker.length == 0: Text { text: "No members to add."; color: Theme.outline; }
                            if root.role-members-loaded && root.role-picking: picker-scroll := ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    width: picker-scroll.visible-width;
                                    spacing: Theme.space-1; alignment: start;
                                    for m[i] in root.role-picker: Rectangle {
                                        height: 40px;
                                        HorizontalLayout {
                                            spacing: Theme.space-3;
                                            Checkbox { y: 0px; checked: m.checked; toggled => { root.toggle-role-picked(i); } }
                                            Avatar { y: 4px; size: 32px; source: m.avatar; has-image: m.has-avatar; initials: ""; }
                                            Text { text: m.name; vertical-alignment: center; overflow: elide; color: Theme.on-surface; horizontal-stretch: 1; }
                                        }
                                        TouchArea { mouse-cursor: pointer; clicked => { root.toggle-role-picked(i); } }
                                    }
                                    if root.role-picker-more: Text { text: "Search to narrow the list."; font-size: Theme.text-small; color: Theme.outline; }
                                }
                            }
                            if root.role-members-loaded && root.role-picking: HorizontalLayout {
                                spacing: Theme.space-3; alignment: end;
                                Button { text: "Cancel"; kind: "text"; clicked => { root.close-role-picker(); } }
                                Button { text: root.role-picked > 0 ? "Add " + root.role-picked : "Add"; kind: "filled"; enabled: root.role-picked > 0 && !root.admin-busy; clicked => { root.add-role-members(); } }
                            }
                        }
                        if root.roles-loaded && root.role-index > 0 && !root.role-members-tab: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.space-3;
                            Text { text: "Role name"; color: Theme.on-surface; }
                            TextField { text <=> root.role-name; enabled: !root.admin-busy; edited => { root.role-edited(); } }
                            if root.roles-reorderable: HorizontalLayout {
                                spacing: Theme.space-3;
                                Button { text: "Move up"; kind: "text"; enabled: root.role-index > 1 && !root.admin-busy && !root.role-dirty; clicked => { root.move-role(true); } }
                                Button { text: "Move down"; kind: "text"; enabled: root.role-index < root.roles.length - 1 && !root.admin-busy && !root.role-dirty; clicked => { root.move-role(false); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-5;
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: Theme.space-3; alignment: start;
                                    Text { text: "Colour (#rrggbb, empty for none)"; color: Theme.on-surface; }
                                    TextField { text <=> root.role-colour; enabled: !root.admin-busy; edited => { root.role-edited(); } }
                                }
                                VerticalLayout {
                                    alignment: start; spacing: Theme.space-3;
                                    Text { text: "Show separately"; color: Theme.on-surface; }
                                    Toggle { checked: root.role-hoist; toggled(on) => { root.role-hoist = on; root.role-edited(); } }
                                }
                            }
                        }
                        if root.roles-loaded && root.role-index == 0: Text { text: "Everyone: what every member has without a role."; wrap: word-wrap; color: Theme.on-surface-variant; }
                        if !root.role-members-tab: perms := ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: perms.visible-width - 12px;
                                spacing: Theme.space-2; alignment: start;
                                for p[i] in root.permissions: VerticalLayout {
                                    spacing: Theme.space-2;
                                    if p.heading != "": Text { text: p.heading; font-weight: 600; color: Theme.on-surface; height: 32px; vertical-alignment: bottom; }
                                    HorizontalLayout {
                                        spacing: Theme.space-5; padding-top: Theme.space-2; padding-bottom: Theme.space-2;
                                        VerticalLayout {
                                            horizontal-stretch: 1; alignment: center;
                                            Text { text: p.title; color: Theme.on-surface; }
                                            Text { text: p.description; font-size: Theme.text-small; color: Theme.outline; wrap: word-wrap; }
                                        }
                                        TriState {
                                            y: (parent.height - self.height) / 2;
                                            state: p.state; enabled: !root.admin-busy;
                                            chose(state) => { root.set-permission-state(i, state); }
                                        }
                                    }
                                }
                            }
                        }
                        if !root.role-members-tab: HorizontalLayout {
                            spacing: Theme.space-3; alignment: end;
                            if root.role-index > 0: Button { text: "Delete role"; danger: true; enabled: !root.admin-busy; clicked => { root.delete-role(); } }
                            Button { text: "Save"; kind: "filled"; enabled: root.role-dirty && !root.admin-busy; clicked => { root.save-role(); } }
                        }
                    }
                }

                // Emojis (official EmojiList): a form to add one, then the list
                // with rename and delete.
                if root.page == 2 || root.page == 6 || root.page == 7: emoji-scroll := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: min(emoji-scroll.visible-width, 680px);
                        padding: Theme.space-5; spacing: Theme.space-3; alignment: start;
                        Text { text: "Add " + (root.expression-noun == "emoji" ? "an " : "a ") + root.expression-noun; font-weight: 600; color: Theme.on-surface; }
                        HorizontalLayout {
                            spacing: Theme.space-3;
                            Button { text: root.expression-noun == "sound" ? "Choose audio file" : "Choose image"; enabled: root.emoji-can-create && !root.admin-busy; clicked => { root.pick-emoji-file(); } }
                            Text { text: root.emoji-file-label; vertical-alignment: center; color: Theme.on-surface-variant; overflow: elide; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-3;
                            TextField { placeholder: (root.expression-noun == "emoji" ? "Emoji" : root.expression-noun == "sticker" ? "Sticker" : "Sound") + " name"; text <=> root.emoji-new-name; enabled: root.emoji-can-create && !root.admin-busy; edited => { root.emoji-name-edited(); } accepted => { root.create-emoji(); } }
                            Button { y: 4px; text: "Create"; kind: "filled"; enabled: root.emoji-can-create && !root.admin-busy && root.emoji-new-name != "" && root.emoji-file-label != "" && root.emoji-new-error == ""; clicked => { root.create-emoji(); } }
                        }
                        Text { text: root.expression-hint; font-size: Theme.text-small; color: Theme.outline; wrap: word-wrap; }
                        if root.emoji-new-error != "": Text { text: root.emoji-new-error; wrap: word-wrap; color: Theme.error; }
                        if root.emoji-slots != "": Text { text: root.emoji-slots; font-size: Theme.text-small; color: Theme.on-surface-variant; }
                        Rectangle { height: Theme.space-3; }
                        if !root.emoji-loaded: Text { text: "Loading " + root.expression-noun + "s…"; color: Theme.on-surface-variant; }
                        if root.emoji-loaded && root.emoji.length == 0: Text { text: "No " + root.expression-noun + (root.expression-noun == "emoji" ? "" : "s") + " yet."; color: Theme.outline; }
                        for e[i] in root.emoji: HorizontalLayout {
                            spacing: Theme.space-4; height: 48px;
                            Rectangle {
                                y: 8px; width: 32px; height: 32px; border-radius: Theme.radius-sm; clip: true; background: Theme.surface-high;
                                if e.has-image: Image { width: parent.width; height: parent.height; source: e.image; image-fit: contain; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center;
                                Text { text: root.expression-noun == "emoji" ? ":" + e.name + ":" : e.name; color: Theme.on-surface; overflow: elide; }
                                if e.creator != "": Text { text: e.creator; font-size: Theme.text-small; color: Theme.on-surface-variant; overflow: elide; }
                            }
                            if root.emoji-can-create: IconButton { y: 6px; glyph: Icons.edit; tooltip: "Edit " + root.expression-noun; enabled: !root.admin-busy; clicked => { root.rename-text = e.name; root.rename-row = i; } }
                            if root.emoji-can-create: IconButton { y: 6px; glyph: Icons.delete; tooltip: "Delete " + root.expression-noun; enabled: !root.admin-busy; clicked => { root.delete-row = i; } }
                        }
                    }
                }

                // Invites: inviter and code, with copy and delete.
                if root.page == 3: invite-list := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: min(invite-list.visible-width, 680px);
                        padding: Theme.space-5; spacing: Theme.space-2; alignment: start;
                        if !root.invites-loaded: Text { text: "Loading invites…"; color: Theme.on-surface-variant; }
                        if root.invites-loaded && root.invites.length == 0: Text { text: "No invites."; color: Theme.outline; }
                        for inv[i] in root.invites: HorizontalLayout {
                            spacing: Theme.space-4; height: 48px;
                            Avatar { y: 8px; size: 32px; source: inv.avatar; has-image: inv.has-avatar; initials: ""; }
                            Text { text: inv.creator; vertical-alignment: center; color: Theme.on-surface; horizontal-stretch: 1; overflow: elide; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: inv.code; font-family: "monospace"; color: Theme.on-surface; }
                                Text { text: "#" + inv.channel; font-size: Theme.text-small; color: Theme.on-surface-variant; }
                            }
                            IconButton { y: 6px; glyph: Icons.copy; tooltip: "Copy link"; clicked => { root.copy-invite(i); } }
                            IconButton { y: 6px; glyph: Icons.delete; tooltip: "Delete invite"; enabled: !root.admin-busy; clicked => { root.delete-invite(i); } }
                        }
                    }
                }

                // AutoMod: each rule with its trigger, an on/off switch and delete.
                if root.page == 8: automod-list := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: min(automod-list.visible-width, 680px);
                        padding: Theme.space-5; spacing: Theme.space-2; alignment: start;
                        if !root.automod-loaded: Text { text: "Loading rules…"; color: Theme.on-surface-variant; }
                        if root.automod-loaded && root.automod-rules.length == 0: Text { text: "No AutoMod rules."; color: Theme.outline; }
                        for rule[i] in root.automod-rules: HorizontalLayout {
                            spacing: Theme.space-4; height: 48px;
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center;
                                Text { text: rule.name; color: Theme.on-surface; overflow: elide; }
                                Text { text: rule.keywords == "" ? rule.kind : rule.kind + ": " + rule.keywords; font-size: Theme.text-small; color: Theme.on-surface-variant; overflow: elide; }
                            }
                            Toggle { y: 12px; checked: rule.enabled; enabled: !root.admin-busy; toggled(on) => { root.set-automod-rule(i, on); } }
                            IconButton { y: 6px; glyph: Icons.delete; tooltip: "Delete rule"; enabled: !root.admin-busy; clicked => { root.delete-automod-rule(i); } }
                        }
                    }
                }

                // Bans: user and reason, with Pardon.
                if root.page == 4: ban-list := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: min(ban-list.visible-width, 680px);
                        padding: Theme.space-5; spacing: Theme.space-2; alignment: start;
                        if !root.bans-loaded: Text { text: "Loading bans…"; color: Theme.on-surface-variant; }
                        if root.bans-loaded && root.bans.length == 0: Text { text: "No bans."; color: Theme.outline; }
                        for ban[i] in root.bans: HorizontalLayout {
                            spacing: Theme.space-4; height: 48px;
                            Avatar { y: 8px; size: 32px; source: ban.avatar; has-image: ban.has-avatar; initials: ""; }
                            Text { text: ban.name; vertical-alignment: center; color: Theme.on-surface; overflow: elide; }
                            Text { text: ban.reason; vertical-alignment: center; color: Theme.on-surface-variant; horizontal-stretch: 1; overflow: elide; }
                            IconButton { y: 6px; glyph: Icons.delete; tooltip: "Pardon user"; enabled: !root.admin-busy; clicked => { root.unban(i); } }
                        }
                    }
                }
                if root.page == 5: moderation-list := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: min(moderation-list.visible-width, 680px);
                        padding: Theme.space-5; spacing: Theme.space-2; alignment: start;
                        if root.moderation-log-error != "": Text { text: root.moderation-log-error; color: Theme.error; wrap: word-wrap; }
                        if root.moderation-log-loading && root.moderation-log.length == 0: Text { text: "Loading moderation log…"; color: Theme.on-surface-variant; }
                        if !root.moderation-log-loading && root.moderation-log-error == "" && root.moderation-log.length == 0: Text { text: "No moderation log entries."; color: Theme.outline; }
                        for entry[i] in root.moderation-log: HorizontalLayout {
                            spacing: Theme.space-4; padding: Theme.space-2;
                            Avatar { size: 36px; source: entry.avatar; has-image: entry.has-avatar; initials: ""; }
                            VerticalLayout {
                                spacing: Theme.space-1; horizontal-stretch: 1; alignment: center;
                                Text { text: entry.actor + " " + entry.text; color: Theme.on-surface; wrap: word-wrap; }
                                if entry.target != "": Text { text: "Target: " + entry.target; color: Theme.on-surface-variant; wrap: word-wrap; }
                                if entry.reason != "": Text { text: "Reason: " + entry.reason; color: Theme.on-surface-variant; wrap: word-wrap; }
                                Text { text: entry.time; font-size: Theme.text-small; color: Theme.outline; }
                            }
                        }
                        if root.moderation-log-has-more: Button { text: root.moderation-log-loading ? "Loading…" : "Load more"; enabled: !root.moderation-log-loading; clicked => { root.load-more-moderation-log(); } }
                    }
                }
            }
        }
    }
    // The official EditEmoji dialog.
    if root.rename-row >= 0: Dialog {
        title: "Rename " + root.expression-noun;
        dismissed => { root.rename-row = -1; }
        TextField { text <=> root.rename-text; autofocus: true; accepted => { root.rename-emoji(root.rename-row, root.rename-text); root.rename-row = -1; } }
        HorizontalLayout {
            alignment: end; spacing: Theme.gap-sm;
            Button { text: "Close"; clicked => { root.rename-row = -1; } }
            Button { text: "Change"; kind: "filled"; enabled: root.rename-text != ""; clicked => { root.rename-emoji(root.rename-row, root.rename-text); root.rename-row = -1; } }
        }
    }
    // The official DeleteEmoji confirmation.
    if root.delete-row >= 0: ConfirmDialog {
        title: "Delete " + root.expression-noun;
        message: root.expression-noun == "emoji" ? "Delete this emoji? Messages that use it will show its name instead." : "Delete this " + root.expression-noun + "?";
        confirm-text: "Delete"; danger: true;
        cancelled => { root.delete-row = -1; }
        confirmed => { root.delete-emoji(root.delete-row); root.delete-row = -1; }
    }
    // The official DeleteServer confirmation.
    if root.confirm-delete: Dialog {
        title: "Delete " + root.server-name + "?";
        dismissed => { root.confirm-delete = false; }
        Text { text: "Once it's deleted, there's no going back."; wrap: word-wrap; color: Theme.on-surface-variant; }
        HorizontalLayout {
            alignment: end; spacing: Theme.gap-sm;
            Button { text: "Cancel"; clicked => { root.confirm-delete = false; } }
            Button { text: "Delete"; danger: true; clicked => { root.confirm-delete = false; root.delete-server(); } }
        }
    }
}
