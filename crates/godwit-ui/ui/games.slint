import { ListView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { GamesFriendItem, GameRowItem } from "types.slint";
import { Toggle, PageHeader, TextField, ChoiceChip, IconButton } from "widgets.slint";

// A Venn region's count: picking it lists that region's games below.
component RegionCount inherits Rectangle {
    in property <int> count;
    in property <bool> chosen;
    // The region's centre in the diagram.
    in property <length> cx;
    in property <length> cy;
    callback pick();
    width: label.preferred-width + 2 * Theme.space-3;
    height: Theme.chip-compact-height;
    x: self.cx - self.width / 2;
    y: self.cy - self.height / 2;
    border-radius: self.height / 2;
    background: root.chosen ? Theme.secondary-container : touch.has-hover ? Theme.surface-highest : Theme.surface;
    label := Text {
        text: root.count;
        font-size: Theme.text-label;
        font-weight: root.chosen ? 600 : 400;
        color: root.chosen ? Theme.on-secondary-container : Theme.on-surface;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.pick(); } }
}

// A circle of the diagram (an outline: the regions show through).
component VennCircle inherits Rectangle {
    width: self.height;
    border-radius: self.height / 2;
    border-width: 2px; // literal: the diagram's own outline
    border-color: Theme.outline;
}

// Games in common (a page, from Home or a chat's menu): pick friends, see
// which games everyone owns. Rows are one height, so the list builds only
// what's on screen and Rust decodes only the pictures near it
// (`games-scrolled`).
export component GamesPage inherits Rectangle {
    // The accounts that have game libraries (a selector with two or more).
    in property <[string]> accounts;
    in property <int> account;
    callback pick-account(int);
    // The picker's search, filtered by the app (picked friends stay).
    in-out property <string> query;
    callback search(string);
    in property <[GamesFriendItem]> friends;
    // "Bob's games are private.", "Loading Ann's games…", hints.
    in property <[string]> notes;
    // 2 or 3: a Venn diagram of that many people; 0: none (the list ranks).
    in property <int> venn;
    // Which circle is whose ("Left: You · Right: Ann").
    in property <string> legend;
    // Games per region, by owners' bitmask (index 0 unused).
    in property <[int]> regions;
    in property <int> region;
    in property <[GameRowItem]> rows;
    callback pick-friend(int, bool);
    callback pick-region(int);
    callback games-scrolled(int);
    // Every list (each region, or everyone and everyone-but) as Markdown on
    // the clipboard, to send to a friend or a group.
    callback copy-list();

    property <length> row-height: 48px;

    VerticalLayout {
        PageHeader {
            label: "Games in common";
            glyph: Icons.group;
            if root.rows.length > 0: IconButton {
                glyph: Icons.copy;
                tooltip: "Copy all lists";
                clicked => { root.copy-list(); }
            }
        }
        if root.accounts.length > 1: HorizontalLayout {
            padding-left: Theme.gap-lg;
            padding-right: Theme.gap-lg;
            padding-bottom: Theme.gap-md;
            spacing: Theme.gap-sm;
            for a[i] in root.accounts: ChoiceChip {
                label: a;
                chosen: i == root.account;
                choose => { root.pick-account(i); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: Theme.gap-lg;
            padding-right: Theme.gap-lg;
            padding-bottom: Theme.gap-md;
            spacing: Theme.space-5;
            VerticalLayout {
                width: 240px;
                spacing: Theme.space-3;
                Text { text: "Compare with"; font-size: Theme.text-label; font-weight: 600; color: Theme.on-surface-variant; }
                TextField {
                    text <=> root.query;
                    placeholder: "Search friends";
                    edited(t) => { root.search(t); friend-list.content-y = 0; }
                }
                friend-list := ListView {
                    vertical-stretch: 1;
                    for f[i] in root.friends: HorizontalLayout {
                        height: root.row-height;
                        spacing: Theme.space-3;
                        Text {
                            text: f.name;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                            font-size: Theme.text-body;
                            color: Theme.on-surface;
                        }
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                checked: f.picked;
                                toggled => { root.pick-friend(i, self.checked); }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-3;
                for note in root.notes: Text {
                    text: note;
                    wrap: word-wrap;
                    font-size: Theme.text-body;
                    color: Theme.on-surface-variant;
                }
                if root.venn == 2: Rectangle {
                    height: 150px;
                    Rectangle {
                        width: 280px;
                        VennCircle { x: 20px; y: 5px; height: 140px; }
                        VennCircle { x: 120px; y: 5px; height: 140px; }
                        RegionCount { cx: 70px; cy: 75px; count: root.regions[1]; chosen: root.region == 1; pick => { root.pick-region(1); } }
                        RegionCount { cx: 210px; cy: 75px; count: root.regions[2]; chosen: root.region == 2; pick => { root.pick-region(2); } }
                        RegionCount { cx: 140px; cy: 75px; count: root.regions[3]; chosen: root.region == 3; pick => { root.pick-region(3); } }
                    }
                }
                if root.venn == 3: Rectangle {
                    height: 200px;
                    Rectangle {
                        width: 280px;
                        VennCircle { x: 40px; y: 0px; height: 130px; }
                        VennCircle { x: 110px; y: 0px; height: 130px; }
                        VennCircle { x: 75px; y: 65px; height: 130px; }
                        RegionCount { cx: 70px; cy: 50px; count: root.regions[1]; chosen: root.region == 1; pick => { root.pick-region(1); } }
                        RegionCount { cx: 210px; cy: 50px; count: root.regions[2]; chosen: root.region == 2; pick => { root.pick-region(2); } }
                        RegionCount { cx: 140px; cy: 30px; count: root.regions[3]; chosen: root.region == 3; pick => { root.pick-region(3); } }
                        RegionCount { cx: 140px; cy: 170px; count: root.regions[4]; chosen: root.region == 4; pick => { root.pick-region(4); } }
                        RegionCount { cx: 100px; cy: 115px; count: root.regions[5]; chosen: root.region == 5; pick => { root.pick-region(5); } }
                        RegionCount { cx: 180px; cy: 115px; count: root.regions[6]; chosen: root.region == 6; pick => { root.pick-region(6); } }
                        RegionCount { cx: 140px; cy: 88px; count: root.regions[7]; chosen: root.region == 7; pick => { root.pick-region(7); } }
                    }
                }
                if root.venn > 0: Text {
                    text: root.legend;
                    horizontal-alignment: center;
                    font-size: Theme.text-small;
                    color: Theme.on-surface-variant;
                }
                list := ListView {
                    vertical-stretch: 1;
                    // Not `scrolled`: it doesn't fire for the mouse wheel.
                    changed content-y => { root.report(); }
                    for r in root.rows: HorizontalLayout {
                        height: root.row-height;
                        spacing: Theme.space-4;
                        // A sub-heading sits under its section's heading: the
                        // layout's spacing indents it.
                        if r.sub: Rectangle { width: 0px; }
                        if !r.header: Rectangle {
                            // A capsule is 184×69: this keeps its shape.
                            width: 107px;
                            height: 40px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.surface-highest;
                            if r.has-image: Image { source: r.image; width: parent.width; height: parent.height; image-fit: contain; }
                        }
                        Text {
                            text: r.title;
                            vertical-alignment: center;
                            overflow: elide;
                            font-size: r.header ? Theme.text-label : Theme.text-body;
                            font-weight: r.header ? 600 : 400;
                            color: r.header ? Theme.on-surface-variant : Theme.on-surface;
                        }
                    }
                }
            }
        }
    }
    function report() {
        root.games-scrolled(floor(-list.content-y / root.row-height));
    }
}
