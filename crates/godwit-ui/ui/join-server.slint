import { Theme } from "theme.slint";
import { Dialog, Button, Select, TextField } from "widgets.slint";

// Uses the same invite preview and explicit Join as message invite cards.
export component JoinServer inherits Dialog {
    in property <[string]> accounts;
    in property <[string]> create-accounts;
    in-out property <int> account-index;
    in-out property <int> create-account-index;
    in property <string> status;
    in property <string> server-name;
    in property <bool> ready;
    in property <bool> busy;
    in property <bool> failed;
    callback inspect(int, string);
    callback join();
    callback reset();
    callback create-server(string);
    in-out property <bool> creating;
    in-out property <bool> choosing;
    in-out property <string> create-text;
    in-out property <string> address-text;
    title: "Join a server";
    if root.choosing: HorizontalLayout {
        spacing: Theme.gap-sm;
        Button { text: "Join a server"; kind: "tonal"; enabled: root.accounts.length > 0; clicked => { root.creating = false; root.choosing = false; } }
        Button { text: "Create a server"; kind: "tonal"; enabled: root.create-accounts.length > 0; clicked => { root.creating = true; root.choosing = false; } }
    }
    if root.choosing && root.accounts.length == 0 && root.create-accounts.length == 0: Text {
        text: root.status;
        wrap: word-wrap;
        color: Theme.on-surface-variant;
    }
    if !root.choosing && root.creating && root.create-accounts.length > 1: Select {
        model: root.create-accounts;
        current-index <=> root.create-account-index;
    }
    if !root.choosing && root.creating: TextField {
        text <=> root.create-text;
        autofocus: true;
        placeholder: "Server name (1–32 characters)";
    }
    if !root.choosing && !root.creating && root.accounts.length > 1: Select {
        model: root.accounts;
        current-index <=> root.account-index;
        selected => { root.reset(); }
    }
    if !root.choosing && !root.creating: TextField {
        text <=> root.address-text;
        autofocus: true;
        enabled: !root.busy && root.accounts.length > 0;
        placeholder: "Invite link or code";
        edited => { root.reset(); }
        accepted => {
            if !root.busy && self.text != "" {
                root.inspect(root.account-index, self.text);
            }
        }
    }
    if !root.choosing && !root.creating && root.server-name != "": Text {
        text: root.server-name;
        font-weight: 600;
        wrap: word-wrap;
        color: Theme.on-surface;
    }
    if !root.choosing && !root.creating && root.status != "": Text {
        text: root.status;
        wrap: word-wrap;
        color: root.failed ? Theme.error : Theme.on-surface-variant;
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.gap-sm;
        Button { text: root.choosing ? "Cancel" : "Back"; clicked => { if root.choosing { root.dismissed(); } else { root.choosing = true; root.creating = false; } } }
        if !root.choosing && root.creating: Button {
            text: "Create";
            kind: "filled";
            enabled: root.create-accounts.length > 0 && root.create-text != "";
            clicked => { root.create-server(root.create-text); }
        }
        if !root.choosing && !root.creating: Button {
            text: "Preview";
            enabled: !root.busy && root.accounts.length > 0 && root.address-text != "";
            clicked => { root.inspect(root.account-index, root.address-text); }
        }
        if !root.choosing && !root.creating: Button {
            text: root.busy && root.server-name != "" ? "Joining…" : "Join";
            kind: "filled";
            enabled: root.ready && !root.busy;
            clicked => { root.join(); }
        }
    }
}
