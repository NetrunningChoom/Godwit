import { Slider, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { Anim, Players, CallFrames, Select, BlockItem, MessageItem, AttachmentItem, EmbedItem, InviteItem, ReactionItem, FileItem, CallMemberItem, EmojiRowItem, StreamItem } from "types.slint";
import { CallVideoItem, ForumPostItem, ForumTagItem } from "types.slint";
import { ForumView } from "forum-view.slint";
import { EmojiPicker } from "picker.slint";
import { TextBlock } from "textblock.slint";
import { Gifs, GifPicker } from "gif-picker.slint";
import { Avatar, IconButton, ImageIconButton, Button, MenuPanel, MenuRow, MenuDivider, TextField, Select as Dropdown, EmojiText } from "widgets.slint";
import { TalkOnItem } from "types.slint";
import { MessageRow } from "message-row.slint";


// The open room: header with its security line, the suggestion bar, the
// messages, who's typing and the composer.
export component Timeline inherits Rectangle {
        in property <string> title;
        // With several accounts: the one this room is on ("" otherwise),
        // shown as a chip in the header and named in the composer.
        in property <string> as-account;
        // A merged person's networks (two or more): switch between them here.
        in property <[TalkOnItem]> talk-on;
        // The same, as a dropdown's words, and the current one's place.
        in property <[string]> talk-on-labels;
        in property <int> talk-on-current;
        callback talk-on-picked(int);
        // A person's chat: our own nickname for them can be set here.
        in property <bool> can-rename;
        in property <string> nickname;
        callback rename(string);
        property <bool> renaming;
        property <string> rename-draft;
    // A server channel (a # symbol) rather than a conversation (an @).
    in property <bool> is-channel;
    in property <bool> encrypted;
    in property <string> security;
    in property <[MessageItem]> messages;
    in property <bool> loading;
    // Loading failed: a calm line with a retry instead of the typing line.
    in property <bool> failed;
    // The room's network is reconnecting ("" when connected).
    in property <string> offline;
    // The whole history is loaded: say so at the top, as Godwit does.
    in property <bool> reached-start;
    // Showing older messages around a jump, not the newest.
    in property <bool> detached;
    callback jump-to-present();
    in property <bool> can-send;
    in property <bool> convert-emoticons;
    in property <bool> can-react;
    in property <bool> can-mark-unread;
    in property <bool> can-forward;
    in property <bool> can-reply;
    in property <bool> can-edit;
    in property <bool> can-delete;
    in property <bool> can-delete-others;
    in-out property <string> draft;
    in property <string> nudge;
    in property <string> compose-label;
    in property <string> typing;
    in property <bool> can-attach;
    in property <bool> can-call;
    // Calls exist on this network but don't work in Godwit yet: the button shows disabled.
    in property <string> call-unavailable;
    // A server channel or group: it has a member list to show.
    in property <bool> has-members;
    // The room's pinned messages can be seen (a header button) and set (the menu).
    in property <bool> has-pins;
    in property <bool> has-search;
    callback open-search();
    // Threads can be started from messages here; a forum takes posts instead.
    in property <bool> can-thread;
    in property <bool> is-forum;
    // The forum's posts list (shown in place of the messages).
    in property <[ForumPostItem]> forum-posts;
    in property <[ForumTagItem]> forum-filter-tags;
    in property <[string]> forum-sort-labels;
    in property <int> forum-sort-index;
    in property <bool> forum-loading;
    in property <bool> forum-failed;
    in property <bool> forum-has-older;
    in property <bool> forum-loading-older;
    callback forum-open-post(int);
    callback forum-toggle-tag(int);
    callback forum-set-sort(int);
    callback forum-load-older();
    callback create-thread(int);
    callback new-post();
    in property <bool> can-pin;
    in property <bool> can-moderate-reactions;
    in property <bool> can-report;
    callback report(int);
    callback open-pins();
    callback pin(int, bool);
    in property <bool> members-shown;
    callback toggle-members();
    // We're in this room's call: show its members.
    in property <bool> call-here;
    in property <string> call-status;
    in property <bool> call-muted;
    in property <bool> call-deafened;
    in property <bool> call-speaking;
    in property <string> call-time;
    in property <bool> call-camera;
    in property <bool> call-screen-share;
    in property <bool> call-can-video;
    in property <bool> call-video-network;
    in property <[CallVideoItem]> call-videos;
    callback set-camera(bool);
    callback set-screen-share(bool);
    callback toggle-mute();
    callback toggle-deafen();
    callback leave-call();
    in property <[CallMemberItem]> call-members;
    // Go Live streams in the call: Watch / Stop watching, and their sound.
    in property <[StreamItem]> call-streams;
    callback watch-stream(int, bool);
    callback stream-sound(int, float, bool, bool);
    // Someone's volume here (0..2) and whether they're muted here only.
    callback user-sound(int, float, bool, bool);
    property <int> sound-member: -1;
    property <length> sound-x;
    property <length> sound-y;
    // The call stage and chat share this view; its bottom edge can be dragged
    // whether the call has video, streams, or audio-only participants.
    in-out property <bool> call-panel-dragged;
    in-out property <length> call-panel-h: 420px;
    in-out property <length> sidebar-width;
    in-out property <bool> combined-resize-hover;
    callback sidebar-width-committed();
    property <length> call-panel-shown-h;
    property <length> call-panel-min:
        (root.call-extra-videos ? 140px : 0px)
        + min(root.call-extra-videos ? 136px : 288px, max(136px, ceil(root.call-members.length / max(1, floor((root.width - Theme.gap-md) / 176px))) * 124px + 12px))
        + (root.call-streams.length > 0 ? Theme.row-header : 0px) + 72px;
    property <bool> has-screen-video: root.call-videos.length > 0 && root.screen-videos > 0;
    in property <int> screen-videos;
    in property <bool> call-extra-videos;
    callback video-fullscreen(int);
    callback join-call();
    in property <[FileItem]> files;
    callback attach();
    // Ctrl+V with a picture (or copied files) on the clipboard attaches it;
    // false: nothing to attach, the text pastes as usual.
    callback paste-files() -> bool;
    callback remove-file(int);
    callback load-earlier();
    callback draft-edited(string);
    callback capture-composer(int, int);
    in property <int> inserted-at;
    in property <int> insert-serial;
    changed insert-serial => {
        input.set-selection-offsets(root.inserted-at, root.inserted-at);
        input.focus();
    }
    callback send();
    callback dismiss-nudge(bool);
    callback reply(int);
    callback edit(int);
    callback delete(int);
    callback react(int, int);
    callback remove-reactions(int, int);
    callback remove-all-reactions(int);
    callback open-picker(int);
    // The emoji picker (for row's reactions, or the composer when -1).
    in property <bool> picker-open;
    in property <[EmojiRowItem]> emoji-rows;
    callback picker-search(string);
    callback picker-picked(int, int);
    callback picker-scrolled(int);
    callback close-picker();
    callback open-attachment(int, int);
    callback link-clicked(int, string);
    callback play-inline(string, string);
    callback player-fullscreen(string);
    callback join-invite(string);
    callback join-activity(string);
    callback player-pointer(string, int, int, bool);
    callback player-move(string, int, int);
    callback cancel-compose();
    callback edit-last();
    callback jump-to-reply(int);
    callback open-profile(int);
    callback mark-unread(int);
    callback forward-message(int);
    callback end-poll(int);
    // Polls can be created here: the attach button opens a menu with Create Poll.
    in property <bool> can-poll;
    callback create-poll();
    callback copy-text(int);
    callback copy-link(int);

    // A newly opened room puts the cursor in its composer, as officially.
    changed title => { input.focus(); }
    // Follow new messages while the view is at the bottom; otherwise keep
    // the distance to the bottom, so pages loaded above don't move the view.
    // The visible range: the first and last rows in view (see the list).
    property <int> top-row: -1;
    property <int> bottom-row: -1;
    // Reported at most ~8 times a second: a fast scroll passes many rows,
    // and each report starts pictures and players for the rows near it.
    property <bool> rows-moved;
    changed top-row => { root.rows-moved = true; }
    changed bottom-row => { root.rows-moved = true; }
    rows-timer := Timer {
        interval: 120ms;
        running: root.rows-moved;
        triggered => {
            root.rows-moved = false;
            root.visible-rows(root.top-row, root.bottom-row);
        }
    }
    callback visible-rows(int, int);
    // Older messages load a screen before the top is reached, so they're in
    // place when it is; while the view stays up there, at most a page every
    // 0.7 s (the core asks for one page at a time), so a fast scroll doesn't
    // fire page after page at the network.
    property <bool> near-top;
    changed near-top => { if root.near-top && !root.reached-start { root.load-earlier(); } }
    earlier-timer := Timer {
        interval: 700ms;
        // Not once the chat's start is in: nothing ticks while idle.
        running: root.near-top && !root.reached-start;
        triggered => { root.load-earlier(); }
    }
    property <bool> at-bottom: true;
    property <length> from-bottom: 0;
    function settle() {
        if root.at-bottom {
            list.content-y = min(0px, list.visible-height - list.content-height);
        } else {
            list.content-y = min(0px, root.from-bottom - list.content-height);
        }
    }
    // The message waiting for "Delete message" (-1: none); the window shows
    // the dialog, so its scrim covers everything.
    in-out property <int> confirm-delete: -1;

    // The keyboard scrolls the chat, as a browser scrolls a page: Page
    // Up/Down from anywhere (the composer passes them on), the arrows and
    // Home/End once the chat was clicked (the composer keeps its own
    // arrows: lines, and Up in an empty box edits the last message).
    // 40px a line, as browsers step.
    property <length> scroll-line: 40px;
    function scroll-chat(dy: length) {
        list.content-y = max(min(0px, list.visible-height - list.content-height), min(0px, list.content-y - dy));
    }
    // A page keeps a line of the last one in view, as browsers do.
    function scroll-page(direction: int) {
        root.scroll-chat(direction * max(root.scroll-line, list.visible-height - root.scroll-line));
    }
    // Typing while the chat has the keys goes on in the composer, at its end.
    function type-in-composer(t: string) {
        input.focus();
        root.draft += t;
        root.draft-edited(root.draft);
        // The cursor at the end (offsets are clamped to the text).
        input.set-selection-offsets(2147483647, 2147483647);
    }
    property <int> chat-presses: Select.presses;
    changed chat-presses => { chat-keys.focus(); }
    // Holds the focus only; out of the layout, so it takes no room. Keys it
    // doesn't use go on to the window's shortcuts.
    chat-keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            // Alt+Up/Down switch rooms, and other shortcuts: the window's.
            if e.modifiers.alt || e.modifiers.meta {
                return reject;
            }
            if e.modifiers.control {
                if (e.text == "c" || e.text == "C") && Select.active {
                    Select.copy();
                    return accept;
                }
                if (e.text == "v" || e.text == "V") && root.can-send {
                    input.focus();
                    if !(root.can-attach && root.paste-files()) {
                        input.paste();
                    }
                    return accept;
                }
                if e.text == Key.Home {
                    root.scroll-chat(-list.content-height);
                    return accept;
                }
                if e.text == Key.End {
                    root.scroll-chat(list.content-height);
                    return accept;
                }
                return reject;
            }
            if e.text == Key.UpArrow {
                root.scroll-chat(-root.scroll-line);
                return accept;
            }
            if e.text == Key.DownArrow {
                root.scroll-chat(root.scroll-line);
                return accept;
            }
            if e.text == Key.PageUp {
                root.scroll-page(-1);
                return accept;
            }
            if e.text == Key.PageDown {
                root.scroll-page(1);
                return accept;
            }
            if e.text == Key.Home {
                root.scroll-chat(-list.content-height);
                return accept;
            }
            if e.text == Key.End {
                root.scroll-chat(list.content-height);
                return accept;
            }
            if e.text == Key.Escape {
                if Select.active {
                    Select.clear();
                    return accept;
                }
                if root.compose-label != "" {
                    root.cancel-compose();
                    return accept;
                }
                return reject;
            }
            // Text, not a control or special key (those are below the space
            // or in Slint's private-use range).
            if root.can-send && e.text >= " " && e.text != Key.Delete
                && !(e.text >= "\u{F700}" && e.text < "\u{F900}") {
                root.type-in-composer(e.text);
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        // The header: 48 px, a 24 px symbol and the 15 px semibold title.
        Rectangle {
            height: Theme.row-header;
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-md;
                Icon {
                    text: root.is-channel ? Icons.tag : Icons.at;
                    font-size: Theme.text-headline;
                    color: Theme.on-surface-variant;
                }
                // Header texts elide: an unwrapped text's minimum is its whole
                // length, which made the chat wider than the window (its
                // composer's buttons went off screen).
                if !root.renaming: Text {
                    text: root.title;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: min(self.preferred-width, 80px);
                    font-size: Theme.text-navigation;
                    font-weight: 600;
                    color: Theme.on-surface;
                    // A person: click their name to give them your own.
                    if root.can-rename: TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.rename-draft = root.nickname;
                            root.renaming = true;
                        }
                    }
                }
                if root.renaming: TextField {
                    y: (parent.height - self.height) / 2;
                    width: 220px;
                    text: root.nickname;
                    placeholder: "Nickname (only you see it)";
                    autofocus: true;
                    edited(t) => { root.rename-draft = t; }
                    accepted => {
                        root.rename(root.rename-draft);
                        root.renaming = false;
                    }
                }
                // Back to their own name.
                if root.renaming && root.nickname != "": Button {
                    y: (parent.height - self.height) / 2;
                    text: "Reset";
                    kind: "text";
                    clicked => {
                        root.rename("");
                        root.renaming = false;
                    }
                }
                if root.renaming: Button {
                    y: (parent.height - self.height) / 2;
                    text: "Cancel";
                    kind: "text";
                    clicked => { root.renaming = false; }
                }
                if root.as-account != "": Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 22px;
                    width: min(account-chip.preferred-width, 160px) + 16px;
                    border-radius: self.height / 2;
                    background: Theme.surface-high;
                    account-chip := Text {
                        width: min(self.preferred-width, 160px);
                        overflow: elide;
                        text: root.as-account;
                        font-size: Theme.text-small;
                        color: Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }
                Icon {
                    text: root.encrypted ? Icons.lock : Icons.info;
                    color: root.encrypted ? Theme.primary : Theme.outline;
                    font-size: Theme.text-title;
                }
                Text {
                    text: root.security;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    font-size: Theme.text-small;
                    color: Theme.outline;
                }
                if root.has-search: Button {
                    y: (parent.height - self.height) / 2;
                    text: "Search";
                    kind: "text";
                    clicked => { root.open-search(); }
                }
                if root.has-pins: IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.notes;
                    tooltip: "Pinned messages";
                    clicked => { root.open-pins(); }
                }
                if root.has-members: IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.group;
                    tooltip: root.members-shown ? "Hide members" : "View members";
                    tint: root.members-shown ? Theme.primary : Theme.on-surface-variant;
                    clicked => { root.toggle-members(); }
                }
                // A labelled button, set apart, as officially: a stray click
                // on a small icon shouldn't put anyone in a call.
                if root.can-call && !root.call-here: Rectangle { width: 12px; }
                if root.can-call && !root.call-here: Button {
                    y: (parent.height - self.height) / 2;
                    kind: "tonal";
                    text: "Join call";
                    clicked => { root.join-call(); }
                }
                if !root.can-call && root.call-unavailable != "": Rectangle { width: 12px; }
                if !root.can-call && root.call-unavailable != "": Button {
                    y: (parent.height - self.height) / 2;
                    kind: "tonal";
                    text: "Call";
                    enabled: false;
                }
                if !root.can-call && root.call-unavailable != "": Text {
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0;
                    text: root.call-unavailable;
                    font-size: Theme.text-small;
                    color: Theme.outline;
                }
            }
            }
        // Choose which identity and account this DM uses. A single dropdown
        // keeps the control consistent as contacts gain more linked accounts.
        if root.talk-on.length > 1: HorizontalLayout {
            height: Theme.row-member;
            alignment: start;
            padding-left: Theme.gap-md;
            padding-right: Theme.gap-md;
            spacing: Theme.gap-sm;
            Text { text: "Account:"; vertical-alignment: center; font-size: Theme.text-small; color: Theme.on-surface-variant; }
            Dropdown {
                y: (parent.height - self.height) / 2;
                height: 36px;
                width: 320px;
                model: root.talk-on-labels;
                current-index: root.talk-on-current;
                selected(i) => {
                    if i != root.talk-on-current {
                        root.talk-on-picked(i);
                    }
                }
            }
        }
        // One connected call panel: video, live streams, participant cards,
        // and call controls stay together above the chat.
        if root.call-here: call-panel := Rectangle {
            // A dragged height is what it prefers, never its minimum: on a
            // smaller screen (the window moved, or made shorter) the panel
            // gives way down to its usual minimum rather than pushing the
            // window's own minimum past the screen and the chat out of view.
            min-height: root.call-panel-min;
            preferred-height: root.call-panel-dragged ? root.call-panel-h : root.call-panel-min;
            max-height: root.call-panel-dragged ? root.call-panel-h : 100000px;
            vertical-stretch: 0.6;
            background: Theme.surface-low;
            border-radius: Theme.radius-md;
            clip: true;
            // A dragged size is for watching: with no stream or video on
            // screen (all stopped, or a new call) the panel sizes itself again.
            property <bool> showing-video: root.call-videos.length > 0;
            changed showing-video => {
                if !self.showing-video {
                    root.call-panel-dragged = false;
                }
            }
            init => {
                root.call-panel-shown-h = self.height;
                if !self.showing-video {
                    root.call-panel-dragged = false;
                }
            }
            changed height => { root.call-panel-shown-h = self.height; }
            VerticalLayout {
                spacing: 0px;
        // The call's video: tiles share the width; a tile can go fullscreen.
        if root.call-here && root.call-extra-videos: Rectangle {
            min-height: 140px;
            preferred-height: 140px;
            vertical-stretch: 1;
            background: Theme.surface-low;
            HorizontalLayout {
                padding: Theme.gap-sm;
                spacing: Theme.gap-sm;
                for video[vi] in root.call-videos: Rectangle {
                    visible: !video.primary || video.participant < 0;
                    horizontal-stretch: 1;
                    min-width: 160px;
                    background: Theme.media-stage;
                    border-radius: Theme.radius-sm;
                    clip: true;
                    // Who watches this stream, opened from its eye button.
                    property <bool> show-viewers;
                    property <bool> has-viewers: video.stream >= 0 && video.stream < root.call-streams.length
                        && root.call-streams[video.stream].viewers != "";
                    Image { width: parent.width; height: parent.height; source: vi < CallFrames.frames.length ? CallFrames.frames[vi] : video.frame; image-fit: contain; }
                    // Until the first frame: say it's coming rather than show black.
                    if !video.has-frame: Text {
                        text: video.screen ? "Connecting to the stream…" : "Waiting for video…";
                        color: Theme.on-media-variant;
                        font-size: Theme.text-label;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    // Name and controls along the bottom, over the picture.
                    Rectangle {
                        y: parent.height - self.height;
                        height: 32px;
                        background: @linear-gradient(180deg, transparent 0%, Theme.scrim-strong 100%);
                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-2;
                            spacing: Theme.space-2;
                            Text { text: video.label; color: white; font-size: Theme.text-small; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            if has-viewers: Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: tile-viewers.preferred-width + 12px;
                                height: 24px;
                                border-radius: self.height / 2;
                                background: tile-viewers-touch.has-hover || show-viewers ? Theme.on-media-hover : transparent;
                                tile-viewers := HorizontalLayout {
                                    x: 6px;
                                    spacing: Theme.space-1;
                                    Icon { text: Icons.visibility; color: white; font-size: Theme.text-small; vertical-alignment: center; }
                                    Text { text: root.call-streams[video.stream].viewers; color: white; font-size: Theme.text-small; vertical-alignment: center; }
                                }
                                tile-viewers-touch := TouchArea { mouse-cursor: pointer; clicked => { show-viewers = !show-viewers; } }
                            }
                            IconButton { y: (parent.height - self.height) / 2; glyph: Icons.fullscreen; tooltip: "Fullscreen"; tint: white; clicked => { root.video-fullscreen(vi); } }
                        }
                    }
                    TouchArea {
                        height: parent.height - 32px;
                        y: 0;
                        clicked => { show-viewers = false; }
                        double-clicked => { root.video-fullscreen(vi); }
                    }
                    if show-viewers && has-viewers: Rectangle {
                        x: parent.width - self.width - Theme.space-2;
                        y: parent.height - 32px - self.height - Theme.space-1;
                        width: min(parent.width - 2 * Theme.space-2, max(160px, viewer-list.preferred-width + 24px));
                        height: min(parent.height - 40px, viewer-list.preferred-height + 16px);
                        border-radius: Theme.radius-sm;
                        background: Theme.scrim-strong;
                        clip: true;
                        viewer-list := VerticalLayout {
                            padding: Theme.space-2;
                            padding-left: Theme.space-4;
                            spacing: Theme.space-1;
                            Text { text: "Watching"; color: Theme.on-media-variant; font-size: Theme.text-tiny; font-weight: 600; }
                            Text { text: root.call-streams[video.stream].viewer-names; color: white; font-size: Theme.text-small; }
                        }
                    }
                }
            }
        }
        // Streams in the call (Discord's Go Live): watching opens its tile above.
        if root.call-here && root.call-streams.length > 0: Rectangle {
            height: Theme.row-header;
            background: Theme.surface-low;
            HorizontalLayout {
                padding-left: Theme.gap-md;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-sm;
                alignment: start;
                for s[i] in root.call-streams: Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 36px;
                    // Padding inside the row (not an x offset), so it ends where the pill does.
                    width: stream-row.preferred-width;
                    border-radius: self.height / 2;
                    background: Theme.surface-high;
                    stream-row := HorizontalLayout {
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-4;
                        spacing: Theme.space-3;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: live-text.preferred-width + 10px;
                            height: 18px;
                            border-radius: Theme.radius-xs;
                            background: Theme.error;
                            live-text := Text { text: "LIVE"; font-size: Theme.text-tiny; font-weight: 700; color: Theme.on-error; }
                        }
                        Text { text: s.name; vertical-alignment: center; color: Theme.on-surface; }
                        if s.viewers != "": HorizontalLayout {
                            spacing: Theme.space-1;
                            Icon { text: Icons.visibility; color: Theme.on-surface-variant; font-size: Theme.text-small; }
                            Text { text: s.viewers; vertical-alignment: center; color: Theme.on-surface-variant; font-size: Theme.text-small; }
                        }
                        if !s.watching && s.note != "": Text {
                            text: s.note;
                            vertical-alignment: center;
                            color: Theme.on-surface-variant;
                            font-size: Theme.text-small;
                        }
                        Button {
                            y: (parent.height - self.height) / 2;
                            text: s.watching ? "Stop watching" : "Watch";
                            kind: s.watching ? "text" : "tonal";
                            clicked => { root.watch-stream(i, !s.watching); }
                        }
                        // A watched stream's sound: mute and volume, per person.
                        if s.watching: IconButton {
                            y: (parent.height - self.height) / 2;
                            glyph: s.muted ? Icons.headset-off : Icons.headset;
                            tooltip: s.muted ? "Unmute stream" : "Mute stream";
                            clicked => { root.stream-sound(i, s.volume, !s.muted, true); }
                        }
                        if s.watching && !s.muted: Slider {
                            width: 100px;
                            y: (parent.height - self.height) / 2;
                            minimum: 0;
                            maximum: 2;
                            value: s.volume;
                            changed(v) => { root.stream-sound(i, v, false, false); }
                            released(v) => { root.stream-sound(i, v, false, true); }
                        }
                    }
                }
            }
        }
        // Wrap participants at the available width; larger calls scroll
        // vertically instead of pushing people beyond a fixed horizontal row.
        if root.call-here: participants := ScrollView {
            property <int> columns: max(1, floor((self.visible-width - Theme.gap-md) / 176px));
            property <int> rows: max(1, ceil(root.call-members.length / self.columns));
            property <length> needed: self.rows * 124px + Theme.gap-md;
            // Material's ScrollView keeps 12px (8px bar + 4px gap) under and
            // beside its content whether a bar shows or not: add it, or the
            // tiles come up just short and scroll.
            // With video on, the people keep one row (more scroll) and the
            // video takes the rest of the height.
            height: min(root.call-extra-videos ? 124px + Theme.gap-md + 12px : 288px, self.needed + 12px);
            content-width: self.visible-width;
            content-height: self.needed;
            Rectangle {
                width: participants.visible-width;
                height: participants.content-height;
                background: Theme.surface-low;
                for m[i] in root.call-members: Rectangle {
                    property <length> cell-width: (participants.visible-width - Theme.gap-md) / participants.columns;
                    x: Theme.gap-md + (i - floor(i / participants.columns) * participants.columns) * self.cell-width;
                    y: Theme.gap-md + floor(i / participants.columns) * 124px;
                    width: self.cell-width - Theme.gap-md;
                    height: 108px;
                    border-radius: Theme.radius-md;
                    background: Theme.surface-high;
                    border-width: m.speaking ? 2px : 0;
                    border-color: Theme.primary;
                    if m.video-index >= 0: Image {
                        width: parent.width;
                        height: parent.height;
                        source: m.video-index < CallFrames.frames.length
                            ? CallFrames.frames[m.video-index]
                            : root.call-videos[m.video-index].frame;
                        image-fit: cover;
                    }
                    if m.video-index >= 0: Rectangle {
                        y: parent.height - 36px;
                        height: 36px;
                        background: @linear-gradient(180deg, transparent 0%, Theme.scrim-strong 100%);
                    }
                    if m.video-index >= 0: IconButton {
                        x: parent.width - self.width - Theme.space-2;
                        y: parent.height - self.height - Theme.space-2;
                        glyph: Icons.fullscreen;
                        tooltip: "Fullscreen";
                        tint: white;
                        clicked => { root.video-fullscreen(m.video-index); }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.gap-sm;
                        HorizontalLayout {
                            alignment: center;
                            if m.video-index < 0: Avatar { size: Theme.avatar-profile; source: m.avatar; has-image: m.has-avatar; initials: m.initials; }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.space-2;
                            Text { text: m.name; color: m.video-index >= 0 ? white : Theme.on-surface; overflow: elide; }
                            if m.muted: Icon { text: Icons.mic-off; font-size: Theme.text-body; color: Theme.error; }
                            if m.deafened: Icon { text: Icons.headset-off; font-size: Theme.text-body; color: Theme.error; }
                            // Muted here only: a speaker-off icon beside the others, as the
                            // official clients show it (a caption threw the row off).
                            if m.local-muted: Icon { text: Icons.volume-off; font-size: Theme.text-body; color: Theme.error; }
                        }
                    }
                    // Right-click: their volume here, as the official clients' user menu.
                    if !m.me: TouchArea {
                        pointer-event(e) => {
                            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                                root.sound-member = i;
                                root.sound-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                                root.sound-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                member-sound.show();
                            }
                        }
                    }
                }
            }
        }
        // Fills an audio-only call; with video, the video gets all the room.
        Rectangle { vertical-stretch: root.call-extra-videos ? 0 : 1; background: Theme.surface-low; }
        // Call controls under the stage, in YapFast's filled icon buttons.
        if root.call-here: Rectangle {
            height: 72px;
            background: Theme.surface-low;
            HorizontalLayout {
                alignment: center;
                spacing: Theme.space-3;
                padding: Theme.space-3;
            ImageIconButton {
                icon: root.call-muted
                    ? @image-url("../../../assets/icons/yapfast/mic-off.svg")
                    : @image-url("../../../assets/icons/yapfast/mic.svg");
                tooltip: root.call-muted ? "Unmute" : "Mute";
                enabled: !root.call-deafened;
                tint: root.call-muted ? Theme.error : root.call-speaking ? Theme.online : Theme.on-surface;
                fill: root.call-muted ? Theme.error.with-alpha(0.18) : Theme.surface-high;
                clicked => { root.toggle-mute(); }
            }
            ImageIconButton {
                icon: root.call-deafened
                    ? @image-url("../../../assets/icons/yapfast/headphone-off.svg")
                    : @image-url("../../../assets/icons/yapfast/headphones.svg");
                tooltip: root.call-deafened ? "Undeafen" : "Deafen";
                tint: root.call-deafened ? Theme.error : Theme.on-surface;
                fill: root.call-deafened ? Theme.error.with-alpha(0.18) : Theme.surface-high;
                clicked => { root.toggle-deafen(); }
            }
            if root.call-video-network || root.call-camera: ImageIconButton {
                icon: root.call-camera
                    ? @image-url("../../../assets/icons/yapfast/video.svg")
                    : @image-url("../../../assets/icons/yapfast/video-off.svg");
                tooltip: root.call-camera ? "Turn camera off" : "Turn camera on";
                enabled: root.call-can-video || root.call-camera;
                fill: root.call-camera ? Theme.primary-container : Theme.surface-high;
                clicked => { root.set-camera(!root.call-camera); }
            }
            if root.call-video-network || root.call-screen-share: ImageIconButton {
                icon: root.call-screen-share
                    ? @image-url("../../../assets/icons/yapfast/screen-share-off.svg")
                    : @image-url("../../../assets/icons/yapfast/screen-share.svg");
                tooltip: root.call-screen-share ? "Stop sharing" : "Share your screen";
                enabled: root.call-can-video || root.call-screen-share;
                fill: root.call-screen-share ? Theme.primary-container : Theme.surface-high;
                clicked => { root.set-screen-share(!root.call-screen-share); }
            }
            Rectangle { width: Theme.space-3; }
            ImageIconButton {
                icon: @image-url("../../../assets/icons/yapfast/phone-off.svg");
                tooltip: "Leave call";
                tint: Theme.on-error;
                fill: Theme.error;
                clicked => { root.leave-call(); }
            }
            }
        }
            }
        }
        // Resize the whole call against the channel timeline, including
        // audio-only calls. Double-click restores the automatic split.
        if root.call-here: Rectangle {
            height: 8px;
            background: call-panel-handle.has-hover || call-panel-handle.pressed || root.combined-resize-hover
                ? Theme.outline-variant : transparent;
            call-panel-handle := TouchArea {
                mouse-cursor: row-resize;
                property <length> start-h;
                property <length> start-y;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        self.start-h = root.call-panel-shown-h;
                        self.start-y = self.absolute-position.y + self.mouse-y;
                    }
                }
                moved => {
                    if self.pressed {
                        root.call-panel-dragged = true;
                        root.call-panel-h = clamp(
                            self.start-h + self.absolute-position.y + self.mouse-y - self.start-y,
                            root.call-panel-min,
                            max(root.call-panel-min, root.height - 240px)
                        );
                    }
                }
                double-clicked => { root.call-panel-dragged = false; }
            }
            // At the divider's junction, a diagonal drag resizes the call
            // height and channel rail width together. The separate handles
            // remain available for one-axis adjustments.
            Rectangle {
                x: -4px;
                y: -5px;
                width: 18px;
                height: 18px;
                background: transparent;
                corner-grip := TouchArea {
                    mouse-cursor: nwse-resize;
                    changed has-hover => { root.combined-resize-hover = self.has-hover || self.pressed; }
                    changed pressed => { root.combined-resize-hover = self.has-hover || self.pressed; }
                    property <length> start-h;
                    property <length> start-w;
                    property <length> start-x;
                    property <length> start-y;
                    moved => {
                        if self.pressed {
                            root.sidebar-width = clamp(
                                self.start-w + self.absolute-position.x + self.mouse-x - self.start-x,
                                200px, 420px
                            );
                            root.call-panel-dragged = true;
                            root.call-panel-h = clamp(
                                self.start-h + self.absolute-position.y + self.mouse-y - self.start-y,
                                root.call-panel-min,
                                max(root.call-panel-min, root.height - 240px)
                            );
                        }
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            self.start-h = root.call-panel-shown-h;
                            self.start-w = root.sidebar-width;
                            self.start-x = self.absolute-position.x + self.mouse-x;
                            self.start-y = self.absolute-position.y + self.mouse-y;
                        }
                        if e.kind == PointerEventKind.up {
                            root.sidebar-width-committed();
                        }
                    }
                    double-clicked => {
                        root.sidebar-width = Theme.sidebar-width;
                        root.call-panel-dragged = false;
                        root.sidebar-width-committed();
                    }
                }
            }
        }
        if root.nudge != "": Rectangle {
            height: Theme.row-member;
            border-radius: Theme.radius-lg;
            background: Theme.primary-container;
            HorizontalLayout {
                padding-left: Theme.gap-lg;
                padding-right: Theme.gap-md;
                spacing: Theme.gap-md;
                Icon { text: Icons.shield; color: Theme.on-primary-container; }
                Text {
                    text: root.nudge;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    color: Theme.on-primary-container;
                    overflow: elide;
                }
                Text {
                    text: "Don't suggest again";
                    vertical-alignment: center;
                    color: Theme.on-primary-container;
                    font-size: Theme.text-small;
                    TouchArea { mouse-cursor: pointer; clicked => { root.dismiss-nudge(true); } }
                }
                IconButton {
                    glyph: Icons.close;
                    tint: Theme.on-primary-container;
                    clicked => { root.dismiss-nudge(false); }
                }
            }
        }
        // A plain scroll view: every loaded row is laid out, so heights are
        // exact and the wheel isn't fought (a virtualized ListView's
        // estimated heights broke scrolling). Memory is saved where it
        // matters: each row says whether it crosses the view's top or bottom
        // edge, giving the visible range, and only rows near it get pictures.
        // A forum has no messages of its own: its posts are listed instead.
        if root.is-forum: ForumView {
            vertical-stretch: 1;
            posts: root.forum-posts;
            filter-tags: root.forum-filter-tags;
            sort-labels: root.forum-sort-labels;
            sort-index: root.forum-sort-index;
            can-post: root.can-thread;
            has-older: root.forum-has-older;
            loading: root.forum-loading;
            failed: root.forum-failed;
            loading-older: root.forum-loading-older;
            open-post(i) => { root.forum-open-post(i); }
            toggle-tag(i) => { root.forum-toggle-tag(i); }
            set-sort(i) => { root.forum-set-sort(i); }
            load-older() => { root.forum-load-older(); }
            new-post() => { root.new-post(); }
        }
        list := ScrollView {
            // Out of the layout for a forum.
            max-height: root.is-forum ? 0px : 1000000px;
            vertical-stretch: root.is-forum ? 0 : 1;
            // Small on purpose: its content is every loaded row, and that as
            // its preferred height left no room to share, so the call's video
            // above never grew past its minimum (stretch shares only spare room).
            preferred-height: 120px;
            // A message row: padding, the avatar column and the gap beside it.
            property <length> text-width: self.visible-width - 3 * Theme.gap-lg - Theme.avatar;
            init => { Select.width-changed(self.text-width); }
            changed text-width => { Select.width-changed(self.text-width); }
            // When heights change (messages arrive, text wraps, pictures load,
            // rows get measured, the window resizes): at the bottom, stay
            // there; away from it, keep the distance to it, so pages loaded
            // above don't move the view. Only size changes move it, so nothing
            // fights the wheel.
            changed content-height => { root.settle(); }
            // A selection dragged past the top or bottom edge scrolls the
            // view, faster the further out, as a browser does; the blocks then
            // under the pointer extend it. Runs only while the drag is out.
            property <length> drag-out: !Select.dragging ? 0px
                : Select.py < self.absolute-position.y ? Select.py - self.absolute-position.y
                : Select.py > self.absolute-position.y + self.visible-height
                    ? Select.py - self.absolute-position.y - self.visible-height
                : 0px;
            Timer {
                interval: 16ms;
                running: list.drag-out != 0px;
                triggered => {
                    list.content-y = max(min(0px, list.visible-height - list.content-height),
                        min(0px, list.content-y - max(-40px, min(40px, list.drag-out / 3))));
                }
            }
            changed visible-height => { root.settle(); }
            // Wherever the view moved (wheel, drag, or our own scrolling to
            // the bottom), see where it is: `scrolled` doesn't fire for the
            // mouse wheel, so relying on it left the view thinking it was at
            // the bottom and pulled it back there.
            changed content-y => {
                root.from-bottom = self.content-height + self.content-y;
                root.at-bottom = root.from-bottom <= self.visible-height + 4px;
                root.near-top = self.content-y > -max(200px, self.visible-height);
            }
            // Sized to its content explicitly: left to itself, the scroll
            // area under-measured it and the last message was cut off.
            content-height: messages.preferred-height;
            // Never sideways: anything too wide (a long code line) is cut, as
            // the list's width is the view's.
            content-width: self.visible-width;
            messages := VerticalLayout {
            width: list.visible-width;
            height: self.preferred-height;
            for message[i] in root.messages: VerticalLayout {
                // Where it sits in the view, for the visible range.
                property <length> view-y: self.y + list.content-y;
                function report() {
                    if self.view-y <= 0px && self.view-y + self.height > 0px { root.top-row = i; }
                    if self.view-y < list.visible-height
                        && (self.view-y + self.height >= list.visible-height || i == root.messages.length - 1) {
                        root.bottom-row = i;
                    }
                }
                init => { self.report(); }
                changed view-y => { self.report(); }
                changed height => { self.report(); }
                // The first row starts the history, the last ends with a gap.
                if i == 0 && root.reached-start: Text {
                    x: Theme.gap-lg;
                    height: 40px;
                    vertical-alignment: center;
                    text: "This is the start of the conversation.";
                    color: Theme.outline;
                }
                // Jumped to: scroll here (a little below the top) and flash, as
                // Godwit. A jump rebuilds the row, so it starts with the number
                // set (`changed` wouldn't fire): a one-shot timer acts once the
                // row is laid out.
                property <bool> to-jump: message.jump != 0;
                property <bool> flash;
                Timer {
                    interval: 1ms;
                    running: parent.to-jump;
                    triggered => {
                        list.content-y = max(min(0px, list.visible-height - list.content-height), 48px - parent.y);
                        parent.flash = true;
                        parent.to-jump = false;
                    }
                }
                Timer {
                    interval: 1600ms;
                    running: parent.flash;
                    triggered => { parent.flash = false; }
                }
                // Godwit's dividers: 17 px above and below a 1 px line; the
                // date centred on it, "NEW" as a pill at its start.
                if message.divider-date != "" || message.divider-new: Rectangle {
                    height: 35px;
                    Rectangle {
                        x: 8px;
                        width: parent.width - 20px;
                        height: 1px;
                        background: message.divider-new ? Theme.primary : Theme.outline-variant;
                    }
                    if message.divider-date != "": Rectangle {
                        width: date.preferred-width + 10px;
                        height: date.preferred-height + 2px;
                        border-radius: Theme.radius-md;
                        background: Theme.surface-lowest;
                        date := Text { text: message.divider-date; font-size: Theme.text-caption; font-weight: 600; color: Theme.outline; }
                    }
                    if message.divider-new: Rectangle {
                        x: 8px;
                        width: new.preferred-width + 12px;
                        height: new.preferred-height + 2px;
                        border-radius: self.height / 2;
                        background: Theme.primary;
                        new := Text { text: "NEW"; font-size: Theme.text-tiny; font-weight: 600; color: Theme.on-primary; }
                    }
                }
                if message.blocked-count > 0: Rectangle {
                    height: Theme.message-size * 2;
                    Text {
                        x: Theme.gap-lg;
                        width: parent.width - 2 * Theme.gap-lg;
                        height: parent.height;
                        vertical-alignment: center;
                        overflow: elide;
                        text: message.blocked-count == 1 ? "1 blocked message" : message.blocked-count + " blocked messages";
                        font-size: Theme.message-size;
                        color: Theme.on-surface-variant;
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.link-clicked(i, "godwit://reveal-blocked" /* view::REVEAL_BLOCKED */); } }
                }
                if message.blocked-count == 0: MessageRow {
                    flash: parent.flash;
                    message: message;
                    row-number: i;
                    can-react: root.can-react;
                    can-mark-unread: root.can-mark-unread;
                    can-forward: root.can-forward;
                    can-reply: root.can-reply;
                    can-edit: root.can-edit;
                    can-delete: root.can-delete;
                    can-delete-others: root.can-delete-others;
                    can-pin: root.can-pin;
                    can-moderate-reactions: root.can-moderate-reactions;
                    pin(pinned) => { root.pin(i, pinned); }
                    can-report: root.can-report;
                    report => { root.report(i); }
                    can-thread: root.can-thread && !root.is-forum;
                    create-thread => { root.create-thread(i); }
                    reply => { root.reply(i); }
                    edit => { root.edit(i); }
                    // Shift skips the question, as officially.
                    delete(skip) => { if skip { root.delete(i); } else { root.confirm-delete = i; } }
                    react(r) => { root.react(i, r); }
                    remove-reactions(r) => { root.remove-reactions(i, r); }
                    remove-all-reactions => { root.remove-all-reactions(i); }
                    open-picker => { root.open-picker(i); }
                    jump-to-reply => { root.jump-to-reply(i); }
                    open-attachment(a) => { root.open-attachment(i, a); }
                    link-clicked(url) => { root.link-clicked(i, url); }
                    play-inline(url, kind) => { root.play-inline(url, kind); }
                    player-fullscreen(url) => { root.player-fullscreen(url); }
                    join-invite(code) => { root.join-invite(code); }
                    join-activity(url) => { root.join-activity(url); }
                    // Typing on selected text goes on in the composer.
                    typed(t) => { root.type-in-composer(t); }
                    player-pointer(url, x, y, down) => { root.player-pointer(url, x, y, down); }
                    player-move(url, x, y) => { root.player-move(url, x, y); }
                    open-profile => { root.open-profile(i); }
                    mark-unread => { root.mark-unread(i); }
                    forward => { root.forward-message(i); }
                    end-poll => { root.end-poll(i); }
                    copy-text => { root.copy-text(i); }
                    copy-link => { root.copy-link(i); }
                }
                if i == root.messages.length - 1: Rectangle { height: Theme.gap-md; }
            }
            }
        }
        Rectangle {
            height: 20px;
            if !root.failed || root.loading: Text {
                x: Theme.gap-lg;
                text: root.loading ? "Loading…" : root.offline != "" ? root.offline : root.typing;
                color: root.offline != "" && !root.loading ? Theme.outline : Theme.on-surface-variant;
                font-size: Theme.text-small;
            }
            if root.failed && !root.loading: HorizontalLayout {
                x: Theme.gap-lg;
                spacing: Theme.space-3;
                Text { text: "Couldn't load messages."; color: Theme.error; font-size: Theme.text-small; vertical-alignment: center; }
                Text {
                    text: "Try again";
                    color: Theme.primary;
                    font-size: Theme.text-small;
                    font-weight: 600;
                    vertical-alignment: center;
                    TouchArea { mouse-cursor: pointer; clicked => { root.load-earlier(); } }
                }
            }
        }
        // Lined up with the composer below it.
        if root.compose-label != "": HorizontalLayout {
            padding-left: Theme.gap-lg;
            padding-right: Theme.gap-lg;
            padding-bottom: Theme.gap-sm;
            Rectangle {
                height: 36px;
                border-radius: Theme.radius-lg;
                background: Theme.primary-container;
                HorizontalLayout {
                    padding-left: Theme.gap-lg;
                    padding-right: Theme.gap-lg;
                    spacing: Theme.gap-md;
                    Icon { text: Icons.reply; font-size: Theme.text-title; color: Theme.on-primary-container; width: 20px; }
                    Text {
                        text: root.compose-label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        color: Theme.on-primary-container;
                        overflow: elide;
                    }
                    IconButton { glyph: Icons.close; clicked => { root.cancel-compose(); } }
                }
            }
        }
        if root.files.length > 0: HorizontalLayout {
            padding-left: Theme.gap-lg;
            padding-right: Theme.gap-lg;
            padding-bottom: Theme.gap-md;
            spacing: Theme.gap-md;
            alignment: start;
            for f[i] in root.files: Rectangle {
                height: 52px;
                width: min(240px, chip.preferred-width);
                border-radius: Theme.radius-md;
                background: Theme.surface-high;
                chip := HorizontalLayout {
                    padding-left: Theme.gap-md;
                    spacing: Theme.gap-sm;
                    Icon { text: Icons.file; color: Theme.on-surface-variant; width: Theme.icon-large; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: f.name; overflow: elide; color: Theme.on-surface; }
                        Text { text: f.detail; font-size: Theme.text-caption; color: Theme.outline; }
                    }
                    IconButton { y: (parent.height - self.height) / 2; glyph: Icons.close; clicked => { root.remove-file(i); } }
                }
            }
        }
        Rectangle {
            // A forum has no composer (its posts are started from the list).
            visible: !root.is-forum;
            height: root.is-forum ? 0px : composer.preferred-height + Theme.gap-md * 2;
            attach-menu := PopupWindow {
                x: Theme.gap-lg;
                y: -88px;
                MenuPanel {
                    if root.can-attach: MenuRow { glyph: Icons.attach; label: "Upload a file"; clicked => { root.attach(); } }
                    MenuRow { glyph: Icons.notes; label: "Create poll"; clicked => { root.create-poll(); } }
                }
            }
            composer := HorizontalLayout {
                padding-left: Theme.gap-lg;
                padding-right: Theme.gap-lg;
                padding-bottom: Theme.gap-md;
                spacing: Theme.gap-md;
                // With polls here the button opens a small menu (as the
                // official "+"): upload a file, or create a poll.
                if root.can-attach || root.can-poll: IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.attach;
                    tooltip: root.can-poll ? "Attach" : "Attach files";
                    clicked => {
                        if root.can-poll { attach-menu.show(); } else { root.attach(); }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    y: (parent.height - self.height) / 2;
                    // Shrinks with the window down to this, never below (the
                    // buttons beside it stay on screen).
                    min-width: 120px;
                    // Grows with the draft up to a cap, then scrolls inside
                    // (the input used to spill over the chat above).
                    height: min(max(Theme.row-member, input.preferred-height + Theme.space-7), 220px);
                    border-radius: Theme.radius-lg;
                    background: Theme.surface;
                    // A ScrollView, not a bare Flickable: the wheel scrolls it
                        // and a scrollbar shows once the draft passes the cap.
                    draft-scroll := ScrollView {
                        x: Theme.gap-lg;
                        width: parent.width - Theme.gap-lg;
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        // 12px above the text; the 12px below is the one
                        // Material's ScrollView always keeps for its bar.
                        content-height: input.height + 12px;
                    input := TextInput {
                        // Exactly the text's height, padded from outside: with
                        // spare height and centred text, Up/Down landed on the
                        // wrong line (Slint's line moves ignore the offset).
                        y: 12px;
                        width: draft-scroll.visible-width - Theme.gap-lg;
                        height: self.preferred-height;
                        // Keep the cursor in view while typing past the cap,
                        // as Slint's own TextEdit does.
                        cursor-position-changed(pos) => {
                            if self.y + pos.y + draft-scroll.content-y < 0 {
                                draft-scroll.content-y = min(0px, -pos.y);
                            } else if self.y + pos.y + self.font-size * 1.5 + draft-scroll.content-y > draft-scroll.visible-height {
                                draft-scroll.content-y = min(0px, draft-scroll.visible-height - self.y - pos.y - self.font-size * 1.5);
                            }
                        }
                        text <=> root.draft;
                        // The software renderer draws outlines, not COLR emoji.
                        // Use our bundled outline emoji face; text falls back
                        // to the normal UI fonts for letters it doesn't cover.
                        font-family: "Noto Emoji";
                        enabled: root.can-send;
                        color: Theme.on-surface;
                        font-size: Theme.message-size;
                        wrap: word-wrap;
                        single-line: false;
                        edited => { root.draft-edited(self.text); }
                        // Enter sends; Shift+Enter makes a new line; Escape
                        // drops a reply or edit.
                        key-pressed(event) => {
                            // Ctrl+C with chat text selected and none here: the chat's.
                            if event.modifiers.control && (event.text == "c" || event.text == "C") && Select.active
                                && self.anchor-position-byte-offset == self.cursor-position-byte-offset {
                                Select.copy();
                                return accept;
                            }
                            if event.text == Key.Escape && Select.active {
                                Select.clear();
                                return accept;
                            }
                            if event.modifiers.control && (event.text == "v" || event.text == "V") && root.can-attach {
                                if root.paste-files() {
                                    return accept;
                                }
                            }
                            if event.text == "\n" && !event.modifiers.shift {
                                root.send();
                                return accept;
                            }

                            // Page Up/Down scroll the chat, not the draft.
                            if event.text == Key.PageUp {
                                root.scroll-page(-1);
                                return accept;
                            }
                            if event.text == Key.PageDown {
                                root.scroll-page(1);
                                return accept;
                            }
                            // Arrow-up in an empty box edits our last message, as officially.
                            if event.text == Key.UpArrow && self.text == "" {
                                root.edit-last();
                                return accept;
                            }
                            if event.text == Key.Escape && root.compose-label != "" {
                                root.cancel-compose();
                                return accept;
                            }
                            reject
                        }
                    }
                    }
                    // Elided, not clipped: an unwrapped text's minimum is its
                    // whole length, which held the box (and the buttons) wide.
                    if input.text == "": Text {
                        // At the input's own place: the ScrollView insets it,
                        // so a fixed x left the cursor inside the first letter.
                        x: input.absolute-position.x - parent.absolute-position.x;
                        y: input.absolute-position.y - parent.absolute-position.y;
                        width: parent.width - self.x - Theme.gap-lg;
                        overflow: elide;
                        text: !root.can-send ? "You can't send messages here"
                            : root.as-account != "" ? "Message " + root.title + " as " + root.as-account
                            : "Message " + root.title;
                        color: Theme.outline;
                        font-size: Theme.message-size;
                    }
                }
                // The official GIF button: only while there's nothing to send.
                if (Gifs.available || Gifs.stickers-available) && root.can-send && input.text == "" && root.files.length == 0: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 36px;
                    height: 36px;
                    border-radius: Theme.radius-sm;
                    background: gif-touch.has-hover ? Theme.surface-highest : transparent;
                    Rectangle {
                        width: 28px;
                        height: 18px;
                        border-radius: Theme.radius-xs;
                        border-width: 1.5px;
                        border-color: Theme.on-surface-variant;
                        Text { text: "GIF"; font-size: Theme.text-tiny; font-weight: 700; color: Theme.on-surface-variant; }
                    }
                    gif-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Gifs.open = true;
                            Gifs.tab = Gifs.available ? 0 : 1;
                            Gifs.opened();
                            Gifs.tab-changed();
                        }
                    }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.emoji;
                    tooltip: "Emoji";
                    enabled: root.can-send;
                    clicked => {
                        root.capture-composer(input.anchor-position-byte-offset, input.cursor-position-byte-offset);
                        root.open-picker(-1);
                    }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.send;
                    tooltip: "Send";
                    enabled: root.can-send && (input.text != "" || root.files.length > 0);tint: Theme.primary;
                    clicked => { root.send(); }
                }
            }
        }
    }
    // "Jump to present", once more than two screens above the newest
    // message, as Godwit: back to the bottom, where the view then stays.
    if root.detached || (!root.at-bottom && root.from-bottom - list.visible-height > list.visible-height * 2): Rectangle {
        x: (parent.width - self.width) / 2;
        y: list.y + list.height - self.height - 12px;
        width: jump.preferred-width + 32px;
        height: 36px;
        border-radius: self.height / 2;
        background: Theme.primary;
        drop-shadow-blur: 6px;
        drop-shadow-color: Theme.shadow;
        jump := Text { text: "Jump to present"; color: Theme.on-primary; font-weight: 600; }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.at-bottom = true;
                root.settle();
                root.jump-to-present();
            }
        }
    }
    // The GIF picker, where the emoji picker opens.
    if Gifs.open: Rectangle {
        TouchArea {
            clicked => { Gifs.open = false; }
            scroll-event(e) => { accept }
        }
        GifPicker {
            x: parent.width - self.width - 16px;
            y: parent.height - self.height - 72px;
        }
    }
    // The emoji picker, above the composer's right end.
    if root.picker-open: Rectangle {
        TouchArea { clicked => { root.close-picker(); } }
        EmojiPicker {
            x: parent.width - self.width - 16px;
            y: parent.height - self.height - 72px;
            rows: root.emoji-rows;
            search(q) => { root.picker-search(q); }
            picked(r, c) => { root.picker-picked(r, c); }
            scrolled-to(r) => { root.picker-scrolled(r); }
            escape => { root.close-picker(); }
        }
    }
    // Someone's sound here: volume 0–200% and a mute that only we hear.
    member-sound := PopupWindow {
        x: min(root.sound-x, root.width - 260px);
        y: min(root.sound-y, root.height - 130px);
        width: 240px;
        close-policy: close-on-click-outside;
        // Sized by its contents: without a height of its own the panel
        // collapsed and the controls showed over the call, see-through.
        Rectangle {
            width: parent.width;
            height: sound-panel.preferred-height;
            border-radius: Theme.radius-md;
            background: Theme.surface-high;
            drop-shadow-blur: 6px;
            drop-shadow-color: Theme.shadow;
            sound-panel := VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-3;
                if root.sound-member >= 0 && root.sound-member < root.call-members.length: VerticalLayout {
                spacing: Theme.space-3;
                Text { text: root.call-members[root.sound-member].name; font-weight: 600; color: Theme.on-surface; overflow: elide; }
                HorizontalLayout {
                    spacing: Theme.space-3;
                    Text { text: "Volume"; color: Theme.on-surface-variant; vertical-alignment: center; }
                    volume := Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 2;
                        value: root.call-members[root.sound-member].volume;
                        changed(v) => { root.user-sound(root.sound-member, v, root.call-members[root.sound-member].local-muted, false); }
                        released(v) => { root.user-sound(root.sound-member, v, root.call-members[root.sound-member].local-muted, true); }
                    }
                    Text { text: round(volume.value * 100) + "%"; width: 40px; horizontal-alignment: right; color: Theme.on-surface; vertical-alignment: center; }
                }
                Button {
                    text: root.call-members[root.sound-member].local-muted ? "Unmute for me" : "Mute for me";
                    kind: "tonal";
                    clicked => {
                        root.user-sound(root.sound-member, root.call-members[root.sound-member].volume, !root.call-members[root.sound-member].local-muted, true);
                    }
                }
                }
            }
        }
    }
}
