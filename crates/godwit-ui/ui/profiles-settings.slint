import { Theme } from "theme.slint";
import { ProfileRowItem } from "types.slint";
import { Button, TextField, Toggle, ChoiceChip, SurfaceCard as Card, SectionHeading as Heading, SettingsRow as Row } from "widgets.slint";

// The page's rows and its answers, reached from Rust as a global (rows are
// numbered as listed: the app knows which profile or account each is).
export global ProfilesState {
    in property <[ProfileRowItem]> rows;
    in-out property <string> new-name;
    // The profile waiting for "Delete" to be confirmed ("" none), as the
    // app holds it (by id, so a refresh can't change which one it is).
    in property <string> removing-name;
    in property <string> removing-note;
    callback ask-delete(int);
    callback cancel-delete();
    callback rename(int, string);
    callback set-default(int);
    callback delete-profile();
    callback create(string);
    callback set-member(int, bool);
    // Switching: ask first, keep the other profiles connected (soft lock),
    // and whether their notifications say who and what.
    in property <bool> ask-switch;
    in property <bool> background;
    in property <bool> previews;
    callback set-ask-switch(bool);
    callback set-background(bool);
    callback set-previews(bool);
    // The switch dialog's "Don't ask again".
    in-out property <bool> dont-ask;
}

export component ProfilesPage inherits VerticalLayout {
    spacing: Theme.space-3;
    alignment: start;
    Heading { text: "Profiles"; }
    Text {
        text: ProfilesState.background
            ? "A profile is a set of accounts. The profiles not in use stay connected in the background: only their notifications show, and clicking one switches to its profile. An account can be in several profiles. The default profile opens when Godwit starts."
            : "A profile is a set of accounts. Switching to a profile connects only its accounts and disconnects the others. An account can be in several profiles. The default profile opens when Godwit starts.";
        wrap: word-wrap;
        color: Theme.on-surface-variant;
    }
    Card {
        VerticalLayout {
            spacing: Theme.space-5;
            Row {
                label: "Ask before switching";
                detail: "A switch that would end a call always asks.";
                Toggle {
                    checked: ProfilesState.ask-switch;
                    toggled(on) => { ProfilesState.set-ask-switch(on); }
                }
            }
            Row {
                label: "Keep other profiles connected";
                detail: "Their accounts stay connected in the background, so their notifications still come and switching is instant. Nothing else of theirs shows in the profile in use. Uses more memory and data.";
                wrap-label: true;
                Toggle {
                    checked: ProfilesState.background;
                    toggled(on) => { ProfilesState.set-background(on); }
                }
            }
            Row {
                label: "Show names and messages in their notifications";
                detail: "Off: a notification only names the profile and says what came.";
                wrap-label: true;
                Toggle {
                    enabled: ProfilesState.background;
                    checked: ProfilesState.previews;
                    toggled(on) => { ProfilesState.set-previews(on); }
                }
            }
        }
    }
    for r[i] in ProfilesState.rows: VerticalLayout {
        // A gap between one profile's accounts and the next profile.
        if r.header && i > 0: Rectangle { height: Theme.space-3; }
        if r.header: Card {
            HorizontalLayout {
                spacing: Theme.space-3;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: Theme.space-1;
                    TextField {
                        text: r.name;
                        placeholder: "Profile name";
                        // A rejected name (empty, unchanged) shows the profile's again:
                        // typing broke the binding above.
                        accepted => { ProfilesState.rename(i, self.text); self.text = r.name; }
                        blurred => { ProfilesState.rename(i, self.text); self.text = r.name; }
                    }
                    Text {
                        text: (r.current ? "In use · " : "") + r.detail;
                        font-size: Theme.text-small;
                        color: Theme.outline;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ChoiceChip {
                        label: r.default ? "Default" : "Make default";
                        chosen: r.default;
                        choose => { ProfilesState.set-default(i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Delete";
                        danger: true;
                        enabled: r.can-delete;
                        clicked => { ProfilesState.ask-delete(i); }
                    }
                }
            }
        }
        if !r.header: Row {
            label: r.label;
            detail: r.network;
            padding-left: Theme.space-5;
            padding-right: Theme.space-5;
            Toggle {
                checked: r.member;
                toggled(on) => { ProfilesState.set-member(i, on); }
            }
        }
    }
    Rectangle { height: Theme.space-3; }
    Heading { text: "New profile"; }
    HorizontalLayout {
        spacing: Theme.space-3;
        TextField {
            horizontal-stretch: 1;
            text <=> ProfilesState.new-name;
            placeholder: "Name";
            accepted => { ProfilesState.create(self.text); }
        }
        Button {
            text: "Add profile";
            kind: "tonal";
            enabled: ProfilesState.new-name != "";
            clicked => { ProfilesState.create(ProfilesState.new-name); }
        }
    }
}
