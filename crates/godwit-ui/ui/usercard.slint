import { Theme, Icons } from "theme.slint";
import { RoleItem, BlockItem, Select, MutualItem } from "types.slint";
import { Avatar, Button, IconButton, TextField } from "widgets.slint";
import { TextBlock } from "textblock.slint";

// Someone's profile card, as Godwit draws it: a 96 px banner (primary-
// container without one), the 80 px avatar ringed on its edge, the name,
// presence and status, role chips and the bio.
export component UserCard inherits Rectangle {
    in property <string> name;
    // Name, username, status and bio, laid out as message text (view::card_text).
    in property <[BlockItem]> blocks;
    in property <string> username;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <string> initials;
    in property <image> banner;
    in property <bool> has-banner;
    in property <color> presence;
    in property <string> status;
    in property <[RoleItem]> roles;
    in property <bool> has-bio;
    in property <string> account-details;
    in property <bool> me;
    in property <string> activity-join;
    in property <bool> can-invite-activity;
    // Where we stand (the official ProfileActions): 0 not friends, 1 friends
    // (or a network without friends), 2 they asked, 3 we asked, 4 blocked,
    // 5 unused, 6 a bot.
    in property <int> relationship;
    // Their other accounts, when linked ("Also on Signal").
    in property <string> linked;
    in property <bool> favourite;
    callback toggle-favourite();
    // Seen in a server where we outrank them (the official UserContextMenu).
    in property <bool> can-kick;
    in property <bool> can-ban;
    // The member menu: roles, timeout (timed-out offers lifting it) and server nickname.
    in property <bool> can-roles;
    in property <bool> can-timeout;
    in property <bool> timed-out;
    in property <bool> can-nickname;
    callback edit-roles();
    callback timeout();
    callback remove-timeout();
    callback edit-nickname();
    in property <bool> can-remove-group-member;
    in property <bool> can-transfer-group-ownership;
    // The card may block them (the official UserContextMenu's safety group),
    // and we have: Unblock instead.
    in property <bool> can-block;
    in property <bool> blocked;
    in property <bool> can-ignore;
    in property <bool> ignored;
    // The network takes reports about them (never about us or its staff).
    in property <bool> can-report;
    callback report();
    // Our private note on them (the official Note field): saved on Enter or
    // when the field loses focus.
    in property <bool> can-note;
    in-out property <string> note;
    callback save-note(string);
    // Every edit, so the shell can hold the text to the network's limit.
    callback note-edited(string);
    // Servers and friends we share with them; a click opens it.
    in property <[MutualItem]> mutual-servers;
    in property <[MutualItem]> mutual-friends;
    in property <[MutualItem]> mutual-groups;
    callback open-mutual-server(int);
    callback open-mutual-friend(int);
    callback open-mutual-group(int);
    callback kick();
    callback ban();
    callback remove-group-member();
    callback transfer-group-ownership();
    callback block-user();
    callback unblock-user();
    callback ignore-user();
    callback unignore-user();
    callback close();
    callback message();
    callback join-activity();
    callback invite-to-activity();
    callback add-friend();
    callback remove-friend();
    callback link();
    // Copies text (their username) to the clipboard.
    callback copy(string);

    // A light scrim; clicking outside or Escape closes the card.
    background: Theme.scrim-light;
    TouchArea {
        clicked => { root.close(); }
        scroll-event(e) => { accept }
    }
    // The card sits inside, so Escape still closes it while text in it
    // (a selected username) has the focus.
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close();
                return accept;
            }
            // Ctrl+C with text selected in the card (or the chat behind it).
            if e.modifiers.control && (e.text == "c" || e.text == "C") && Select.active {
                Select.copy();
                return accept;
            }
            reject
        }
    card := Rectangle {
        width: 340px;
        height: min(body.preferred-height, root.height - 48px);
        border-radius: Theme.radius-lg;
        background: Theme.surface-high;
        clip: true;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        TouchArea { }
        // The whole card scrolls (the wheel) once it's taller than the
        // window, so nothing below a long bio or many roles is cut off.
        Flickable {
        width: parent.width;
        height: parent.height;
        content-height: body.preferred-height;
        body := VerticalLayout {
            Rectangle {
                height: 96px;
                // Its own corners: a clip doesn't round children here.
                border-top-left-radius: 16px;
                border-top-right-radius: 16px;
                clip: true;
                background: Theme.primary-container;
                if root.has-banner: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.banner;
                    image-fit: cover;
                }
            }
            VerticalLayout {
                padding: Theme.gap-lg;
                padding-top: Theme.space-profile-top;
                spacing: Theme.space-3;
                // All of it selects as message text does (drag, double-click,
                // Ctrl+C), its emoji the pack's pictures: the same TextBlock.
                if root.blocks.length > 0: TextBlock {
                    block: root.blocks[0];
                    row-number: -2;
                    index: 0;
                    colour: Theme.on-surface;
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    if root.blocks.length > 1: TextBlock {
                        y: (parent.height - self.height) / 2;
                        horizontal-stretch: 1;
                        block: root.blocks[1];
                        row-number: -2;
                        index: 1;
                        colour: Theme.on-surface-variant;
                    }
                    if root.username != "": IconButton {
                        glyph: Icons.copy;
                        tooltip: "Copy username";
                        clicked => { root.copy(root.username); }
                    }
                }
                if root.status != "" && root.blocks.length > 2: TextBlock {
                    block: root.blocks[2];
                    row-number: -2;
                    index: 2;
                    colour: Theme.on-surface;
                }
                if root.activity-join != "" || (!root.me && root.can-invite-activity): HorizontalLayout {
                    spacing: Theme.space-2;
                    if root.activity-join != "": Button { text: "Join game"; kind: "tonal"; clicked => { root.join-activity(); } }
                    if !root.me && root.can-invite-activity: Button { text: "Invite to game"; kind: "text"; clicked => { root.invite-to-activity(); } }
                }
                if root.roles.length > 0: HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-2;
                    for r in root.roles: Rectangle {
                        height: 22px;
                        width: chip.preferred-width;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface-highest;
                        chip := HorizontalLayout {
                            padding-left: Theme.space-compact;
                            padding-right: Theme.space-compact;
                            spacing: Theme.space-2;
                            Rectangle {
                                y: (parent.height - 8px) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: Theme.radius-xs;
                                background: r.has-colour ? r.colour : Theme.outline;
                            }
                            Text { text: r.name; font-size: Theme.text-small; color: Theme.on-surface; vertical-alignment: center; }
                        }
                    }
                }
                // Its whole height (laid out at the card's width); links open.
                if root.has-bio && root.blocks.length > 3: TextBlock {
                    block: root.blocks[3];
                    row-number: -2;
                    index: 3;
                    colour: Theme.on-surface;
                }
                if root.account-details != "": Text {
                    text: root.account-details;
                    font-size: Theme.text-small;
                    color: Theme.on-surface-variant;
                }
                if root.can-note: VerticalLayout {
                    spacing: Theme.space-2;
                    Text { text: "Note"; font-size: Theme.text-small; font-weight: 600; color: Theme.on-surface-variant; }
                    TextField {
                        text <=> root.note;
                        placeholder: "Click to add a note (only you see it)";
                        edited(t) => { root.note-edited(t); }
                        accepted => { root.save-note(root.note); }
                        blurred => { root.save-note(root.note); }
                    }
                }
                if root.mutual-servers.length > 0: VerticalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: root.mutual-servers.length == 1 ? "1 mutual server" : root.mutual-servers.length + " mutual servers";
                        font-size: Theme.text-small; font-weight: 600; color: Theme.on-surface-variant;
                    }
                    for s[i] in root.mutual-servers: Rectangle {
                        height: 36px;
                        border-radius: Theme.radius-sm;
                        background: ta-s.has-hover ? Theme.surface-highest : transparent;
                        ta-s := TouchArea { clicked => { root.open-mutual-server(i); } }
                        HorizontalLayout {
                            padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: Theme.space-3;
                            Avatar { y: (parent.height - self.height) / 2; size: 28px; source: s.picture; has-image: s.has-picture; initials: s.initials; }
                            Text { text: s.name; font-size: Theme.text-body; color: Theme.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            if s.detail != "": Text { text: s.detail; font-size: Theme.text-small; color: Theme.on-surface-variant; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
                if root.mutual-friends.length > 0: VerticalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: root.mutual-friends.length == 1 ? "1 mutual friend" : root.mutual-friends.length + " mutual friends";
                        font-size: Theme.text-small; font-weight: 600; color: Theme.on-surface-variant;
                    }
                    for f[i] in root.mutual-friends: Rectangle {
                        height: 36px;
                        border-radius: Theme.radius-sm;
                        background: ta-f.has-hover ? Theme.surface-highest : transparent;
                        ta-f := TouchArea { clicked => { root.open-mutual-friend(i); } }
                        HorizontalLayout {
                            padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: Theme.space-3;
                            Avatar { y: (parent.height - self.height) / 2; size: 28px; source: f.picture; has-image: f.has-picture; initials: f.initials; }
                            Text { text: f.name; font-size: Theme.text-body; color: Theme.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }
                if root.mutual-groups.length > 0: VerticalLayout {
                    spacing: Theme.space-2;
                    Text { text: root.mutual-groups.length == 1 ? "1 mutual group" : root.mutual-groups.length + " mutual groups"; font-size: Theme.text-small; font-weight: 600; color: Theme.on-surface-variant; }
                    for g[i] in root.mutual-groups: Rectangle {
                        height: 36px;
                        border-radius: Theme.radius-sm;
                        background: ta-g.has-hover ? Theme.surface-highest : transparent;
                        ta-g := TouchArea { clicked => { root.open-mutual-group(i); } }
                        HorizontalLayout { padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: Theme.space-3;
                            Avatar { y: (parent.height - self.height) / 2; size: 28px; source: g.picture; has-image: g.has-picture; initials: g.initials; }
                            Text { text: g.name; font-size: Theme.text-body; color: Theme.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }
                if root.linked != "": Text { text: root.linked; font-size: Theme.text-small; color: Theme.on-surface-variant; }
                if root.linked != "" || !root.me: Button {
                    text: root.favourite ? "Remove from favourites" : "Add to favourites";
                    kind: "text";
                    clicked => { root.toggle-favourite(); }
                }
                if !root.me: HorizontalLayout {
                    spacing: Theme.space-3;
                    // Stoat only lets friends message each other (the official
                    // SDK's UserPermission), so others get a friend request.
                    if root.relationship == 1: Button { horizontal-stretch: 1; text: "Message"; kind: "filled"; clicked => { root.message(); } }
                    if root.relationship == 0: Button { horizontal-stretch: 1; text: "Add friend"; kind: "filled"; clicked => { root.add-friend(); } }
                    if root.relationship == 2: Button { horizontal-stretch: 1; text: "Accept friend request"; kind: "filled"; clicked => { root.add-friend(); } }
                    if root.relationship == 2: Button { text: "Decline"; kind: "text"; clicked => { root.remove-friend(); } }
                    if root.relationship == 3: Button { horizontal-stretch: 1; text: "Cancel friend request"; kind: "tonal"; clicked => { root.remove-friend(); } }
                    // Godwit never links on its own: this is how the user says
                    // "this is the same person as…".
                    Button { text: "Same person as…"; kind: "tonal"; clicked => { root.link(); } }
                }
                if !root.me && root.can-report: HorizontalLayout {
                    alignment: start;
                    Button { text: "Report user"; kind: "text"; danger: true; clicked => { root.report(); } }
                }
                if root.can-nickname || (!root.me && (root.can-roles || root.can-timeout)): HorizontalLayout {
                    spacing: Theme.space-3; alignment: start;
                    if !root.me && root.can-roles: Button { text: "Roles"; kind: "tonal"; clicked => { root.edit-roles(); } }
                    if !root.me && root.can-timeout && !root.timed-out: Button { text: "Timeout"; kind: "tonal"; clicked => { root.timeout(); } }
                    if !root.me && root.can-timeout && root.timed-out: Button { text: "Remove timeout"; kind: "tonal"; clicked => { root.remove-timeout(); } }
                    if root.can-nickname: Button { text: "Change nickname"; kind: "tonal"; clicked => { root.edit-nickname(); } }
                }
                if !root.me && (root.can-kick || root.can-ban): HorizontalLayout {
                    spacing: Theme.space-3; alignment: start;
                    if root.can-kick: Button { text: "Kick member"; kind: "text"; danger: true; clicked => { root.kick(); } }
                    if root.can-ban: Button { text: "Ban member"; kind: "text"; danger: true; clicked => { root.ban(); } }
                }
                if !root.me && root.can-remove-group-member: HorizontalLayout {
                    spacing: Theme.space-3; alignment: start;
                    Button { text: "Remove member"; kind: "text"; danger: true; clicked => { root.remove-group-member(); } }
                }
                if !root.me && (root.can-block || root.can-ignore): HorizontalLayout {
                    spacing: Theme.space-3; alignment: start;
                    if root.can-block && !root.blocked: Button { text: "Block user"; kind: "text"; danger: true; clicked => { root.block-user(); } }
                    if root.can-block && root.blocked: Button { text: "Unblock user"; kind: "text"; clicked => { root.unblock-user(); } }
                    if root.can-ignore && !root.ignored: Button { text: "Ignore user"; kind: "text"; clicked => { root.ignore-user(); } }
                    if root.can-ignore && root.ignored: Button { text: "Unignore user"; kind: "text"; clicked => { root.unignore-user(); } }
                }
                if !root.me && root.can-transfer-group-ownership: HorizontalLayout {
                    spacing: Theme.space-3; alignment: start;
                    Button { text: "Transfer group ownership"; kind: "text"; clicked => { root.transfer-group-ownership(); } }
                }
            }
        }
        // The avatar, ringed on the banner's bottom edge (outside the banner,
        // whose clip would cut it).
        Rectangle {
            x: 52px - 44px;
            y: 96px - 44px;
            width: 88px;
            height: 88px;
            border-radius: self.width / 2;
            background: Theme.surface-high;
            Avatar { size: 80px; source: root.avatar; has-image: root.has-avatar; initials: root.initials; }
            if root.presence != transparent: Rectangle {
                x: 64px;
                y: 64px;
                width: 18px;
                height: 18px;
                border-radius: self.width / 2;
                border-width: 3px;
                border-color: Theme.surface-high;
                background: root.presence;
            }
                }
        }
    }
    }
}
