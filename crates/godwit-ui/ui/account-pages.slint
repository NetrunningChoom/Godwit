// Settings → a Discord account → Privacy and Sessions: the network's own
// switches and signed-in devices, as its official client's pages.

import { Theme } from "theme.slint";
import { Button, Toggle, SurfaceCard as Card, SettingsRow, Select, TextField } from "widgets.slint";

// A claim in a network's privacy overview and the labels of its sources.
export struct PrivPara {
    text: string,
    why: string,
    sources: [string],
}

export struct PrivItem {
    label: string,
    detail: string,
    on: bool,
}

export struct SessItem {
    device: string,
    // "Amsterdam, NL · created Nov 4 · last used Nov 5", as available.
    detail: string,
}

// The pages' state and answers, reached from Rust as a global.
export global AccountPages {
    in property <[PrivItem]> privacy;
    in property <bool> privacy-loading;
    in property <string> privacy-error;
    callback toggle-privacy(int);
    in property <[SessItem]> sessions;
    in property <bool> sessions-loading;
    in property <string> sessions-error;
    // A device waiting for sign-out confirmation (-1 none, -2 all other devices).
    in-out property <int> confirm-session: -1;
    in-out property <int> rename-session: -1;
    callback log-out-session(int);
    callback log-out-session-with-proof(int, int, string);
    callback submit-session-rename(int, string);
    in property <string> security-email;
    in property <bool> security-totp;
    in property <bool> security-mfa;
    in property <bool> security-recovery;
    in property <string> security-error;
    in property <string> security-message;
    in property <string> security-secret;
    in property <image> security-qr;
    in property <[string]> recovery-codes;
    in-out property <int> security-dialog: 0;
    in-out property <string> security-value;
    in-out property <string> security-second;
    in-out property <string> security-proof-value;
    in-out property <int> security-proof-kind: 1;
    callback security-submit(int, string, string, int, string);
}

export component AccountSecurityPage inherits VerticalLayout {
    spacing: Theme.space-4;
    Text { text: "Change the credentials and two-factor protection for this account."; wrap: word-wrap; color: Theme.on-surface-variant; }
    if AccountPages.security-email != "": Text { text: "Email · " + AccountPages.security-email; color: Theme.on-surface; }
    if AccountPages.security-error != "": Text { text: AccountPages.security-error; wrap: word-wrap; color: Theme.error; }
    if AccountPages.security-message != "": Text { text: AccountPages.security-message; color: Theme.on-surface-variant; }
    Card { VerticalLayout { spacing: Theme.space-3;
        Text { text: "Account credentials"; font-weight: 600; color: Theme.on-surface; }
        HorizontalLayout { spacing: Theme.space-2;
            Button { text: "Change username"; clicked => { AccountPages.security-dialog = 1; AccountPages.security-value = ""; AccountPages.security-second = ""; AccountPages.security-proof-value = ""; } }
            Button { text: "Change email"; clicked => { AccountPages.security-dialog = 2; AccountPages.security-value = ""; AccountPages.security-second = ""; AccountPages.security-proof-value = ""; } }
            Button { text: "Change password"; clicked => { AccountPages.security-dialog = 3; AccountPages.security-value = ""; AccountPages.security-second = ""; AccountPages.security-proof-value = ""; } }
        }
    } }
    Card { VerticalLayout { spacing: Theme.space-3;
        Text { text: "Two-factor authentication"; font-weight: 600; color: Theme.on-surface; }
        Text { text: AccountPages.security-totp ? "Authenticator enabled" : "Authenticator not enabled"; color: Theme.on-surface-variant; }
        HorizontalLayout { spacing: Theme.space-2;
            if !AccountPages.security-totp: Button { text: "Set up authenticator"; clicked => { AccountPages.security-dialog = 4; AccountPages.security-value = ""; } }
            if AccountPages.security-totp: Button { text: "Remove authenticator"; danger: true; clicked => { AccountPages.security-dialog = 8; AccountPages.security-value = ""; } }
            if AccountPages.security-totp && AccountPages.security-recovery: Button { text: "View recovery codes"; clicked => { AccountPages.security-dialog = 6; AccountPages.security-value = ""; } }
            if AccountPages.security-totp: Button { text: "Regenerate recovery codes"; clicked => { AccountPages.security-dialog = 7; AccountPages.security-value = ""; } }
        }
    } }
    if AccountPages.security-secret != "": Card { VerticalLayout { Text { text: "Authenticator secret"; font-weight: 600; color: Theme.on-surface; } if AccountPages.security-qr.width > 0: Image { source: AccountPages.security-qr; width: 220px; height: 220px; image-fit: contain; image-rendering: pixelated; } Text { text: AccountPages.security-secret; color: Theme.on-surface; } Text { text: "Scan the code or enter this secret in your authenticator app, then confirm its current code."; wrap: word-wrap; color: Theme.on-surface-variant; } Button { text: "Confirm setup"; clicked => { AccountPages.security-dialog = 5; AccountPages.security-value = ""; AccountPages.security-second = ""; } } } }
    if AccountPages.recovery-codes.length > 0: Card { VerticalLayout { Text { text: "Recovery codes · store these somewhere safe"; font-weight: 600; color: Theme.on-surface; } for code in AccountPages.recovery-codes: Text { text: code; color: Theme.on-surface; } } }
    if AccountPages.security-dialog > 0: Card { VerticalLayout { spacing: Theme.space-3;
        Text { text: AccountPages.security-dialog == 1 ? "Change username" : AccountPages.security-dialog == 2 ? "Change email" : AccountPages.security-dialog == 3 ? "Change password" : AccountPages.security-dialog == 4 ? "Set up authenticator" : AccountPages.security-dialog == 5 ? "Confirm authenticator" : AccountPages.security-dialog == 6 ? "View recovery codes" : AccountPages.security-dialog == 7 ? "Regenerate recovery codes" : "Remove authenticator"; font-weight: 600; color: Theme.on-surface; }
        TextField { width: 360px; text <=> AccountPages.security-value; placeholder: AccountPages.security-dialog == 1 ? "New username" : AccountPages.security-dialog == 2 ? "New email" : "Password or authenticator code"; password: AccountPages.security-dialog != 1 && AccountPages.security-dialog != 2; }
        if AccountPages.security-dialog == 1 || AccountPages.security-dialog == 2 || AccountPages.security-dialog == 3: TextField { width: 360px; text <=> AccountPages.security-second; placeholder: "Current password"; password: true; }
        if AccountPages.security-dialog == 5: TextField { width: 360px; text <=> AccountPages.security-second; placeholder: "Authenticator code"; password: true; }
        if AccountPages.security-dialog == 1 || AccountPages.security-dialog == 2 || AccountPages.security-dialog == 3 || AccountPages.security-dialog == 4 || AccountPages.security-dialog == 6 || AccountPages.security-dialog == 7 || AccountPages.security-dialog == 8: Select { width: 300px; model: ["Password", "Authenticator code", "Recovery code"]; current-index <=> AccountPages.security-proof-kind; }
        if AccountPages.security-dialog == 1 || AccountPages.security-dialog == 2 || AccountPages.security-dialog == 3 || AccountPages.security-dialog == 4 || AccountPages.security-dialog == 6 || AccountPages.security-dialog == 7 || AccountPages.security-dialog == 8: TextField { width: 360px; text <=> AccountPages.security-proof-value; placeholder: "Password, authenticator code, or recovery code"; password: true; }
        HorizontalLayout { spacing: Theme.space-2;
            Button { text: "Cancel"; clicked => { AccountPages.security-dialog = 0; AccountPages.security-value = ""; AccountPages.security-second = ""; AccountPages.security-proof-value = ""; } }
            Button { text: "Continue"; enabled: AccountPages.security-value != "" && ((AccountPages.security-dialog != 1 && AccountPages.security-dialog != 2 && AccountPages.security-dialog != 3 && AccountPages.security-dialog != 5) || AccountPages.security-second != "") && ((AccountPages.security-dialog == 5) || (!AccountPages.security-mfa && AccountPages.security-dialog <= 3) || AccountPages.security-proof-value != ""); clicked => { AccountPages.security-submit(AccountPages.security-dialog, AccountPages.security-value, AccountPages.security-second, AccountPages.security-proof-kind, AccountPages.security-proof-value); AccountPages.security-value = ""; AccountPages.security-second = ""; AccountPages.security-proof-value = ""; AccountPages.security-dialog = 0; } }
        }
    } }
}

export component PrivacyPage inherits VerticalLayout {
    spacing: Theme.space-5;
    alignment: start;
    Text {
        text: "What Discord may do with your data, as its Data & Privacy page offers. Godwit switched the data-use ones off when you added the account, if you chose so.";
        wrap: word-wrap;
        color: Theme.on-surface-variant;
    }
    if AccountPages.privacy-loading: Text { text: "Asking Discord…"; color: Theme.on-surface-variant; }
    if AccountPages.privacy-error != "": Text { text: AccountPages.privacy-error; wrap: word-wrap; color: Theme.error; }
    for item[i] in AccountPages.privacy: Card {
        SettingsRow {
            spacing: Theme.space-4;
            label: item.label;
            show-empty-detail: true;
            detail: item.detail;
            detail-color: Theme.on-surface-variant;
            label-weight: 600;
            wrap-label: true;
            label-spacing: Theme.space-1;
            Toggle {
                y: (parent.height - self.height) / 2;
                checked: item.on;
                toggled(on) => { AccountPages.toggle-privacy(i); }
            }
        }
    }
}

export component SessionsPage inherits VerticalLayout {
    in property <string> session-network: "Discord";
    in property <bool> can-log-out-session: true;
    in property <bool> can-log-out-others: false;
    in property <bool> can-rename-session: false;
    in property <bool> requires-mfa: false;
    // Stoat OpenAPI's MFAResponse alternatives.
    in property <[string]> proof-methods: ["Password", "Authenticator code", "Recovery code"];
    in-out property <int> proof-method-index: 0;
    in-out property <string> proof-value;
    in-out property <string> rename-value;
    spacing: Theme.space-5;
    alignment: start;
    Text {
        text: "Where this account is signed in, as the official " + root.session-network + " client lists it.";
        wrap: word-wrap;
        color: Theme.on-surface-variant;
    }
    if AccountPages.sessions-loading: Text { text: "Loading " + root.session-network + " sessions…"; color: Theme.on-surface-variant; }
    if AccountPages.sessions-error != "": Text { text: AccountPages.sessions-error; wrap: word-wrap; color: Theme.error; }
    if root.can-log-out-others && AccountPages.sessions.length > 1 && AccountPages.confirm-session != -2: Button {
        text: "Log Out Other Sessions";
        kind: "text";
        danger: true;
        enabled: !AccountPages.sessions-loading;
        clicked => {
            AccountPages.confirm-session = -2;
            AccountPages.rename-session = -1;
        }
    }
    if root.can-log-out-others && AccountPages.confirm-session == -2: VerticalLayout {
        spacing: Theme.space-3;
        Text {
            text: "Sign out of every other session? This device will stay signed in.";
            wrap: word-wrap;
            color: Theme.on-surface-variant;
        }
        Select {
            width: 300px;
            model: root.proof-methods;
            current-index <=> root.proof-method-index;
        }
        TextField {
            width: 360px;
            text <=> root.proof-value;
            placeholder: "Password or code";
            password: true;
            autofocus: true;
        }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.space-3;
            Button {
                text: "Cancel";
                clicked => {
                    AccountPages.confirm-session = -1;
                    root.proof-value = "";
                }
            }
            Button {
                text: "Log Out Other Sessions";
                danger: true;
                enabled: root.proof-value != "";
                clicked => {
                    AccountPages.log-out-session-with-proof(-1, root.proof-method-index, root.proof-value);
                    root.proof-value = "";
                    AccountPages.confirm-session = -1;
                }
            }
        }
    }
    for s[i] in AccountPages.sessions: Card {
        SettingsRow {
            spacing: Theme.space-4;
            label: s.device;
            detail: s.detail;
            detail-color: Theme.on-surface-variant;
            label-weight: 600;
            wrap-label: true;
            label-spacing: Theme.space-1;
            if root.can-rename-session && AccountPages.rename-session != i && AccountPages.confirm-session != -2: Button {
                y: (parent.height - self.height) / 2;
                text: "Rename";
                kind: "text";
                enabled: !AccountPages.sessions-loading;
                clicked => {
                    AccountPages.confirm-session = -1;
                    AccountPages.rename-session = i;
                    root.rename-value = s.device;
                }
            }
            if root.can-log-out-session && AccountPages.confirm-session != i && AccountPages.confirm-session != -2: Button {
                y: (parent.height - self.height) / 2;
                text: "Sign out";
                kind: "text";
                danger: true;
                enabled: !AccountPages.sessions-loading;
                clicked => {
                    AccountPages.rename-session = -1;
                    AccountPages.confirm-session = i;
                }
            }
        }
        if root.can-rename-session && AccountPages.rename-session == i: VerticalLayout {
            spacing: Theme.space-3;
            TextField {
                width: 360px;
                text <=> root.rename-value;
                placeholder: "Session name";
                autofocus: true;
            }
            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-3;
                Button {
                    text: "Cancel";
                    clicked => { AccountPages.rename-session = -1; }
                }
                Button {
                    text: "Save";
                    enabled: root.rename-value != "" && root.rename-value != s.device;
                    clicked => {
                        AccountPages.submit-session-rename(i, root.rename-value);
                        AccountPages.rename-session = -1;
                        root.rename-value = "";
                    }
                }
            }
        }
        // It may be this very session: say so, as signing it out ends Godwit's.
        if root.can-log-out-session && !root.requires-mfa && AccountPages.confirm-session == i: VerticalLayout {
            spacing: Theme.space-3;
            Text {
                text: "Sign this device out? If it's this one, Godwit's sign-in ends too.";
                wrap: word-wrap;
                color: Theme.on-surface-variant;
            }
            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-3;
                Button { text: "Cancel"; clicked => { AccountPages.confirm-session = -1; } }
                Button {
                    text: "Sign out";
                    danger: true;
                    clicked => {
                        AccountPages.confirm-session = -1;
                        AccountPages.log-out-session(i);
                    }
                }
            }
        }
        if root.can-log-out-session && root.requires-mfa && AccountPages.confirm-session == i: VerticalLayout {
            spacing: Theme.space-3;
            Text {
                text: "Confirm your identity to sign this session out. Stoat requires a password, authenticator code, or recovery code.";
                wrap: word-wrap;
                color: Theme.on-surface-variant;
            }
            Select {
                width: 300px;
                model: root.proof-methods;
                current-index <=> root.proof-method-index;
            }
            TextField {
                width: 360px;
                text <=> root.proof-value;
                placeholder: "Password or code";
                password: true;
                autofocus: true;
            }
            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-3;
                Button {
                    text: "Cancel";
                    clicked => {
                        AccountPages.confirm-session = -1;
                        root.proof-value = "";
                    }
                }
                Button {
                    text: "Sign out";
                    danger: true;
                    enabled: root.proof-value != "";
                    clicked => {
                        AccountPages.log-out-session-with-proof(i, root.proof-method-index, root.proof-value);
                        root.proof-value = "";
                        AccountPages.confirm-session = -1;
                    }
                }
            }
        }
    }
}

// The official privacy page for the selected account's platform.
export component DataPrivacyPage inherits VerticalLayout {
    in property <string> policy-url;
    in property <string> policy-label;
    callback open-policy(string);
    // The network's own overview (empty when it has none).
    in property <string> overview-title;
    in property <string> overview-intro;
    in property <[PrivPara]> overview;
    in property <string> overview-caveat;
    callback open-source(int, int);
    spacing: Theme.space-5;
    alignment: start;
    Card {
        Text { text: "Official platform information"; font-size: Theme.text-title; font-weight: 600; color: Theme.on-surface; }
        Text {
            text: "The platform's own privacy policy, which describes what it collects, how it uses and shares it, how long it keeps it and how to make data requests. Third-party sources follow below.";
            wrap: word-wrap;
            color: Theme.on-surface-variant;
        }
        Button { text: root.policy-label; kind: "text"; clicked => { root.open-policy(root.policy-url); } }
    }
    if root.overview.length > 0: Card {
        Text { text: "Disclaimer · " + root.overview-title; font-size: Theme.text-title; font-weight: 600; color: Theme.on-surface; }
        if root.overview-intro != "": Text { text: root.overview-intro; wrap: word-wrap; color: Theme.on-surface; }
        for para[p] in root.overview: VerticalLayout {
            spacing: Theme.space-2;
            Text { text: para.text; wrap: word-wrap; color: Theme.on-surface-variant; }
            Text { text: para.why; wrap: word-wrap; font-size: Theme.text-label; color: Theme.outline; }
            HorizontalLayout {
                alignment: start;
                for label[s] in para.sources: Button { text: label; kind: "text"; clicked => { root.open-source(p, s); } }
            }
        }
        Text { text: root.overview-caveat; wrap: word-wrap; font-size: Theme.text-label; color: Theme.outline; }
    }
}
