import { ListView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { AudioMenuArrow, CallAudio } from "call-audio.slint";
import { RoomItem, DirectoryItem, SoundItem } from "types.slint";
import { Avatar, Badge, IconButton, Button, NetList, MenuPanel, MenuPlace, MenuRow, MenuDivider, TextField, EmojiText, NetworkSelect } from "widgets.slint";

// Rows as Godwit and the official sidebar draw them: 16 px corners,
// secondary-container when selected, surface-highest on hover.
component Entry inherits Rectangle {
    in property <bool> selected;
    callback clicked;
    // A right-click, where it happened.
    callback context(length, length);
    // Dragged up or down (Home's pins): how far the pointer is from where
    // it was pressed, counting the list scrolling under it; and, let go, done.
    in property <bool> draggable;
    in-out property <bool> dragging;
    in-out property <length> drag-y;
    callback dropped();
    // The list's visible edges (window coordinates): a drag held near one
    // asks the list to scroll that way.
    in property <length> edge-top;
    in property <length> edge-bottom;
    callback autoscroll(length);
    // The pointer, in window coordinates (kept while the list scrolls).
    property <length> pointer-y;
    function follow() {
        root.drag-y = root.pointer-y - touch.absolute-position.y - touch.pressed-y;
    }
    border-radius: Theme.radius-lg;
    background: root.selected ? Theme.secondary-container : touch.has-hover ? Theme.surface-highest : transparent;
    touch := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        changed has-hover => { root.hover-changed(self.has-hover); }
        // `clicked` comes before the release's pointer-event: a drag's
        // release isn't also a click.
        clicked => {
            if !root.dragging {
                root.clicked();
            }
        }
        // `moved` fires only while pressed: just what a drag needs.
        moved => {
            // A few pixels of wobble is still a click.
            if root.draggable && self.pressed && (root.dragging || abs(self.mouse-y - self.pressed-y) > 8px) {
                root.dragging = true;
                root.pointer-y = self.absolute-position.y + self.mouse-y;
                root.follow();
            }
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.context(self.mouse-x, self.mouse-y);
            }
            // Released anywhere, inside the entry or not, the drag ends.
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.dropped();
            }
            if e.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
    }
    // Scrolls only while a drag is held near an edge.
    Timer {
        interval: 30ms;
        running: root.dragging && (root.pointer-y < root.edge-top + 32px || root.pointer-y > root.edge-bottom - 32px);
        triggered => {
            root.autoscroll(root.pointer-y < root.edge-top + 32px ? -12px : 12px);
            root.follow();
        }
    }
    // The pointer arriving or leaving, for a card beside the row.
    callback hover-changed(bool);
    @children
}

// Home, Friends: 42 px, a 22 px symbol, a semibold label.
component MenuButton inherits Entry {
    in property <string> glyph;
    in property <string> label;
    // A count after the label (Notifications' unseen), none at 0.
    in property <int> badge;
    height: 42px;
    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        Icon {
            width: 20px;
            text: root.glyph;
            font-size: Theme.text-xl;
            color: root.selected ? Theme.on-secondary-container : Theme.on-surface;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-weight: 600;
            color: root.selected ? Theme.on-secondary-container : Theme.on-surface;
        }
        if root.badge > 0: Badge {
            y: (parent.height - self.height) / 2;
            count: root.badge;
        }
    }
}

component RoomRow inherits Rectangle {
    in property <RoomItem> room;
    // Now, in Unix seconds (for how long a channel's call has been going).
    in property <int> clock;
    // `secs` as 4:05 or 1:02:03, as the call timer.
    pure function elapsed(secs: int) -> string {
        (secs >= 3600 ? Math.floor(secs / 3600) + ":" : "")
            + (secs >= 3600 && Math.mod(Math.floor(secs / 60), 60) < 10 ? "0" : "")
            + Math.mod(Math.floor(secs / 60), 60) + ":"
            + (Math.mod(secs, 60) < 10 ? "0" : "") + Math.mod(secs, 60)
    }
    callback clicked;
    // Its menu's choice: 0 pin/unpin, 1 mark read, 2 mark unread, 3 hide/unhide, 6 channel settings, 8 move up, 9 move down.
    callback menu(int);
    callback toggle-hidden();
    // A category heading clicked: fold or unfold it.
    callback toggle-category();
    // A category's "Create channel here".
    callback create-here();
    // A pinned chat dragged this many places among the pins.
    callback move-pin(int);
    in property <length> edge-top;
    in property <length> edge-bottom;
    callback autoscroll(length);
    property <bool> dragging;
    property <length> drag-y;
    // The drag, for the list to draw the dragged row and where it lands
    // over the others (a row can't: the rows after it draw on top): on,
    // where (in the list), how tall, and the drop line's y (-1px: no move).
    callback drag-moved(bool, length, length, length);
    // The line goes in the gap between the pins it would land between.
    property <length> drop-line: root.drop-by == 0 ? -1px
        : root.y + (root.drop-by < 0 ? root.drop-by * root.stride : (root.drop-by + 1) * root.stride) - (Theme.space-1 + 2px) / 2;
    function report-drag() {
        root.drag-moved(root.dragging, root.y + root.drag-y, root.entry, root.drop-line);
    }
    changed drag-y => { root.report-drag(); }
    changed dragging => { root.report-drag(); }
    // Where a drag would land: rows of this row's height, clamped to the pins.
    property <length> stride: root.entry + Theme.space-1;
    property <int> drop-by: max(-room.pins-above, min(room.pins-below, round(root.drag-y / root.stride)));
    property <length> menu-x;
    property <length> menu-y;
    property <length> entry: room.kind == 2 ? 36px : 44px;
    height: room.header ? 26px : self.entry + room.occupants.length * 26px;
    // A category title: 13 px semibold, as the official sidebar.
    // A category's fold arrow, as the official sidebar.
    if room.header && !room.toggles-hidden: Icon {
        x: 4px;
        width: 16px;
        text: room.category-collapsed ? Icons.arrow-forward : Icons.expand;
        font-size: Theme.text-body;
        color: Theme.on-surface-variant;
        vertical-alignment: center;
    }
    if room.header && !room.toggles-hidden: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle-category(); }
        pointer-event(e) => {
            if room.category-menu && e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                room-menu.show();
            }
        }
    }
    if room.header: EmojiText {
        x: 20px;
        width: parent.width - 28px;
        text: room.name;
        runs: room.name-runs;
        font-size: Theme.text-label;
        font-weight: 600;
        color: room.toggles-hidden ? Theme.on-surface-variant : Theme.on-surface;
    }
    if room.header && room.toggles-hidden: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle-hidden(); }
    }
    // The menu's rows and dividers, counted (generously) for MenuPlace.
    property <int> menu-rows: room.header
        ? (room.can-create-here ? 1 : 0) + (room.can-reorder ? 2 : 0) + (room.can-manage ? 1 : 0)
        : 5 + (room.pins-above > 0 ? 1 : 0) + (room.pins-below > 0 ? 1 : 0) + (room.games ? 1 : 0)
            + (room.can-join-thread ? 1 : 0) + (room.can-leave ? 1 : 0) + (room.can-close ? 1 : 0)
            + (room.can-notify ? 1 + (room.kind == 2 ? 4 : 0) : 0)
            + (room.kind != 2 ? 1 : 0) + (room.can-reorder ? 2 : 0) + (room.can-manage ? 1 : 0);
    property <int> menu-dividers: room.header ? 0
        : (room.can-join-thread ? 1 : 0) + (room.can-leave ? 1 : 0) + (room.can-notify ? 1 : 0) + (room.can-notify && room.kind == 2 ? 1 : 0)
            + (room.kind != 2 ? 1 : 0) + (room.can-manage ? 1 : 0) + (room.can-reorder ? 1 : 0);
    room-menu := PopupWindow {
        x: MenuPlace.fit-x(root.menu-x, 260px, root.absolute-position.x);
        y: MenuPlace.fit-y(root.menu-y, MenuPlace.rows-h(root.menu-rows, root.menu-dividers), root.absolute-position.y);
        // One panel, its rows conditional: a PopupWindow takes its size
        // from its child's, and with only `if` children it had none, so
        // the menu opened 0×0 (invisible, and the next click closed it).
        MenuPanel {
            max-height: MenuPlace.limit();
            dismissed => { room-menu.close(); }
            // A category's menu: create in it, move it, and (Manage Channels
            // on it) rename or delete it in its settings.
            if room.header && room.can-create-here: MenuRow { glyph: Icons.tag; label: "Create channel"; clicked => { root.create-here(); } }
            if room.header && room.can-reorder: MenuRow { glyph: Icons.expand-less; label: "Move up"; clicked => { root.menu(8); } }
            if room.header && room.can-reorder: MenuRow { glyph: Icons.expand; label: "Move down"; clicked => { root.menu(9); } }
            if room.header && room.can-manage: MenuRow { glyph: Icons.settings; label: "Category settings"; clicked => { root.menu(6); } }
            // A server channel pins to Home, beside the DMs (a "general" to keep at hand).
            if !room.header: MenuRow {
                glyph: Icons.notes;
                label: room.kind == 2 ? (room.pinned ? "Unpin from Home" : "Pin to Home") : (room.pinned ? "Unpin" : "Pin to top");
                clicked => { root.menu(0); }
            }
            // Home's pins in the user's order (or drag them).
            if !room.header && room.pins-above > 0: MenuRow { glyph: Icons.expand-less; label: "Move pin up"; clicked => { root.menu(10); } }
            if !room.header && room.pins-below > 0: MenuRow { glyph: Icons.expand; label: "Move pin down"; clicked => { root.menu(11); } }
            if !room.header: MenuRow { glyph: Icons.chat; label: "Mark as read"; clicked => { root.menu(1); } }
            if !room.header: MenuRow { glyph: Icons.unread; label: "Mark as unread"; clicked => { root.menu(2); } }
            // Muzzle mode (Settings → Notifications) for just this chat.
            // Cycles: the network's rules → every message → off.
            if !room.header: MenuRow { glyph: Icons.unread; label: room.alerts == 1 ? "Notifications: all messages" : room.alerts == 2 ? "Notifications: off" : "Notifications: default"; clicked => { root.menu(5); } }
            if !room.header: MenuRow { glyph: Icons.schedule; label: room.muzzled ? "Unmuzzle repeat messages" : "Muzzle repeat messages"; clicked => { root.menu(4); } }
            if !room.header && room.games: MenuRow { glyph: Icons.group; label: "Games in common…"; clicked => { root.menu(7); } }
            if !room.header && room.can-join-thread: MenuDivider { }
            if !room.header && room.can-join-thread && !room.joined-thread: MenuRow { glyph: Icons.group; label: "Join Thread"; clicked => { root.menu(34); } }
            if !room.header && room.can-join-thread && room.joined-thread: MenuRow { glyph: Icons.logout; label: "Leave Thread"; clicked => { root.menu(35); } }
            if !room.header && room.can-leave: MenuDivider { }
            if !room.header && room.can-leave: MenuRow { glyph: Icons.logout; label: "Leave group"; danger: true; clicked => { root.menu(12); } }
            if !room.header && room.can-close: MenuRow { glyph: Icons.close; label: "Close DM"; danger: true; clicked => { root.menu(14); } }
            // The official channel menu's mute and notification settings. Mute opens
            // its durations in a second panel (menu 20..=24 for a while, 26 until
            // turned off); a muted chat shows how long and unmutes (27). 30..=33 the level.
            if !room.header && room.can-notify: MenuDivider { }
            if !room.header && room.can-notify && room.muted: MenuRow { glyph: Icons.volume-off; label: (room.kind == 2 ? "Unmute channel" : "Unmute") + (room.muted-until != "" ? " (muted " + room.muted-until + ")" : ""); clicked => { root.menu(27); } }
            if !room.header && room.can-notify && !room.muted: MenuRow { glyph: Icons.volume-off; label: room.kind == 2 ? "Mute channel…" : "Mute…"; clicked => { mute-menu.show(); } }
            if !room.header && room.can-notify && room.kind == 2: MenuDivider { }
            if !room.header && room.can-notify && room.kind == 2: MenuRow { glyph: Icons.notifications; label: (room.notify-level == 3 ? "✓ " : "") + "Use server default"; clicked => { root.menu(30); } }
            if !room.header && room.can-notify && room.kind == 2: MenuRow { glyph: Icons.chat; label: (room.notify-level == 0 ? "✓ " : "") + "Notify: all messages"; clicked => { root.menu(31); } }
            if !room.header && room.can-notify && room.kind == 2: MenuRow { glyph: Icons.at; label: (room.notify-level == 1 ? "✓ " : "") + "Notify: only @mentions"; clicked => { root.menu(32); } }
            if !room.header && room.can-notify && room.kind == 2: MenuRow { glyph: Icons.lock; label: (room.notify-level == 2 ? "✓ " : "") + "Notify: nothing"; clicked => { root.menu(33); } }
            if !room.header && room.kind != 2: MenuDivider { }
            if !room.header && room.kind != 2: MenuRow { glyph: Icons.close; label: room.hidden ? "Unhide" : "Hide"; clicked => { root.menu(3); } }
            // The official channel menu's "Open channel settings".
            if !room.header && room.can-manage: MenuDivider { }
            if !room.header && room.can-reorder: MenuDivider { }
            if !room.header && room.can-reorder: MenuRow { glyph: Icons.expand-less; label: "Move up"; clicked => { root.menu(8); } }
            if !room.header && room.can-reorder: MenuRow { glyph: Icons.expand; label: "Move down"; clicked => { root.menu(9); } }
            if !room.header && room.can-manage: MenuRow { glyph: Icons.settings; label: "Channel settings"; clicked => { root.menu(6); } }
        }
    }
    // The mute durations, opened by the menu's Mute row at the same spot. The
    // networks' mutes take these windows or "until turned off" (menu 20..=24, 26).
    mute-menu := PopupWindow {
        x: MenuPlace.fit-x(root.menu-x, 260px, root.absolute-position.x);
        y: MenuPlace.fit-y(root.menu-y, MenuPlace.rows-h(6, 0), root.absolute-position.y);
        MenuPanel {
            max-height: MenuPlace.limit();
            dismissed => { mute-menu.close(); }
            MenuRow { glyph: Icons.volume-off; label: "For 15 minutes"; clicked => { root.menu(20); } }
            MenuRow { glyph: Icons.volume-off; label: "For 1 hour"; clicked => { root.menu(21); } }
            MenuRow { glyph: Icons.volume-off; label: "For 3 hours"; clicked => { root.menu(22); } }
            MenuRow { glyph: Icons.volume-off; label: "For 8 hours"; clicked => { root.menu(23); } }
            MenuRow { glyph: Icons.volume-off; label: "For 24 hours"; clicked => { root.menu(24); } }
            MenuRow { glyph: Icons.volume-off; label: "Until I turn it back on"; clicked => { root.menu(26); } }
        }
    }
    // Who is in a busy voice channel, on a card beside its row while the
    // pointer is on it (Yapfast 0cf06a66): a summary line, then the first
    // eight with camera and LIVE marks, and how many more. A click, a drag or
    // the menu puts it away until the pointer comes back.
    property <bool> card-dismissed;
    property <bool> card-wanted: root.hovered && !root.dragging && !root.card-dismissed && room.voice-summary != "";
    property <bool> hovered;
    changed card-wanted => {
        if self.card-wanted { voice-card.show(); } else { voice-card.close(); }
    }
    voice-card := PopupWindow {
        x: root.width + Theme.space-1;
        y: 0;
        close-policy: no-auto-close;
        Rectangle {
            width: 232px; // literal: the card's own width
            height: card-rows.preferred-height;
            border-radius: Theme.radius-sm;
            background: Theme.surface;
            drop-shadow-blur: 3px;
            drop-shadow-color: Theme.shadow;
            card-rows := VerticalLayout {
                padding: Theme.space-3;
                // No spacing: the rows past the eighth are 0 px tall and would add gaps.
                Text { text: room.voice-summary; height: 22px; // literal: summary line
                    vertical-alignment: center; color: Theme.on-surface-variant; font-size: Theme.text-small; font-weight: 700; overflow: elide; }
                for m[i] in room.occupants: HorizontalLayout {
                    height: i < 8 ? 26px : 0px; // literal: the sidebar's call-row height
                    visible: i < 8;
                    spacing: Theme.space-2;
                    Avatar { size: 20px; source: m.avatar; has-image: m.has-avatar; initials: m.initials; }
                    EmojiText { text: m.name; runs: m.name-runs; font-size: Theme.text-label; color: Theme.on-surface; horizontal-stretch: 1; }
                    if m.video: Icon { text: Icons.videocam; font-size: Theme.text-title; color: Theme.on-surface-variant; width: 18px; }
                    if m.live: Text { text: "LIVE"; font-size: Theme.text-tiny; font-weight: 700; color: Theme.error; vertical-alignment: center; }
                }
                if room.occupants.length > 8: Text { text: "and " + (room.occupants.length - 8) + " more"; color: Theme.on-surface-variant; font-size: Theme.text-small; }
            }
        }
    }
    if !room.header: Entry {
        y: 0;
        height: root.entry;
        selected: room.selected;
        hover-changed(h) => {
            root.hovered = h;
            if !h { root.card-dismissed = false; }
        }
        clicked => { root.card-dismissed = true; root.clicked(); }
        draggable: room.pinned && room.pins-above + room.pins-below > 0;
        dragging <=> root.dragging;
        drag-y <=> root.drag-y;
        edge-top: root.edge-top;
        edge-bottom: root.edge-bottom;
        autoscroll(d) => { root.autoscroll(d); }
        dropped => {
            if root.drop-by != 0 {
                root.move-pin(root.drop-by);
            }
        }
        context(x, y) => {
            root.card-dismissed = true;
            root.menu-x = x;
            root.menu-y = y;
            room-menu.show();
        }
        HorizontalLayout {
            // Threads sit under their channel, as Discord's sidebar shows them.
            padding-left: room.thread ? Theme.space-dialog : Theme.space-3;
            padding-right: Theme.space-3;
            spacing: Theme.space-3;
            if room.thread: Text {
                width: 16px;
                text: "↳";
                font-size: Theme.text-title;
                vertical-alignment: center;
                color: Theme.on-surface-variant;
            }
            if room.kind == 2 && !room.thread: Icon {
                width: 32px;
                text: room.voice-channel ? Icons.headset : Icons.tag;
                font-size: Theme.text-large;
                color: room.selected ? Theme.on-secondary-container
                    : room.unread ? Theme.on-surface : Theme.on-surface-variant;
            }
            if room.kind != 2: Rectangle {
                width: 32px;
                Avatar {
                    y: (parent.height - self.height) / 2;
                    size: 32px;
                    source: room.icon;
                    has-image: room.has-icon;
                    initials: room.initials;
                }
                // Godwit's dot: 10 px at the avatar's corner, ringed in the
                // row's colour.
                // Whose chat (Home with several accounts): the account's
                // picture on the top-left corner.
                if room.account-badged: Rectangle {
                    x: -4px;
                    y: (parent.height - 32px) / 2 - 4px;
                    width: 16px;
                    height: 16px;
                    border-radius: Theme.radius-sm;
                    background: room.selected ? Theme.secondary-container : Theme.surface-low;
                    Avatar {
                        x: 1px;
                        y: 1px;
                        size: 14px;
                        source: room.account-badge;
                        has-image: room.has-account-badge;
                        initials: room.account-initials;
                    }
                }
                if room.has-presence: Rectangle {
                    x: 32px - 10px + 1px;
                    y: (parent.height + 32px) / 2 - 10px + 1px;
                    width: 12px;
                    height: 12px;
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: room.selected ? Theme.secondary-container : Theme.surface-low;
                    background: room.presence;
                }
            }
            // Channels: the name alone. Others (as Godwit and the official
            // list): the name in semibold, and a line under it when there is one.
            if room.kind == 2: EmojiText {
                text: room.name;
                runs: room.name-runs;
                horizontal-stretch: 1;
                color: room.selected ? Theme.on-secondary-container
                    : room.unread ? Theme.on-surface : Theme.on-surface-variant;
            }
            // A thread's last activity ("3d"), as chats show theirs.
            if room.kind == 2 && room.when != "": Text {
                text: room.when;
                font-size: Theme.text-caption;
                vertical-alignment: center;
                color: room.selected ? Theme.on-secondary-container : Theme.outline;
            }
            // A voice channel's limit, as Discord shows it: "2/5" at the row's end.
            if room.kind == 2 && room.subtitle != "": Rectangle {
                y: (parent.height - self.height) / 2;
                width: limit-text.preferred-width + 10px;
                height: 18px;
                border-radius: Theme.radius-xs;
                background: Theme.surface-highest;
                limit-text := Text { text: room.subtitle; font-size: Theme.text-caption; color: Theme.on-surface-variant; }
            }
            if room.kind != 2: VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.space-compact;
                    EmojiText {
                        horizontal-stretch: 1;
                        text: room.name;
                        runs: room.name-runs;
                        font-weight: 600;
                        color: room.selected ? Theme.on-secondary-container
                            : room.unread ? Theme.on-surface : Theme.on-surface-variant;
                    }
                    if room.when != "": Text {
                        text: room.when;
                        font-size: Theme.text-caption;
                        vertical-alignment: center;
                        color: room.selected ? Theme.on-secondary-container : Theme.outline;
                    }
                }
                if room.subtitle != "": Text {
                    text: room.subtitle;
                    font-size: Theme.text-caption;
                    overflow: elide;
                    color: room.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
                }
                // Someone on several networks: their status on each.
                if room.networks.length > 0: NetList {
                    items: room.networks;
                    size: 11px;
                    text-colour: room.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
                }
            }
            // How long its call has been going, as Discord shows it.
            if room.voice-since > 0 && root.clock >= room.voice-since: Text {
                text: root.elapsed(root.clock - room.voice-since);
                font-size: Theme.text-caption;
                vertical-alignment: center;
                color: room.selected ? Theme.on-secondary-container : Theme.outline;
            }
            // The pill above shows limited channels; this, the rest.
            if room.voice-count != "" && !(room.kind == 2 && room.subtitle != ""): Text {
                text: room.voice-count;
                font-size: Theme.text-small;
                vertical-alignment: center;
                color: room.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
            }
            if !room.selected && (room.mentions > 0 || room.unread): Badge {
                y: (parent.height - self.height) / 2;
                count: room.mentions;
            }
        }
    }
    // Who's in its call, under it, as the official sidebar (and Godwit):
    // 26 px rows, a 20 px avatar 28 px in, the name, and on the right
    // headphones-off and mic-off for who deafened or muted themselves.
    for m[i] in room.occupants: Rectangle {
        y: root.entry + i * 26px;
        height: 26px;
        Avatar {
            x: 28px;
            y: (parent.height - self.height) / 2;
            size: 20px;
            source: m.avatar;
            has-image: m.has-avatar;
            initials: m.initials;
        }
        HorizontalLayout {
            x: 28px + 20px + Theme.gap-sm + 2px;
            width: parent.width - self.x - Theme.gap-md;
            spacing: Theme.space-1;
            EmojiText {
                text: m.name;
                runs: m.name-runs;
                font-size: Theme.text-label;
                color: Theme.on-surface-variant;
                horizontal-stretch: 1;
            }
            if m.deafened: Icon { text: Icons.headset-off; font-size: Theme.text-title; color: Theme.on-surface-variant; width: 18px; }
            if m.muted: Icon { text: Icons.mic-off; font-size: Theme.text-title; color: Theme.on-surface-variant; width: 18px; }
        }
    }
}

// The rooms of the selected server, or the conversations, with the call
// bar and our account underneath.
export component Sidebar inherits Rectangle {
    in property <string> title;
    // The server's banner, above its channels (as Stoat's client shows it).
    in property <image> banner;
    in property <bool> has-banner;
    in property <[RoomItem]> rooms;
    // The server's rooms we haven't joined (Matrix spaces).
    in property <[DirectoryItem]> directory;
    callback join-room(int);
    in property <string> account-name;
    in property <int> clock;
    in property <image> account-avatar;
    in property <bool> account-has-presence;
    in property <color> account-presence;
    in property <bool> account-has-avatar;
    in property <string> account-initials;
    // Home keeps these three destination buttons visible while one is open.
    in property <bool> home;
    in property <bool> friends-selected;
    in property <bool> people-selected;
    in property <bool> active-selected;
    in property <bool> notifications-selected;
    // Alerts not yet seen on Notifications (its badge).
    in property <int> notifications-unseen;
    in property <bool> can-show-games;
    in property <bool> games-selected;
    property <bool> home-navigation: root.home || root.people-selected || root.friends-selected || root.active-selected || root.notifications-selected || root.games-selected;
    in property <bool> can-show-threads;
    in property <bool> threads-selected;
    callback show-threads();
    in property <int> server-event-count;
    in property <string> server-event-count-label;
    in property <bool> server-events-selected;
    callback show-server-events();
    in property <bool> in-call;
    in property <string> call-status;
    // -1: not measured, 0: good, 1: fair, 2: poor.
    in property <int> call-quality;
    in property <int> call-latency;
    // How long the call has been connected ("" while connecting).
    in property <string> call-time;
    in property <bool> call-can-video;
    // The call's network can carry video at all (the button shows, greyed if not allowed here).
    in property <bool> call-video-network;
    in property <bool> call-screen-share;
    callback set-screen-share(bool);
    in property <bool> call-camera;
    callback set-camera(bool);
    // We sound like speech right now (our own voice activity, from anywhere).
    in property <bool> call-speaking;
    in property <string> call-room;
    in property <bool> call-muted;
    in property <bool> call-deafened;
    // Our own mute and deafen (kept outside calls).
    in property <bool> self-muted;
    in property <bool> self-deafened;
    callback show-friends();
    callback show-people();
    callback show-active();
    callback show-notifications();
    callback show-games();
    callback select-room(int);
    callback room-menu(int, int);
    in-out property <string> home-query;
    callback search-home(string);
    // Home's network filter: the networks with chats, and the one picked ("" for all).
    in property <[string]> home-networks;
    in property <string> home-network;
    callback filter-home(string);
    callback toggle-hidden-rooms();
    callback toggle-category(int);
    callback create-channel-in(int);
    callback log-out();
    callback open-settings();
    in property <bool> server-settings-available;
    callback open-server-settings();
    in property <bool> can-edit-server-profile;
    callback edit-server-profile();
    // The server menu (the official ServerContextMenu), opened from the
    // header: each entry only with its permission.
    in property <bool> server-menu;
    in property <bool> can-invite;
    in property <bool> can-create-channel;
    in property <bool> can-leave;
    in property <bool> can-report;
    callback report-server();
    callback invite-people();
    callback mark-server-read();
    // The server's notification level (0 all, 1 mentions, 2 nothing), where the network keeps one.
    in property <bool> notify-levels;
    in property <int> notify;
    callback set-notify(int);
    callback create-channel();
    callback leave-server();
    callback open-call-room();
    callback toggle-mute();
    callback toggle-deafen();
    callback leave-call();
    in property <bool> call-soundboard;
    in property <[SoundItem]> call-sounds;
    callback load-call-sounds();
    callback play-call-sound(int);

    // Its width, as the user dragged it (see app.slint's handles).
    in property <length> panel-width: Theme.sidebar-width;
    width: root.panel-width;
    // Bumped when Home is clicked while open: the chats go back to the top.
    in property <int> scroll-reset;
    changed scroll-reset => { list.content-y = 0; }
    // A pinned chat dragged this many places among the pins.
    callback move-pin(int, int);
    // The dragged pin, drawn over the list as it follows the pointer.
    property <bool> ghost-shown;
    property <length> ghost-y;
    property <length> ghost-height;
    property <RoomItem> ghost-room;
    property <length> drop-line;
    VerticalLayout {
        padding-left: Theme.gap-md;
        padding-right: Theme.gap-md;
        // The header: 40 px, 16 px semibold, after an 8 px gap; with a
        // banner, the name sits on its lower edge.
        head := Rectangle {
            property <bool> banner-shown: root.has-banner && !root.home;
            height: root.home-navigation ? 0px : self.banner-shown ? 136px : 52px;
            if head.banner-shown: Rectangle {
                x: -Theme.gap-md;
                width: parent.width + 2 * Theme.gap-md;
                height: 136px;
                clip: true;
                Image { width: parent.width; height: parent.height; source: root.banner; image-fit: cover; }
                // Darkens the bottom so the name stays readable on any picture.
                Rectangle {
                    y: parent.height - 64px;
                    height: 64px;
                    background: @linear-gradient(180deg, transparent 0%, Theme.scrim-strong 100%);
                }
            }
            header := Rectangle {
                y: head.banner-shown ? head.height - 48px : root.home-navigation ? 0px : 8px;
                height: root.home-navigation ? 0px : 40px;
                border-radius: Theme.radius-sm;
                background: root.server-menu && header-touch.has-hover ? (head.banner-shown ? Theme.on-media-overlay : Theme.surface-highest) : transparent;
                Text {
                    x: 12px;
                    width: parent.width - (root.server-menu ? 48px : 24px);
                    text: root.home-navigation ? "" : root.title;
                    font-size: Theme.text-title;
                    font-weight: 600;
                    color: root.has-banner && !root.home ? Theme.on-media : Theme.on-surface;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.server-menu: Icon {
                    x: parent.width - 32px;
                    text: Icons.expand;
                    color: Theme.on-surface-variant;
                }
                header-touch := TouchArea {
                    enabled: root.server-menu;
                    mouse-cursor: root.server-menu ? pointer : default;
                    clicked => { server-menu.show(); }
                }
            }
            // The popup's own width, or it sizes to the panel's preferred
            // width and centres the wider panel (off to the left).
            server-menu := PopupWindow {
                x: 0;
                y: header.y + header.height + 4px;
                width: header.width;
                MenuPanel {
                    width: parent.width;
                    if root.can-invite: MenuRow { glyph: Icons.link; label: "Invite people"; clicked => { root.invite-people(); } }
                    MenuRow { glyph: Icons.unread; label: "Mark as read"; clicked => { root.mark-server-read(); } }
                    if root.notify-levels: MenuDivider { }
                    if root.notify-levels: MenuRow { glyph: Icons.chat; label: (root.notify == 0 ? "✓ " : "") + "Notify: all messages"; clicked => { root.set-notify(0); } }
                    if root.notify-levels: MenuRow { glyph: Icons.at; label: (root.notify == 1 ? "✓ " : "") + "Notify: only @mentions"; clicked => { root.set-notify(1); } }
                    if root.notify-levels: MenuRow { glyph: Icons.lock; label: (root.notify == 2 ? "✓ " : "") + "Notify: nothing"; clicked => { root.set-notify(2); } }
                    if root.notify-levels: MenuDivider { }
                    if root.can-create-channel: MenuRow { glyph: Icons.tag; label: "Create channel"; clicked => { root.create-channel(); } }
                    if root.can-edit-server-profile: MenuRow { glyph: Icons.edit; label: "Edit server profile"; clicked => { root.edit-server-profile(); } }
                    if root.server-settings-available: MenuRow { glyph: Icons.settings; label: "Server settings"; clicked => { root.open-server-settings(); } }
                    if root.can-report: MenuDivider { }
                    if root.can-report: MenuRow { glyph: Icons.error; label: "Report server"; danger: true; clicked => { root.report-server(); } }
                    if root.can-leave && !root.can-report: MenuDivider { }
                    if root.can-leave: MenuRow { glyph: Icons.logout; label: "Leave server"; danger: true; clicked => { root.leave-server(); } }
                }
            }
        }
        // Home's own entries and the conversation search stay put; only
        // the chats below them scroll.
        if root.home-navigation: VerticalLayout {
            spacing: Theme.space-1;
            padding-bottom: Theme.space-1;
            // Every alert, newest first, across networks (Godwit's own).
            MenuButton {
                glyph: Icons.notifications;
                label: "Notifications";
                badge: root.notifications-unseen;
                selected: root.notifications-selected;
                clicked => { root.show-notifications(); }
            }
            // Friends in calls and in games, across networks.
            MenuButton {
                glyph: Icons.group;
                label: "Active now";
                selected: root.active-selected;
                clicked => { root.show-active(); }
            }
            // Everyone as one person across networks.
            MenuButton {
                glyph: Icons.link;
                label: "People";
                selected: root.people-selected;
                clicked => { root.show-people(); }
            }
            // Which games friends share, on the networks with game libraries.
            if root.can-show-games: MenuButton {
                glyph: Icons.group;
                label: "Games in common";
                selected: root.games-selected;
                clicked => { root.show-games(); }
            }
            // Adding someone is an action, used rarely: last.
            MenuButton {
                glyph: Icons.group;
                label: "Add a friend";
                selected: root.friends-selected;
                clicked => { root.show-friends(); }
            }
            Text {
                x: Theme.space-4;
                height: 34px;
                text: "Conversations";
                font-size: Theme.text-label;
                font-weight: 600;
                color: Theme.on-surface;
                vertical-alignment: bottom;
            }
            Rectangle { height: 5px; }
            // Search and network filtering apply only to the conversations below.
            TextField {
                height: 36px;
                placeholder: "Search conversations";
                text <=> root.home-query;
                edited(t) => { root.search-home(t); }
            }
            if root.home-networks.length > 1: NetworkSelect {
                width: root.width - Theme.space-4;
                x: Theme.space-2;
                networks: root.home-networks;
                selected-network: root.home-network;
                selected(n) => { root.filter-home(n); }
            }
        }
        // No scrollbar here either; it pushed the rows off their padding.
        list := Flickable {
            vertical-stretch: 1;
            // Wheel only, as the rail: dragging to scroll took a pinned
            // chat's drag before the row could.
            interactive: false;
            content-height: rows.preferred-height;
            // Its own height, not the view's, so the last rows can be scrolled to.
            rows := VerticalLayout {
                width: list.width;
                height: self.preferred-height;
                alignment: start;
                spacing: Theme.space-1;
                padding-bottom: Theme.gap-md;
                if root.server-event-count > 0: Rectangle {
                    height: Theme.control-button;
                    background: root.server-events-selected || events-touch.has-hover ? Theme.surface-high : transparent;
                    border-radius: Theme.radius-sm;
                    HorizontalLayout {
                        padding-left: Theme.gap-md;
                        padding-right: Theme.gap-md;
                        Text { text: "Events"; color: Theme.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: root.server-event-count-label; color: Theme.outline; vertical-alignment: center; }
                    }
                    events-touch := TouchArea { mouse-cursor: pointer; clicked => { root.show-server-events(); } }
                }
                if root.can-show-threads: Rectangle {
                    height: 40px;
                    background: root.threads-selected || threads-touch.has-hover ? Theme.surface-high : transparent;
                    border-radius: Theme.radius-sm;
                    Text { x: Theme.gap-md; text: "Threads"; color: Theme.on-surface; vertical-alignment: center; height: parent.height; }
                    threads-touch := TouchArea { mouse-cursor: pointer; clicked => { root.show-threads(); } }
                }
                for room[i] in root.rooms: RoomRow {
                    room: room;
                    clock: root.clock;
                    clicked => { root.select-room(i); }
                    menu(a) => { root.room-menu(i, a); }
                    move-pin(by) => { root.move-pin(i, by); }
                    drag-moved(on, y, h, line) => {
                        root.ghost-shown = on;
                        root.ghost-y = y;
                        root.ghost-height = h;
                        root.ghost-room = room;
                        root.drop-line = line;
                    }
                    edge-top: list.absolute-position.y;
                    edge-bottom: list.absolute-position.y + list.height;
                    autoscroll(d) => {
                        list.content-y = max(min(0px, list.height - list.content-height), min(0px, list.content-y - d));
                    }
                    toggle-hidden => { root.toggle-hidden-rooms(); }
                    toggle-category => { root.toggle-category(i); }
                    create-here => { root.create-channel-in(i); }
                }
                if !root.home && root.directory.length > 0: Text {
                    x: 20px;
                    height: 34px;
                    text: "More rooms";
                    font-size: Theme.text-label;
                    font-weight: 600;
                    color: Theme.on-surface;
                    vertical-alignment: bottom;
                }
                for d[i] in root.directory: HorizontalLayout {
                    height: 48px;
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-3;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: d.name; overflow: elide; color: Theme.on-surface-variant; }
                        Text { text: d.detail; overflow: elide; font-size: Theme.text-small; color: Theme.outline; }
                    }
                    Button { y: (parent.height - self.height) / 2; text: "Join"; kind: "text"; clicked => { root.join-room(i); } }
                }
            }
            // A dragged pin follows the pointer over the other rows, as the
            // rail's servers do.
            if root.ghost-shown: Rectangle {
                y: root.ghost-y;
                width: list.width;
                height: root.ghost-height;
                border-radius: Theme.radius-lg;
                background: Theme.surface-highest;
                drop-shadow-blur: 3px;
                drop-shadow-color: Theme.shadow;
                EmojiText {
                    x: Theme.space-3;
                    width: parent.width - 2 * Theme.space-3;
                    text: root.ghost-room.name;
                    runs: root.ghost-room.name-runs;
                    font-weight: 600;
                    color: Theme.on-surface;
                }
            }
            // Where it lands.
            if root.ghost-shown && root.drop-line >= 0: Rectangle {
                y: root.drop-line;
                width: list.width;
                height: 2px;
                background: Theme.primary;
            }
        }
        // YapFast's voice dock: connection and room on one line, then video
        // actions. Mute/deafen stay on the account controls below.
        if root.in-call: Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.surface-high;
            // A real popup, as the other menus: a click outside or Escape
            // closes it without playing anything. It floats above the call
            // panel, the list scrolling once it outgrows the panel's cap.
            sound-picker := PopupWindow {
                x: 0px;
                y: -self.height - Theme.gap-md;
                width: 280px;
                height: min(320px, Theme.space-3 * 2 + 28px + Theme.space-2 + max(1, root.call-sounds.length) * 36px);
                close-policy: close-on-click-outside;
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-high;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: Theme.shadow;
                }
                FocusScope {
                    init => { self.focus(); }
                    key-pressed(e) => {
                        if e.text == Key.Escape { sound-picker.close(); return accept; }
                        reject
                    }
                    VerticalLayout {
                        padding: Theme.space-3;
                        spacing: Theme.space-2;
                        Text { height: 28px; text: "Soundboard"; font-size: Theme.text-title; color: Theme.on-surface; vertical-alignment: center; }
                        if root.call-sounds.length == 0: Text {
                            height: 36px;
                            text: "No sounds";
                            color: Theme.on-surface-variant;
                            vertical-alignment: center;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for sound[i] in root.call-sounds: Rectangle {
                                height: 36px;
                                border-radius: Theme.radius-sm;
                                background: row.has-hover ? Theme.surface-highest : transparent;
                                opacity: sound.cooldown ? 0.5 : 1.0;
                                HorizontalLayout {
                                    padding-left: Theme.space-2;
                                    padding-right: Theme.space-2;
                                    spacing: Theme.space-2;
                                    Text { text: sound.emoji; color: Theme.on-surface; vertical-alignment: center; }
                                    Text { text: sound.name; color: Theme.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                }
                                row := TouchArea {
                                    enabled: !sound.cooldown;
                                    mouse-cursor: sound.cooldown ? default : pointer;
                                    clicked => { root.play-call-sound(i); sound-picker.close(); }
                                }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-2;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Rectangle {
                        width: 32px;
                        Image {
                            x: (parent.width - 24px) / 2;
                            y: (parent.height - 24px) / 2;
                            width: 24px;
                            height: 24px;
                            source: root.call-status != "Voice connected"
                                ? @image-url("../../../assets/icons/yapfast/volume-2.svg")
                                : root.call-quality == 2
                                    ? @image-url("../../../assets/icons/yapfast/signal-low.svg")
                                    : root.call-quality == 1
                                        ? @image-url("../../../assets/icons/yapfast/signal-medium.svg")
                                        : @image-url("../../../assets/icons/yapfast/signal-high.svg");
                            image-fit: contain;
                            colorize: root.call-status != "Voice connected" ? Theme.warning
                                : root.call-quality == 2 ? Theme.error
                                : root.call-quality == 1 ? Theme.warning : Theme.online;
                        }
                        if root.call-status == "Voice connected" && root.call-quality < 0: Rectangle {
                            x: parent.width - 12px;
                            y: 0px;
                            width: 13px;
                            height: 13px;
                            border-radius: Theme.radius-dot;
                            border-width: 1px;
                            border-color: Theme.surface-high;
                            background: Theme.surface-high;
                            Text { text: "?"; color: Theme.on-surface-variant; font-size: Theme.text-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Tooltip {
                            Rectangle {
                                width: quality-tip.preferred-width + 16px;
                                height: quality-tip.preferred-height + 8px;
                                border-radius: Theme.radius-xs;
                                background: Theme.surface-highest;
                                quality-tip := Text {
                                    text: root.call-status != "Voice connected" ? root.call-status
                                        : root.call-quality < 0 ? "Connection quality unavailable"
                                        : (root.call-quality == 0 ? "Fine" : root.call-quality == 1 ? "Average" : "Bad")
                                            + " connection · " + root.call-latency + " ms";
                                    color: Theme.on-surface;
                                    font-size: Theme.text-small;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        HorizontalLayout {
                            spacing: Theme.space-compact;
                            Text { text: root.call-status; font-weight: 600; font-size: Theme.text-label; color: root.call-status == "Voice connected" ? Theme.online : Theme.warning; overflow: elide; horizontal-stretch: 1; }
                            if root.call-time != "": Text { text: root.call-time; font-size: Theme.text-small; color: Theme.on-surface-variant; vertical-alignment: center; }
                        }
                        Text {
                            text: root.call-room;
                            font-size: Theme.text-small;
                            color: Theme.on-surface-variant;
                            overflow: elide;
                            TouchArea { mouse-cursor: pointer; clicked => { root.open-call-room(); } }
                        }
                    }
                    // One look for the whole panel: the account row's flat glyph
                    // buttons, with colour for state (red to leave, primary when on).
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        glyph: Icons.call-end;
                        tooltip: "Leave call";
                        tint: Theme.error;
                        clicked => { root.leave-call(); }
                    }
                    if root.call-soundboard: IconButton {
                        glyph: Icons.campaign;
                        tooltip: "Soundboard";
                        clicked => { root.load-call-sounds(); sound-picker.show(); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    if root.call-video-network || root.call-camera: IconButton {
                        glyph: root.call-camera ? Icons.videocam : Icons.videocam-off;
                        enabled: root.call-can-video || root.call-camera;
                        tooltip: root.call-camera ? "Turn camera off"
                            : root.call-can-video ? "Turn camera on"
                            : "The camera isn't allowed in this call (no Video permission), or it's still connecting";
                        tint: root.call-camera ? Theme.primary : Theme.on-surface-variant;
                        clicked => { root.set-camera(!root.call-camera); }
                    }
                    // Sharing the screen, where the call allows video.
                    if root.call-video-network || root.call-screen-share: IconButton {
                        glyph: root.call-screen-share ? Icons.stop-screen-share : Icons.screen-share;
                        enabled: root.call-can-video || root.call-screen-share;
                        tooltip: root.call-screen-share ? "Stop sharing"
                            : root.call-can-video ? "Share your screen"
                            : "Sharing isn't allowed in this call (no Video permission), or it's still connecting";
                        tint: root.call-screen-share ? Theme.primary : Theme.on-surface-variant;
                        clicked => { root.set-screen-share(!root.call-screen-share); }
                    }
                }
            }
        }
        if root.in-call: Rectangle { height: Theme.gap-md; }
        // Our account.
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-bottom: Theme.space-2;
                spacing: Theme.space-3;
                Rectangle {
                    width: 32px;
                    Avatar {
                        y: (parent.height - self.height) / 2;
                        size: 32px;
                        source: root.account-avatar;
                        has-image: root.account-has-avatar;
                        initials: root.account-initials;
                    }
                    if root.account-has-presence: Rectangle {
                        x: 32px - 10px + 1px;
                        y: (parent.height + 32px) / 2 - 10px + 1px;
                        width: 12px;
                        height: 12px;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: Theme.surface-low;
                        background: root.account-presence;
                    }
                }
                Text {
                    text: root.account-name;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: Theme.on-surface;
                    font-weight: 600;
                }
                // Always here, as Discord's user panel: they hold outside a
                // call too, and the next call starts muted or deafened.
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: root.self-muted ? Icons.mic-off : Icons.mic;
                    enabled: !root.self-deafened;
                    tint: root.self-muted ? Theme.error : root.in-call && root.call-speaking ? Theme.online : Theme.on-surface-variant;
                    tooltip: root.self-muted ? "Unmute" : "Mute";
                    clicked => { root.toggle-mute(); }
                }
                AudioMenuArrow {
                    y: (parent.height - self.height) / 2;
                    tooltip: "Microphone and noise suppression";
                    heading: "Input device";
                    device-glyph: Icons.mic;
                    devices: CallAudio.inputs;
                    device-index: CallAudio.input-index;
                    noise: true;
                    opening => { CallAudio.opening(); }
                    device-picked(i) => { CallAudio.pick-input(i); }
                    noise-picked(i) => { CallAudio.pick-noise(i); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: root.self-deafened ? Icons.headset-off : Icons.headset;
                    tint: root.self-deafened ? Theme.error : Theme.on-surface-variant;
                    tooltip: root.self-deafened ? "Undeafen" : "Deafen";
                    clicked => { root.toggle-deafen(); }
                }
                AudioMenuArrow {
                    y: (parent.height - self.height) / 2;
                    tooltip: "Output device";
                    heading: "Output device";
                    device-glyph: Icons.volume-up;
                    devices: CallAudio.outputs;
                    device-index: CallAudio.output-index;
                    opening => { CallAudio.opening(); }
                    device-picked(i) => { CallAudio.pick-output(i); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.settings;
                    tooltip: "Settings";
                    clicked => { root.open-settings(); }
                }
            }
        }
    }
}
