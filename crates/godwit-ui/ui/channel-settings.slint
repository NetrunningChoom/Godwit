import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Section } from "settings.slint";
import { Avatar, Button, ConfirmDialog, Select, TextArea, TextField, Toggle, TriState } from "widgets.slint";
import { AdminRoleItem, OverridePermItem, WebhookItem } from "types.slint";

// A server channel's settings, as the official ChannelSettings: a sidebar
// with Overview and (with Manage Channel) Delete Channel, and the Overview's
// icon, name, description and mature switch, and (where the network has
// per-role overrides) Permissions. Groups can expose only their default
// permission set; server channels may also expose webhooks.
export component ChannelSettings inherits Rectangle {
    in property <string> title;
    in property <bool> loaded;
    in property <bool> busy;
    in property <bool> allowed;
    in property <bool> dirty;
    in property <bool> failed;
    in property <string> status;
    in-out property <string> name;
    in-out property <string> description;
    in-out property <bool> mature;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> icon-label;
    // What this network's channels have: a picture, slowmode (its choices
    // and the one now); a category has only a name.
    in property <bool> has-icons;
    in property <bool> is-category;
    in property <bool> is-group;
    in property <bool> has-webhooks;
    in property <[WebhookItem]> webhook-entries;
    in property <bool> webhooks-loading;
    in property <bool> webhooks-busy;
    in property <string> webhook-status;
    in-out property <string> webhook-create-name;
    in-out property <string> webhook-edit-name;
    in-out property <int> webhook-edit-index: -1;
    property <int> delete-index: -1;
    callback create-webhook(string); callback rename-webhook(string, string); callback delete-webhook(string);
    callback confirm-channel-delete();
    callback refresh-webhooks();
    in property <bool> webhook-copy;
    callback copy-webhook(string);
    in property <bool> has-slowmode;
    in property <[string]> slowmode-choices;
    in-out property <int> slowmode-index;
    in property <string> description-hint;
    // The Permissions page: which page is open (0 overview, 1 permissions),
    // whether this network has it, the overrides and the one selected, its
    // permissions (built only while the page is open) and what it may do.
    in property <int> page;
    in property <bool> has-overrides;
    in property <[AdminRoleItem]> override-entries;
    in property <int> override-index;
    in property <[OverridePermItem]> override-perms;
    in property <bool> override-can-edit;
    in property <bool> override-dirty;
    in property <bool> override-removable;
    in property <[string]> override-choices;
    in-out property <int> override-choice-index;
    callback show-page(int); callback select-override(int); callback set-override-permission(int, int);
    callback save-override(); callback remove-override(); callback add-override(int);

    callback close(); callback save(); callback reset(); callback changed();
    callback pick-image(); callback remove-image();
    callback delete-channel();

    property <bool> confirm-delete;
    background: Theme.surface-lowest;
    TouchArea { scroll-event(e) => { accept } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => { if e.text == Key.Escape { root.close(); return accept; } reject }
        HorizontalLayout {
            Rectangle {
                width: 220px;
                background: Theme.surface-low;
                VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-1; alignment: start;
                    Text { text: root.title; font-size: Theme.text-small; font-weight: 600; color: Theme.outline; height: 28px; overflow: elide; }
                    if !root.is-group: Section { label: "Overview"; selected: root.page == 0; clicked => { root.show-page(0); } }
                    if root.has-overrides: Section { label: "Permissions"; selected: root.page == 1; clicked => { root.show-page(1); } }
                    if root.has-webhooks: Section { label: "Webhooks"; selected: root.page == 2; clicked => { root.show-page(2); } }
                    if root.allowed: Rectangle { height: 12px; }
                    if root.allowed: Section { label: root.is-category ? "Delete Category" : "Delete Channel"; danger: true; clicked => { root.confirm-delete = true; } }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding: Theme.space-5; spacing: Theme.space-4;
                    Text { text: root.page == 1 ? "Permissions" : root.page == 2 ? "Webhooks" : "Overview"; font-size: Theme.text-large; font-weight: 600; color: Theme.on-surface; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                    Button { text: "Close"; kind: "text"; clicked => { root.close(); } }
                }
                if root.page == 0 && !root.is-group: overview := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: min(overview.visible-width, 680px);
                        padding: Theme.space-7; spacing: Theme.space-4; alignment: start;
                        if root.status != "": Text { text: root.status; wrap: word-wrap; color: root.failed ? Theme.error : Theme.on-surface-variant; }
                        if root.loaded && !root.allowed: Text { text: "You need Manage Channel permission to change these settings."; wrap: word-wrap; color: Theme.on-surface-variant; }
                        if root.loaded: VerticalLayout {
                            spacing: Theme.space-4;
                            if root.has-icons: Text { text: "Channel icon"; color: Theme.on-surface; }
                            if root.has-icons: Avatar { size: 72px; source: root.icon; has-image: root.has-icon; initials: ""; }
                            if root.has-icons && root.icon-label != "": Text { text: root.icon-label; wrap: word-wrap; color: Theme.on-surface-variant; }
                            if root.has-icons: HorizontalLayout {
                                alignment: start; spacing: Theme.space-3;
                                Button { text: "Change icon"; enabled: root.allowed && !root.busy; clicked => { root.pick-image(); } }
                                Button { text: "Remove"; kind: "text"; enabled: root.allowed && !root.busy; clicked => { root.remove-image(); } }
                            }
                            Text { text: root.is-category ? "Category name" : "Channel name"; color: Theme.on-surface; }
                            TextField { text <=> root.name; enabled: root.allowed && !root.busy; edited => { root.changed(); } accepted => { root.save(); } }
                            if !root.is-category: Text { text: "Channel description"; color: Theme.on-surface; }
                            if !root.is-category && root.description-hint != "": Text { text: root.description-hint; wrap: word-wrap; color: Theme.on-surface-variant; }
                            if !root.is-category: TextArea { height: 120px; text <=> root.description; enabled: root.allowed && !root.busy; edited => { root.changed(); } }
                            if root.has-slowmode: Text { text: "Slowmode"; font-weight: 600; color: Theme.on-surface; }
                            if root.has-slowmode: Text { text: "Members wait this long between messages, unless they can manage the channel."; wrap: word-wrap; color: Theme.on-surface-variant; }
                            if root.has-slowmode: Select {
                                model: root.slowmode-choices; current-index <=> root.slowmode-index; enabled: root.allowed && !root.busy;
                                selected(i) => { root.changed(); }
                            }
                            if !root.is-category: Text { text: "Mark as mature"; font-weight: 600; color: Theme.on-surface; }
                            if !root.is-category: HorizontalLayout {
                                spacing: Theme.space-4;
                                Text { text: "Users will be asked to confirm their age before opening this channel."; wrap: word-wrap; color: Theme.on-surface-variant; horizontal-stretch: 1; vertical-alignment: center; }
                                Toggle { checked: root.mature; toggled(on) => { root.mature = on; root.changed(); } }
                            }
                        }
                    }
                }
                // Per-role and per-member overrides: the list beside the selected one's permissions.
                if root.page == 1: HorizontalLayout {
                    vertical-stretch: 1;
                    padding: Theme.space-5; spacing: Theme.space-5;
                    VerticalLayout {
                        width: 220px; spacing: Theme.space-3;
                        if root.override-choices.length > 0: HorizontalLayout {
                            spacing: Theme.space-3;
                            Select { model: root.override-choices; current-index <=> root.override-choice-index; enabled: root.override-can-edit && !root.busy; }
                            Button { y: 4px; text: "Add"; kind: "text"; enabled: root.override-can-edit && !root.busy && root.override-choice-index >= 0; clicked => { root.add-override(root.override-choice-index); } }
                        }
                        entry-list := ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: entry-list.visible-width;
                                spacing: Theme.space-1; alignment: start;
                                for entry[i] in root.override-entries: Rectangle {
                                    height: 36px; border-radius: Theme.radius-sm;
                                    background: i == root.override-index ? Theme.primary-container : entry-touch.has-hover ? Theme.surface-highest : transparent;
                                    HorizontalLayout {
                                        padding-left: Theme.space-between; spacing: Theme.space-3;
                                        Rectangle { y: (parent.height - 12px) / 2; width: 12px; height: 12px; border-radius: self.width / 2; background: entry.has-colour ? entry.colour : Theme.outline; }
                                        Text { text: entry.name; vertical-alignment: center; overflow: elide; color: i == root.override-index ? Theme.on-primary-container : Theme.on-surface; }
                                    }
                                    entry-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-override(i); } }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: Theme.space-4;
                        if root.status != "": Text { text: root.status; wrap: word-wrap; color: root.failed ? Theme.error : Theme.on-surface-variant; }
                        if root.loaded && !root.override-can-edit: Text { text: "You need Manage Permissions to change these."; wrap: word-wrap; color: Theme.on-surface-variant; }
                        perms := ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: perms.visible-width - 12px;
                                spacing: Theme.space-2; alignment: start;
                                for p[i] in root.override-perms: VerticalLayout {
                                    spacing: Theme.space-2;
                                    if p.heading != "": Text { text: p.heading; font-weight: 600; color: Theme.on-surface; height: 32px; vertical-alignment: bottom; }
                                    HorizontalLayout {
                                        spacing: Theme.space-5; padding-top: Theme.space-2; padding-bottom: Theme.space-2;
                                        VerticalLayout {
                                            horizontal-stretch: 1; alignment: center;
                                            Text { text: p.title; color: Theme.on-surface; }
                                            Text { text: p.description; font-size: Theme.text-small; color: Theme.outline; wrap: word-wrap; }
                                        }
                                        if p.tri-state: TriState { y: (parent.height - self.height) / 2; state: p.state; enabled: root.override-can-edit && !p.locked && !root.busy; chose(s) => { root.set-override-permission(i, s); } }
                                        if !p.tri-state: Toggle { y: (parent.height - self.height) / 2; checked: p.state == 1; enabled: root.override-can-edit && !p.locked && !root.busy; toggled(on) => { root.set-override-permission(i, on ? 1 : 0); } }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-3; alignment: end;
                            if root.override-removable: Button { text: "Remove override"; danger: true; enabled: root.override-can-edit && !root.busy; clicked => { root.remove-override(); } }
                            Button { text: "Save"; kind: "filled"; enabled: root.override-can-edit && !root.busy && root.override-dirty; clicked => { root.save-override(); } }
                        }
                    }
                }
                if root.page == 0 && !root.is-group: HorizontalLayout {
                    padding: Theme.space-5; spacing: Theme.space-3; alignment: end;
                    Button { text: "Reset"; enabled: root.loaded && !root.busy; clicked => { root.reset(); } }
                    Button { text: "Save"; kind: "filled"; enabled: root.loaded && root.allowed && !root.busy && root.dirty; clicked => { root.save(); } }
                }
                if root.page == 2 && root.has-webhooks: webhook-page := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: min(webhook-page.visible-width, 680px);
                        padding: Theme.space-7; spacing: Theme.space-4; alignment: start;
                        if root.webhook-status != "": Text { text: root.webhook-status; wrap: word-wrap; color: Theme.on-surface-variant; }
                        HorizontalLayout { spacing: Theme.space-3;
                            TextField { text <=> root.webhook-create-name; enabled: !root.webhooks-busy; }
                            Button { text: "Create webhook"; kind: "filled"; enabled: !root.webhooks-busy && root.webhook-create-name != ""; clicked => { root.create-webhook(root.webhook-create-name); } }
                            Button { text: "Refresh"; kind: "text"; enabled: !root.webhooks-busy; clicked => { root.refresh-webhooks(); } }
                        }
                        if root.webhooks-loading: Text { text: "Loading webhooks…"; color: Theme.on-surface-variant; }
                        for hook[i] in root.webhook-entries: VerticalLayout {
                            spacing: Theme.space-2;
                            HorizontalLayout { spacing: Theme.space-3;
                                if hook.has-avatar: Avatar { size: 36px; source: hook.avatar; has-image: true; initials: ""; }
                                Text { text: hook.name; vertical-alignment: center; horizontal-stretch: 1; color: Theme.on-surface; }
                                if root.webhook-copy: Button { text: "Copy URL"; kind: "text"; clicked => { root.copy-webhook(hook.id); } }
                                Button { text: "Rename"; kind: "text"; enabled: !root.webhooks-busy; clicked => { root.webhook-edit-index = i; root.webhook-edit-name = hook.name; } }
                                Button { text: "Delete"; kind: "text"; enabled: !root.webhooks-busy; clicked => { root.delete-index = i; root.confirm-delete = true; } }
                            }
                            if root.webhook-edit-index == i: HorizontalLayout { spacing: Theme.space-3;
                                TextField { text <=> root.webhook-edit-name; enabled: !root.webhooks-busy; }
                                Button { text: "Save name"; kind: "filled"; enabled: !root.webhooks-busy && root.webhook-edit-name != ""; clicked => { root.rename-webhook(hook.id, root.webhook-edit-name); root.webhook-edit-index = -1; } }
                            }
                        }
                    }
                }
            }
        }
    }
    // The official DeleteChannel confirmation.
    if root.confirm-delete: ConfirmDialog {
        title: root.delete-index >= 0 ? "Delete webhook?" : "Delete " + root.title + "?";
        message: root.delete-index >= 0 ? "This webhook will stop sending messages." : "Once it's deleted, there's no going back.";
        confirm-text: "Delete";
        confirm-kind: "filled";
        danger: true;
        cancelled => { root.confirm-delete = false; root.delete-index = -1; }
        confirmed => { root.confirm-delete = false; if root.delete-index >= 0 && root.delete-index < root.webhook-entries.length { root.delete-webhook(root.webhook-entries[root.delete-index].id); } else { root.confirm-channel-delete(); } root.delete-index = -1; }
    }
}
