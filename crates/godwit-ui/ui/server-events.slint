import { Theme, Icons } from "theme.slint";
import { Button, PageHeader, EmptyState } from "widgets.slint";
import { ServerEventItem } from "types.slint";
import { ListView } from "std-widgets.slint";

export component ServerEvents inherits Rectangle {
    in property <[ServerEventItem]> items;
    in property <string> error;
    callback interested(int, bool);

    VerticalLayout {
        PageHeader { label: "Events"; glyph: Icons.schedule; }
        if root.error != "" && root.items.length == 0: EmptyState { text: root.error; wrap: word-wrap; }
        if root.error == "" && root.items.length == 0: EmptyState {
            text: "No upcoming events.";
            wrap: word-wrap;
        }
        if root.items.length > 0: ListView {
            vertical-stretch: 1;
            for item[i] in root.items: Rectangle {
                height: Theme.event-row-height;
                background: Theme.surface-lowest;
                border-radius: Theme.radius-md;
                HorizontalLayout {
                    padding: Theme.gap-lg;
                    spacing: Theme.gap-lg;
                    if item.has-cover: Image {
                        width: Theme.event-cover-width;
                        height: Theme.event-cover-height;
                        source: item.cover;
                        image-fit: cover;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space-1;
                        Text { text: item.name; color: Theme.on-surface; font-size: Theme.text-title; font-weight: 600; overflow: elide; }
                        Text { text: item.when + " · " + item.location + " · " + item.status; color: Theme.on-surface-variant; font-size: Theme.text-small; overflow: elide; }
                        Text { text: item.description; color: Theme.on-surface-variant; font-size: Theme.text-label; overflow: elide; vertical-stretch: 1; }
                        Text { text: item.interested-count + " interested"; color: Theme.outline; font-size: Theme.text-small; }
                    }
                    Button {
                        y: (parent.height - self.height) / 2;
                        text: item.interested ? "Interested ✓" : "Interested";
                        kind: item.interested ? "filled" : "outlined";
                        clicked => { root.interested(i, !item.interested); }
                    }
                }
            }
        }
    }
}
